        sys.stderr.write(
            f"plan-copy-hides-real: rc {hidden_run.returncode} shown {shown!r} real {real_s!r} "
            f"in_argv {real_s in argv_text} in_env {real_s in env_text} "
            f"bad {bad.exists()} envreal {from_env.exists()} "
            f"mode {oct(os.stat(work).st_mode & 0o7777)} err {(hidden_run.stderr or '')[:300]!r}\n")
    check("plan-copy-hides-real", hidden)

    # Walls the person removed stay off when the planner repeats them.
    wall_doc = """UNDERSTOOD: Ship it.
WILL: ship.
WONT: nothing else.
WALLS:
- no-network
## Checklist
- [ ] marker :: verify: true
"""
    wall_fake = bindir / "wall-claude"
    wall_fake.write_text(planner_body("claude", wall_doc))
    wall_fake.chmod(0o755)
    wall_env = os.environ.copy()
    wall_env["ALEXUS_CLAUDE"] = str(wall_fake)
    wmade = run_cli(["new", "--who", "claude", "--cwd", str(work), "--name", "Clear walls", "--", "ship the crate"],
                    env=wall_env)
    wrec = {}
    try:
        wrec = json.loads(wmade.stdout or "{}")
    except ValueError:
        wrec = {}
    run_cli(["edit", wrec.get("id") or "missing", "--no-walls"], env=wall_env)
    wrev = run_cli(["revise", wrec.get("id") or "missing", "--", "small wording change"], env=wall_env)
    wsaved = load_plan(wrec.get("id") or "") or {}
    wmd = (plan_path(wrec["id"]) / "PLAN.md").read_text() if wrec.get("id") else ""
    walls_off = (wmade.returncode == 0 and wrev.returncode == 0 and wsaved.get("walls") == []
                 and wsaved.get("walls_kept") is False and WALLS_LIMIT not in wmd and "no-network" not in wmd)
    if not walls_off:
        sys.stderr.write(f"plan-walls-stay-off: rc {wrev.returncode} walls {wsaved.get('walls')} md {wmd[:240]!r}\n")
    check("plan-walls-stay-off", walls_off)
    told = wmade.stderr or ""
    check("plan-new-says-next", wrec.get("walls_limit") == WALLS_LIMIT and WALLS_LIMIT in told
          and "plan start " + str(wrec.get("id")) in told and wrec.get("plan_md", "").endswith("PLAN.md")
          and "walls_limit" not in wsaved)

    # A check must not freeze the throwaway copy's absolute path.
    path_fake = bindir / "path-claude"
    path_fake.write_text(
        "#!/usr/bin/env python3\n"
        "import json, os, sys\n"
        "blob = ' '.join(sys.argv)\n"
        "marker = 'Task folder: '\n"
        "i = blob.find(marker)\n"
        "folder = blob[i + len(marker):].split()[0] if i >= 0 else 'MISSING'\n"
        "home = os.environ.get('ALEXUS_HOME', '')\n"
        "open(os.path.join(home, 'path-argv.json'), 'w').write(json.dumps(sys.argv))\n"
        "text = ('UNDERSTOOD: Keep ' + folder + '/keep.txt.\\nWILL: leave it.\\nWONT: nothing else.\\nWALLS:\\n- write-only: ' + folder + '/out\\n'\n"
        "        '## Checklist\\n- [ ] keep.txt is there :: verify: test -f ' + folder + '/keep.txt\\n')\n"
        "line = json.dumps({'type': 'assistant', 'message': {'content': [{'type': 'text', 'text': text}]}})\n"
        "sys.stdout.write(line + '\\n')\n"
        "sys.stdout.write(json.dumps({'type': 'result', 'result': 'ok', 'session_id': 'sess-path'}) + '\\n')\n"
    )
    path_fake.chmod(0o755)
    path_env = os.environ.copy()
    path_env["ALEXUS_CLAUDE"] = str(path_fake)
    pmade = run_cli(["new", "--who", "claude", "--cwd", str(work), "--name", "Relative", "--", "keep the file"],
                    env=path_env)
    prec = {}
    try:
        prec = json.loads(pmade.stdout or "{}")
    except ValueError:
        prec = {}
    pck = prec.get("checklist") or ""
    pargv = json.loads((state / "path-argv.json").read_text()) if (state / "path-argv.json").is_file() else []
    guide_text = " ".join(str(a) for a in pargv)
    relative = (pmade.returncode == 0 and "alexus-plan-" not in pck and "/private/var/folders" not in pck
                and "test -f keep.txt" in pck and "relative to the task folder" in guide_text
                and "relative to the task folder" in planner_guide("Ada"))
    if not relative:
        sys.stderr.write(f"plan-check-relative: rc {pmade.returncode} ck {pck!r}\n")
    check("plan-check-relative", relative)
    pwalls = prec.get("walls") or [{}]
    check("plan-wall-relative", pwalls[0].get("text") == "write-only: out" and pwalls[0].get("items") == ["out"]
          and prec.get("understood") == "Keep keep.txt.")
    this_file = Path(__file__).resolve()
    check("plan-one-entry", not os.access(this_file, os.X_OK) and ("__main" + "__") not in this_file.read_text())

    # A stop during planning must leave the task folder's mode bits as they were.
    slow = bindir / "slow-claude"
    slow.write_text(
        "#!/usr/bin/env python3\n"
        "import os, pathlib, sys, time\n"
        "home = os.environ.get('ALEXUS_HOME', '')\n"
        "blob = ' '.join(sys.argv)\n"
        "marker = 'Task folder: '\n"
        "i = blob.find(marker)\n"
        "watch = os.environ.get('PLAN_SC_REAL', '')\n"
        "if not watch and i >= 0:\n"
        "    watch = blob[i + len(marker):].split()[0]\n"
        "if watch:\n"
        "    pathlib.Path(home, 'slow-mode').write_text(str(os.stat(watch).st_mode & 0o7777))\n"
        "pathlib.Path(home, 'slow-started').write_text('1')\n"
        "time.sleep(30)\n"
    )
    slow.chmod(0o755)
    held = os.environ.copy()
    held["ALEXUS_CLAUDE"] = str(slow)
    proc = subprocess.Popen([py, "-B", "-I", script, "plan", "new", "--who", "claude", "--cwd", str(work), "--", "hold still"],
                            env=held, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    deadline = time.time() + 10
    while time.time() < deadline and not (state / "slow-started").exists():
        if proc.poll() is not None:
            break
        time.sleep(0.05)
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except OSError:
        pass
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
        proc.wait(timeout=5)
    sig_d = os.stat(work).st_mode & 0o7777
    sig_f = os.stat(work / "keep.txt").st_mode & 0o7777
    can_write = True
    try:
        (work / "after-stop.txt").write_text("ok")
    except OSError:
        can_write = False
    during = (state / "slow-mode").read_text().strip() if (state / "slow-mode").is_file() else ""
    stopped_ok = ((state / "slow-started").is_file() and during == str(0o1755)
                  and sig_d == 0o1755 and sig_f == 0o644 and can_write)
    if not stopped_ok:
        sys.stderr.write(f"plan-sigterm-keeps-mode: during {during!r} dir {oct(sig_d)} file {oct(sig_f)} write {can_write} rc {proc.returncode}\n")
    check("plan-sigterm-keeps-mode", stopped_ok)
    return 0 if ok else 1


def _wait_run(state, proc, timeout):
    if proc.returncode != 0:
        return {}
    lines = (proc.stdout or "").strip().splitlines()
    if not lines:
        return {}
    rid = lines[-1].strip()
    d = state / "agents" / rid
    end = time.time() + timeout
    st = {}
    while time.time() < end:
        try:
            st = json.loads((d / "state.json").read_text())
        except Exception:
            st = {}
        if st.get("ended"):
            break
        time.sleep(0.05)
    pid = st.get("pid")
    if pid:
        try:
            os.killpg(int(pid), signal.SIGKILL)
        except Exception:
            pass
    subprocess.run(["pkill", "-f", " run " + rid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        st = json.loads((d / "state.json").read_text())
    except Exception:
        pass
    return st


def main(argv=None):
    a = agent_mod()
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if argv[0] == "selfcheck":
        return selfcheck()
    verb, rest = argv[0], argv[1:]
    cwd, model, name, ck, task_file, as_json = os.getcwd(), None, None, None, None, False
    who, walls_file, no_walls = None, None, False
    words = []
    it = iter(rest)
    for x in it:
        if x == "--cwd":
            cwd = os.path.abspath(os.path.expanduser(_take(it)))
        elif x == "--model":
            model = _take(it)
        elif x == "--name":
            name = _take(it)
        elif x == "--who":
            who = _take(it)
        elif x == "--checklist":
            ck = Path(os.path.expanduser(_take(it))).read_text()
        elif x == "--task-file":
            task_file = Path(os.path.expanduser(_take(it))).read_text().strip()
        elif x == "--walls":
            walls_file = _take(it)
        elif x == "--no-walls":
            no_walls = True
        elif x == "--json":
            as_json = True
        elif x == "--":
            words.append(" ".join(it))
            break
        elif x == "-":
            words.append(sys.stdin.read())
        elif x.startswith("-"):
            print(__doc__)
            return 2
        else:
            words.append(x)
    text = " ".join(w for w in words if w is not None).strip()
    out = lambda o: print(json.dumps(o))
    if verb == "precheck":
        if not text:
            print(__doc__)
            return 2
        out({"steps": precheck(cwd, Path(text).read_text() if not text.startswith("- [") else text)})
    elif verb == "list":
        ps = all_plans()
        if as_json:
            out(ps)
        else:
            for p in ps:
                folder = p.get("cwd", "")
                home = str(Path.home())
                if folder.startswith(home):
                    folder = "~" + folder[len(home):]
                print(f"{p['id']}  {len(p.get('runs') or []):2} runs  {folder}  {p.get('name')}")
    elif verb == "show" and text:
        out(load_plan(text.split()[0]))
    elif verb == "start" and text:
        parts = text.split()
        pid, err = start_plan(parts[0], model, who)
        if err:
            print(err, file=sys.stderr)
            return 1
        print(pid)
    elif verb == "new" and text:
        if not os.path.isdir(cwd):
            out({"ok": False, "error": f"no such folder: {cwd}"})
            return 2
        a.require_config()
        plan = ask(cwd, text, model, who)
        if plan.get("ok") or plan.get("raw"):
            nm = name or a.one(text, 60)
            saved = dict(plan, id=new_id(nm), name=nm, cwd=os.path.realpath(cwd), model=model,
                         asks=[text], source="planner", created=stamp(), runs=[])
            if not saved.get("past"):
                saved.pop("past", None)
            plan = dict(save_plan(saved), ok=plan.get("ok"), error=plan.get("error"))
            tell_next(plan)
        out(plan)
    elif verb == "revise" and text:
        parts = text.split()
        pid, change = parts[0], " ".join(parts[1:]).strip()
        rec = load_plan(pid)
        if not rec:
            out({"ok": False, "error": f"no plan {pid}"})
            return 2
        if not change:
            out({"ok": False, "error": "say what to change"})
            return 2
        use_who = a.normalize_who(who) if who else rec.get("who")
        use_model = model or plan_model(rec, use_who)
        original = task_text(rec)
        asked = revise_request(rec, change)
        folder = rec.get("cwd") or cwd
        # Match on the original request. The change alone ("start at 2") must not wipe saved failures.
        found = past_failures((original + "\n" + change).strip(), folder)
        if not found and rec.get("past"):
            found = rec.get("past")
        plan = ask(folder, asked, use_model, use_who, past=found)
        if plan.get("ok"):
            rec["asks"] = (rec.get("asks") or []) + [change]
            rec["model"] = use_model
            rec["cost_usd"] = (rec.get("cost_usd") or 0) + (plan.get("cost_usd") or 0)
            if plan.get("who"):
                rec["who"] = plan["who"]
            if "planner_read_only" in plan:
                rec["planner_read_only"] = plan.get("planner_read_only")
            if plan.get("planner_isolation"):
                rec["planner_isolation"] = plan.get("planner_isolation")
            if plan.get("past"):
                rec["past"] = plan["past"]
            # Walls the person removed stay off. A later revise does not bring them back.
            keep_off = rec.get("walls_kept") is False
            for k in ("understood", "will", "wont", "checklist", "steps", "session", "walls"):
                if k == "walls" and keep_off:
                    rec["walls"] = []
                    continue
                if plan.get(k) is not None:
                    rec[k] = plan[k]
            rec["raw"] = plan.get("raw")
            plan = dict(save_plan(rec), ok=True, error=plan.get("error"))
            tell_next(plan)
        else:
            # A failed revise did not write this plan. Leave the provider and the saved past alone.
            plan = dict(rec, ok=False, error=plan.get("error"))
        out(plan)
    elif verb == "create" and text and ck:
        if not os.path.isdir(cwd):
            out({"ok": False, "error": f"no such folder: {cwd}"})
            return 2
        nm = name or a.one(text, 60)
        wlines = _wall_lines(walls_file) if walls_file else []
        rec = {"id": new_id(nm), "name": nm, "cwd": os.path.realpath(cwd), "model": model,
               "asks": [text], "checklist": ck.strip(), "walls": parsed_walls(wlines),
               "steps": precheck(cwd, ck), "source": "hand", "created": stamp(), "runs": []}
        out(dict(save_plan(rec), ok=bool(a.parse_checklist(ck))))
    elif verb == "edit" and text:
        rec = load_plan(text.split()[0])
        if not rec:
            out({"ok": False, "error": f"no plan {text.split()[0]}"})
            return 2
        if name:
            rec["name"] = name
        if task_file is not None:
            rec["asks"] = [task_file]
        if ck is not None:
            rec.update(checklist=ck.strip(), steps=precheck(rec["cwd"], ck))
        if no_walls:
            rec["walls"] = []
            rec["walls_kept"] = False
        elif walls_file:
            rec["walls"] = parsed_walls(_wall_lines(walls_file))
            rec["walls_kept"] = True
        out(dict(save_plan(rec), ok=True))
    else:
        print(__doc__)
        return 2
    return 0

