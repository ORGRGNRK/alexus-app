    # Worker choice and handoff come from settings, or from --who. No walls, so handoff stays on.
    agent_mod().write_config({"owner": "Ada", "clis": ["grok", "claude", "codex"],
                              "default_who": "grok", "handoff": ["claude", "codex"]})
    grok_worker = (
        '{"type":"system","subtype":"init","session_id":"g","model":"grok"}\n'
