"""The planner. You say what you want; a planner says it back and writes the checklist.

The worker does not write its own exam. This program reuses bin/alexus's checklist
parser and sandboxed check runner. It does not copy them.

  alexus plan new --cwd DIR [--who claude|grok|codex] [--model M] [--name N] "task"
  alexus plan revise ID [--who claude|grok|codex] [--model M] "change"
  alexus plan create --cwd DIR --name N --checklist FILE [--walls FILE] "task"
  alexus plan edit ID [--checklist FILE] [--task-file FILE] [--name N] [--walls FILE|--no-walls]
  alexus plan list [--json]
  alexus plan show ID
  alexus plan start ID [--who claude|grok|codex] [--model M]
  alexus plan precheck --cwd DIR FILE
  alexus plan selfcheck

Saved plans: $ALEXUS_HOME/plans/<id>/  (default ~/.alexus/runner/plans)
  PLAN.md       the plan in plain words, including any past failures the planner saw
  checklist.md  the checklist `start` freezes
  plan.json     the saved record

Codex is the one planner with a provider read-only mode (its own sandbox flag). It is not
placed inside another sandbox, so that flag can apply. Claude and Grok have no such mode:
they plan inside a throwaway copy of the folder, and the prompt names that copy, not the real
folder. When a sandbox profile can be applied, their process is also denied writes to the real
folder. This program does not change the folder's permissions. That is a copy, not a claim
that those CLIs are read-only.

A check that already passes before any work is flagged "already true, proves nothing".
Walls use this program's wall lines. They are kept only if you leave them in the plan.
Enforced walls run on Claude only and turn handoff off.
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import uuid
from pathlib import Path

HERE = Path(__file__).resolve().parent
PLANNER_TOOLS = "Read,Grep,Glob,Bash,WebSearch,WebFetch"
WALLS_LIMIT = "these walls only run on Claude and turn handoff off"
PAST_LIMIT = 1500
PLAN_TIMEOUT = 600
_AGENT = None
_SANDBOX_OK = None

# Loaded by the planner process. Refuses writes under the real task folder. Not a provider read-only mode.
# Callables are objects, not functions: pathlib stores os.open on a class, and a function would bind
# and shift the arguments (Python 3.9 raises TypeError on every write).
_WRITE_GUARD = r'''
import builtins
import io
import os
_real = os.path.realpath(os.environ.get("ALEXUS_PLAN_REAL", "") or "")

def _under(path):
    if not _real or isinstance(path, int):
        return False
    try:
        p = os.path.realpath(os.fspath(path))
    except Exception:
        return False
    return p == _real or p.startswith(_real + os.sep)

def _deny(path):
    try:
        shown = os.fspath(path)
    except Exception:
        shown = str(path)
    raise PermissionError(13, "Permission denied", shown)

_bopen = builtins.open
class _TextOpen:
    def __call__(self, file, mode="r", *a, **k):
        m = mode if isinstance(mode, str) else ""
        if any(c in m for c in "wax+") and _under(file):
            _deny(file)
        return _bopen(file, mode, *a, **k)

builtins.open = _TextOpen()
io.open = builtins.open

_osopen = os.open
class _OsOpen:
    def __call__(self, path, flags, mode=0o777, *a, **k):
        bits = 0
        for name in ("O_WRONLY", "O_RDWR", "O_APPEND", "O_CREAT", "O_TRUNC"):
            bits |= getattr(os, name, 0)
        if isinstance(flags, int) and (flags & bits) and _under(path):
            _deny(path)
        return _osopen(path, flags, mode, *a, **k)

os.open = _OsOpen()

class _Unary:
    def __init__(self, fn):
        self.fn = fn
    def __call__(self, path, *a, **k):
        if _under(path):
            _deny(path)
        return self.fn(path, *a, **k)

for _name in ("chmod", "lchmod", "chflags", "remove", "unlink", "mkdir", "rmdir", "makedirs", "truncate"):
    _fn = getattr(os, _name, None)
    if _fn is not None:
        setattr(os, _name, _Unary(_fn))

class _Binary:
    def __init__(self, fn):
        self.fn = fn
    def __call__(self, src, dst, *a, **k):
        if _under(src) or _under(dst):
            _deny(dst)
        return self.fn(src, dst, *a, **k)

for _name in ("rename", "replace", "link", "symlink"):
    _fn = getattr(os, _name, None)
    if _fn is not None:
        setattr(os, _name, _Binary(_fn))
'''

# Path bits and tiny words that would match every temp folder or every sentence.
PAST_STOP = frozenset("""
this that with from your have will when what into over only then than them they were been
also just about after before would could should there their which where while tmp temp
private folders users home developer applications application library support agent runner alexus
true false none null file files test tests plan self check work code bin var
""".split())


def agent_mod():
    """bin/alexus holds the one checklist grammar and the sandboxed check runner."""
    global _AGENT
    if _AGENT is not None:
        return _AGENT
    path = str(HERE / "alexus")
    loader = importlib.machinery.SourceFileLoader("alexus_mod", path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("alexus_mod", loader))
    loader.exec_module(mod)
    _AGENT = mod
    return mod


def planner_guide(owner):
    who = owner if owner and owner != "you" else "you"
    return f"""You are the planner. You are talking with {who} before any work starts. You do NOT do the task.
You are looking at a copy of the task folder. Change nothing: do not create, edit or delete files.
Then answer in exactly this shape, plain English, short:

UNDERSTOOD: <one or two sentences: what {who} wants, in your words>
WILL: <what the worker will do>
WONT: <what it will not do, or what is out of scope>
WALLS:
- <one wall per line, or the single word none>
## Checklist
- [ ] <what must be true when it is done> :: verify: <shell command that exits 0 only when it is true>

Wall lines use the runner's wall form: no-network, read-only, write-only: paths, app-only: App,
deny: regex, once: regex, no-tool: ToolA, ToolB, or a plain sentence. Leave WALLS as none when
nothing must be blocked. Enforced walls run on Claude only and turn handoff off; say so by using
those wall forms, not by picking a provider.

Checklist rules:
- 2 to 8 lines. Each command must FAIL now (before the work) and pass only when the work is really done.
  Make it strict enough that empty or fake work fails: check contents, counts, exact values, not just that a file exists.
- Optional  :: expect: <regex>  when the output must match something.
- Commands run later in the task folder, with writes outside temp folders blocked, no ssh/scp/rsync, 120 s each.
  Prove things on this computer: files, git, test, grep, jq, curl to a URL.
- Write every path, in checks and in walls, relative to the task folder, which is the current directory.
  Do not use an absolute path. The copy in front of you is deleted when you finish, and a path into it cannot work later.
- Use  :: verify: HUMAN  only for what only {who} can judge (taste, "is this the right one", something on another device).
  Keep those few.
- Anything that spends money, deletes things, sends messages outside, or changes accounts: say so under WONT unless
  {who} clearly asked for it, and give it a HUMAN line.
If {who} asks for a change, give the whole answer again in the same shape."""


def parse_plan(text):
    """Pull UNDERSTOOD / WILL / WONT / WALLS / the checklist out of a planner reply."""
    names = r"UNDERSTOOD|WILL|WONT|WON'T|WALLS"

    def field(name):
        m = re.search(rf"^\s*{name}:\s*(.+?)(?=^\s*(?:{names}):|^\s*## Checklist|\Z)", text or "", re.M | re.S)
        return " ".join(m.group(1).split()) if m else ""

    walls = []
    m = re.search(r"^\s*WALLS:\s*(.*?)(?=^\s*## Checklist|\Z)", text or "", re.M | re.S)
    if m:
        body = m.group(1).strip()
        if body.lower() != "none":
            for line in body.splitlines():
                line = re.sub(r"^\s*[-*]\s*", "", line).strip()
                if line and line.lower() != "none":
                    walls.append(line)
    ck = ""
    m = re.search(r"^\s*## Checklist\s*$(.*)", text or "", re.M | re.S)
    if m:
        ck = "\n".join(l.strip() for l in m.group(1).splitlines() if l.strip().startswith("- ["))
    return {"understood": field("UNDERSTOOD"), "will": field("WILL"),
            "wont": field("WONT") or field("WON'T"), "walls": walls, "checklist": ck}


def flag_steps(steps):
    """A check that already passes, before any work, proves nothing about the work."""
    for s in steps:
        if s.get("ok") is True:
            s["proves_nothing"] = True
            s["note"] = "already true, proves nothing"
        else:
            s["proves_nothing"] = False
    return steps


def precheck(cwd, checklist_text):
    a = agent_mod()
    steps = a.parse_checklist(checklist_text)
    with tempfile.TemporaryDirectory(prefix="alexus-plan-") as d:
        a.run_checks(Path(d), cwd, steps)
    return flag_steps(steps)


def parsed_walls(lines):
    a = agent_mod()
    out = []
    for line in lines or []:
        text = " ".join(str(line).split())
        if not text or text.lower() == "none":
            continue
        out.append(a.parse_wall(text))
    return out


def keywords(text):
    words = re.findall(r"[a-z0-9]{4,}", (text or "").lower())
    return {w for w in words if w not in PAST_STOP}


# The account segment of /Users/<name> or /home/<name>. Two folders under one login are not a match.
_ACCOUNT_DIR = re.compile(r"^/(?:users|home)/([a-z0-9][a-z0-9._-]{0,63})(?=/|$)", re.I)
# One shared word is a coincidence. Two task words, or the same folder name, is a match.
_MIN_WORD_OVERLAP = 2


def folder_leaf(cwd):
    """The folder's own name. A parent such as Projects is not a match between its children."""
    text = (cwd or "").replace("\\", "/").rstrip("/")
    if not text:
        return ""
    m = _ACCOUNT_DIR.match(text)
    if m:
        text = text[m.end():].strip("/")
    leaf = text.rsplit("/", 1)[-1].lower()
    if leaf in PAST_STOP or not re.fullmatch(r"[a-z0-9][a-z0-9._-]{3,}", leaf or ""):
        return ""
    return leaf


def _finished(st):
    if not isinstance(st, dict) or not str(st.get("task") or "").strip():
        return False
    if st.get("status") in ("starting", "running"):
        return False
    return bool(st.get("ended") or st.get("verdict") or st.get("status") in ("done", "failed", "stopped"))


def _is_failure(st):
    """A run that worked is not a past failure, and must not take a slot from one."""
    if not _finished(st):
        return False
    verdict = str(st.get("verdict") or "").strip().lower()
    if verdict in ("proved", "needs you"):
        return False
    # A plain run has no verdict. Finishing normally is not a failure.
    return bool(verdict) or st.get("status") != "done"


# This text goes to a planner, maybe another provider, and is saved on the plan.
_SECRET_TEXT = re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?(?:-----END [A-Z ]*PRIVATE KEY-----|\Z)"
                          r"|\b(?:sk-[A-Za-z0-9_-]{16,}|ghp_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{16,}"
                          r"|xai-[A-Za-z0-9]{16,})", re.S)


def _snippet(st):
    lines = [f"Asked: {st.get('task') or ''}"]
    lines.append(f"Verdict: {st.get('verdict') or st.get('status') or ''}")
    fails = []
    for c in st.get("checks") or []:
        if isinstance(c, dict) and c.get("ok") is False and c.get("claim"):
            fails.append(str(c["claim"]))
    if fails:
        lines.append("Failed checks: " + "; ".join(fails))
    crit = st.get("critic") if isinstance(st.get("critic"), dict) else {}
    refs = [str(x).strip() for x in (crit.get("refuted") or []) if str(x).strip()]
    if refs:
        lines.append("Critic: " + "; ".join(refs))
    return _SECRET_TEXT.sub("[removed]", "\n".join(lines))


def past_failures(request, cwd, limit=3, char_limit=PAST_LIMIT):
    """Up to 3 failed runs from this install. No network. Empty when nothing really matches.

    A match needs two shared task words, or the same folder name. One word is not enough.
    A parent directory is not the folder name. A proved run is left out.
    """
    a = agent_mod()
    query = keywords(request)
    leaf = folder_leaf(cwd)
    if not query and not leaf:
        return ""
    root = a.agents_dir()
    if not root.is_dir():
        return ""
    hits = []
    for d in root.iterdir():
        if not d.is_dir() or d.name.startswith(".") or d.is_symlink():
            continue
        st = a.load(d)
        try:
            if not _is_failure(st):
                continue
            words = len(query & keywords(str(st.get("task") or "")))
            same = bool(leaf) and leaf == folder_leaf(str(st.get("cwd") or ""))
            if words < _MIN_WORD_OVERLAP and not same:
                continue
            hits.append((words + (2 if same else 0), str(st.get("ended") or ""), _snippet(st)))
        except (AttributeError, TypeError, ValueError):
            continue    # one damaged run must not stop planning
    if not hits:
        return ""
    hits.sort(key=lambda h: (h[0], h[1]), reverse=True)
    parts = [h[2] for h in hits[:limit]]
    sep = "\n---\n"
    while True:
        text = sep.join(parts)
        if len(text) <= char_limit:
            return text
        i = max(range(len(parts)), key=lambda k: len(parts[k]))
        if len(parts[i]) <= 40:
            return text[:char_limit].rstrip()
        parts[i] = parts[i][:len(parts[i]) - 40].rstrip()


def throwaway_copy(real, base):
    """Same copy the critic uses, then a normal copy if the clone is not available."""
    a = agent_mod()
    try:
        work = a.critic_copy(real, base)
    except Exception:
        work = None
    if work and os.path.isdir(work):
        return work
    dest = Path(base) / "copy"
    try:
        shutil.copytree(real, dest, symlinks=True)
    except Exception:
        return None
    return str(dest)


def _deny_profile(real):
    # Last matching rule wins. Deny the real folder after the default allow, even when it sits under a temp dir.
    return "(version 1)\n(allow default)\n(deny file-write* (subpath " + json.dumps(os.path.realpath(real)) + "))\n"


def _sandbox_can_apply():
    """False when this process is already sandboxed and a second profile cannot be applied."""
    global _SANDBOX_OK
    if _SANDBOX_OK is not None:
        return _SANDBOX_OK
    sb = shutil.which("sandbox-exec") or "/usr/bin/sandbox-exec"
    if not (os.path.isfile(sb) and os.access(sb, os.X_OK)):
        _SANDBOX_OK = False
        return False
    try:
        r = subprocess.run([sb, "-p", "(version 1) (allow default)", "/usr/bin/true"],
                           capture_output=True, text=True, timeout=5)
        _SANDBOX_OK = r.returncode == 0
    except Exception:
        _SANDBOX_OK = False
    return _SANDBOX_OK


def _sandbox_refused(proc):
    """True when sandbox-exec could not apply a profile, so the planner CLI never started."""
    err = proc.stderr or ""
    return proc.returncode != 0 and "sandbox_apply" in err and "Operation not permitted" in err


def _guard_env(base, real, env):
    """Point the planner process at a write guard. Does not change the real folder."""
    guard = Path(base) / "guard"
    guard.mkdir(exist_ok=True)
    (guard / "sitecustomize.py").write_text(_WRITE_GUARD)
    prev = env.get("PYTHONPATH") or ""
    env["PYTHONPATH"] = str(guard) + (os.pathsep + prev if prev else "")
    env["ALEXUS_PLAN_REAL"] = os.path.realpath(real)
    return env


def planner_cmd(who, prompt, guide, model, cwd):
    """Argv for one planner call. Only Codex gets a provider read-only flag."""
    a = agent_mod()
    binary = a.cli_bin(who)
    if who == "codex":
        cmd = [binary, "exec", "--json", "--sandbox", "read-only", "--skip-git-repo-check", "--cd", cwd]
        if model:
            cmd += ["--model", model]
        return cmd + [guide + "\n\n" + prompt], True, "read-only sandbox"
    if who == "grok":
        cmd = [binary, "--cwd", cwd, "-p", prompt, "--output-format", "streaming-messages-json",
               "--always-approve", "--no-plan", "--rules", guide, "--disallowed-tools", a.GROK_OFF]
        if model:
            cmd += ["--model", model]
        return cmd, False, "throwaway copy"
    if who == "muse":
        full = guide + "\n\nTask: " + prompt
        cmd = [binary, "exec", "--json", "--yolo", "--disable-request-user-input", "--workspace", cwd, full]
        if model:
            cmd = cmd[:-1] + ["--model", model, cmd[-1]]
        return cmd, False, "throwaway copy"
    cmd = [binary, "-p", prompt, "--output-format", "stream-json", "--verbose",
           "--permission-mode", "auto", "--append-system-prompt", guide, "--tools", PLANNER_TOOLS]
    if model:
        cmd += ["--model", model]
    return cmd, False, "throwaway copy"


def texts_from_output(stdout):
    texts, session, cost = [], None, None
    for line in (stdout or "").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if not isinstance(e, dict):
            continue
        if e.get("type") == "thread.started" and e.get("thread_id"):
            session = e.get("thread_id")
        item = e.get("item") or {}
        if e.get("type") == "item.completed" and isinstance(item, dict) and item.get("type") == "agent_message":
            if item.get("text"):
                texts.append(item["text"])
        if e.get("type") == "assistant":
            for c in (e.get("message") or {}).get("content") or []:
                if isinstance(c, dict) and c.get("type") == "text" and c.get("text"):
                    texts.append(c["text"])
        if e.get("type") == "result":
            if e.get("session_id"):
                session = e.get("session_id")
            if e.get("total_cost_usd") is not None:
                cost = e.get("total_cost_usd")
            if e.get("result"):
                texts.append(e["result"])
        if e.get("type") == "text" and e.get("data"):
            texts.append(e["data"])
        if e.get("type") == "end" and e.get("sessionId"):
            session = e.get("sessionId")
    if not texts and (stdout or "").strip():
        texts = [stdout]
    return texts, session, cost


def user_prompt(folder, text, past):
    parts = [f"Task folder: {folder}", ""]
    if past:
        parts += ["PAST FAILURES (from earlier runs on this install):", past, ""]
    parts += ["What you were asked:", text]
    return "\n".join(parts)


def _strip_copy_path(text, work):
    """Turn the copy's absolute path into a path relative to the task folder."""
    if not text or not work:
        return text
    forms = []
    seen = set()
    for raw in (str(work), os.path.realpath(work)):
        raw = (raw or "").rstrip("/")
        if not raw or raw in seen or raw == "/":
            continue
        seen.add(raw)
        forms.append(raw)
        alt = raw[len("/private"):] if raw.startswith("/private/") else "/private" + raw
        alt = alt.rstrip("/")
        if alt and alt not in seen and alt != "/":
            seen.add(alt)
            forms.append(alt)
    forms.sort(key=len, reverse=True)
    for root in forms:
        text = text.replace(root + "/", "")
        text = text.replace(root, ".")
    return text


def _prompt_for_work(prompt, real, work):
    """Name the folder the planner is actually in. A copy must not be labeled with the real path.

    The critic does the same: it is shown the copy, so a write to the path it was given
    cannot land in the real folder when a sandbox profile cannot be applied.
    """
    real_s = os.path.realpath(real)
    work_s = os.path.realpath(work)
    if work_s == real_s:
        return prompt
    prefix = f"Task folder: {real_s}"
    if prompt.startswith(prefix):
        return f"Task folder: {work_s}" + prompt[len(prefix):]
    return prompt


def _child_env():
    """Environment for the planner process. The real folder path is not included."""
    env = dict(os.environ, NO_COLOR="1", TERM="dumb")
    env.pop("CLAUDECODE", None)
    env.pop("ALEXUS_PLAN_REAL", None)
    return env


def provider_order(cfg):
    a = agent_mod()
    order = []
    for w in [cfg.get("default_who")] + list(cfg.get("clis") or []) + list(cfg.get("handoff") or []):
        if not w:
            continue
        try:
            n = a.normalize_who(w)
        except SystemExit:
            continue
        if n not in order:
            order.append(n)
    return order or ["claude"]


def ask_one(who, real, prompt, model):
    """Run one provider against a copy when it has no read-only mode. Never writes the real folder."""
    a = agent_mod()
    guide = planner_guide(a.owner_name())
    base = Path(tempfile.mkdtemp(prefix="alexus-plan-"))
    try:
        work = throwaway_copy(real, str(base))
        if not work:
            if who != "codex":
                return {"ok": False, "who": who, "planner_read_only": False, "planner_isolation": "throwaway copy",
                        "error": "could not copy the folder, so the planner did not run"}
            work = real
        # The prompt that arrived names the real folder. Once a copy exists, show the copy instead.
        prompt = _prompt_for_work(prompt, real, work)
        cmd, read_only, isolation = planner_cmd(who, prompt, guide, model, work)
        # Codex's own flag is the read-only mode. An outer seatbelt would stop that flag from applying.
        if who != "codex":
            read_only = False
            isolation = "throwaway copy"
        bare = cmd
        env = _child_env()
        run_env = env
        # Codex is not wrapped. Claude and Grok are, only when a profile can be applied.
        # The real path is handed to the child only inside that profile, which denies writes to it.
        if who != "codex" and _sandbox_can_apply():
            prof = base / "deny.sb"
            prof.write_text(_deny_profile(real))
            sb = shutil.which("sandbox-exec") or "/usr/bin/sandbox-exec"
            cmd = [sb, "-f", str(prof), "--", *bare]
            run_env = _child_env()
            _guard_env(base, real, run_env)
        try:
            r = subprocess.run(cmd, cwd=work, capture_output=True, text=True, env=run_env, timeout=PLAN_TIMEOUT,
                               stdin=subprocess.DEVNULL)
        except Exception as e:
            return {"ok": False, "who": who, "planner_read_only": read_only, "planner_isolation": isolation,
                    "error": f"could not run the planner: {e}"}
        if cmd is not bare and _sandbox_refused(r):
            # The profile did not apply. Retry with no real path in the environment.
            try:
                r = subprocess.run(bare, cwd=work, capture_output=True, text=True, env=env, timeout=PLAN_TIMEOUT,
                                   stdin=subprocess.DEVNULL)
            except Exception as e:
                return {"ok": False, "who": who, "planner_read_only": read_only, "planner_isolation": isolation,
                        "error": f"could not run the planner: {e}"}
        texts, sess, cost = texts_from_output(r.stdout)
        if not texts:
            return {"ok": False, "who": who, "planner_read_only": read_only, "planner_isolation": isolation,
                    "error": a.one(r.stderr or r.stdout or f"planner exited {r.returncode}", 600)}
        text = next((t for t in reversed(texts) if re.search(r"^\s*## Checklist", t, re.M)), texts[-1])
        plan = parse_plan(text)
        # The copy is deleted after this call. A check or wall that names it would be frozen on a dead path.
        for key in ("understood", "will", "wont", "checklist"):
            plan[key] = _strip_copy_path(plan.get(key), work)
        plan["walls"] = [_strip_copy_path(w, work) for w in plan.get("walls") or []]
        plan.update(who=who, session=sess, cost_usd=cost, raw=text,
                    planner_read_only=read_only, planner_isolation=isolation)
        return plan
    finally:
        shutil.rmtree(base, ignore_errors=True)


def ask(cwd, text, model=None, who=None, past=None):
    a = agent_mod()
    cfg = a.load_config() or {}
    whos = [a.normalize_who(who)] if who else provider_order(cfg)
    if past is None:
        past = past_failures(text, cwd)
    prompt = user_prompt(os.path.realpath(cwd), text, past)
    last = {"ok": False, "error": "no planner is configured"}
    for w in whos:
        # A model name belongs to one provider. The next one in the order uses its own default.
        last = ask_one(w, os.path.realpath(cwd), prompt, model if w == whos[0] else None)
        last["past"] = past or ""
        if past:
            last["past"] = past
        else:
            last.pop("past", None)
        steps = precheck(cwd, last.get("checklist") or "") if last.get("checklist") else []
        last["steps"] = steps
        last["walls"] = parsed_walls(last.get("walls") or [])
        if not any(not s.get("human") for s in steps):
            last.update(ok=False, error=last.get("error") or "the planner wrote no checklist line with a command; ask it again or revise")
        else:
            last["ok"] = True
            return last
    return last


# ------------------------------------------------------------------ saved plans
def plans_dir():
    return agent_mod().runner_home() / "plans"


def stamp():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def new_id(name):
    slug = re.sub(r"[^a-z0-9]+", "-", (name or "plan").lower()).strip("-")[:40] or "plan"
    return time.strftime("%Y%m%d-%H%M%S-") + slug + "-" + uuid.uuid4().hex[:4]


def plan_path(pid):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,200}", str(pid or "")):
        return None
    root = plans_dir()
    d = root / pid
    if d.parent != root:
        return None
    return d


def load_plan(pid):
    d = plan_path(pid)
    if d is None:
        return None
    try:
        return json.loads((d / "plan.json").read_text())
    except Exception:
        return None


def task_text(rec):
    a = agent_mod()
    asks = rec.get("asks") or []
    if not asks:
        return rec.get("task") or ""
    if len(asks) == 1:
        return asks[0]
    who = a.owner_name()
    return asks[0] + f"\n\n{who} then added:\n" + "\n".join("- " + x for x in asks[1:])


def plan_md(rec):
    """Everything the worker needs. Past failures are in this file, not a side channel."""
    steps = rec.get("steps") or []
    lines = [f"# Plan: {rec.get('name')}", "",
             f"Folder: {rec.get('cwd')}  ·  saved {rec.get('updated')}  ·  plan id {rec.get('id')}"
             + (f"  ·  planner: {rec.get('who')}" if rec.get("who") else "")
             + (f"  ·  runs: {', '.join(rec['runs'])}" if rec.get("runs") else ""), ""]
    if rec.get("who") == "codex":
        lines += ["Codex ran in its read-only sandbox.", ""]
    elif rec.get("who"):
        lines += ["The planner looked at a throwaway copy of the folder and did not change it.", ""]
    lines += ["## What you asked", "", task_text(rec), ""]
    for k, h in (("understood", "Understood"), ("will", "Will"), ("wont", "Won't")):
        if rec.get(k):
            lines += [f"## {h}", "", rec[k], ""]
    walls = rec.get("walls") or []
    if walls:
        lines += ["## Walls", ""]
        for w in walls:
            mark = "enforced" if w.get("enforced") else "not machine-enforced"
            lines.append(f"- {w.get('text')} ({mark})")
        lines.append("")
        if any(w.get("enforced") for w in walls):
            lines += [WALLS_LIMIT, ""]
    lines += ["## Checklist", "", "Done means every command line exits 0. HUMAN lines are for "
              + agent_mod().owner_name() + ".", "", (rec.get("checklist") or "").strip(), ""]
    already = [x.get("claim") for x in steps if x.get("proves_nothing") or x.get("ok") is True]
    already = [x for x in already if x]
    if already:
        lines += ["Already true when the plan was saved (these prove nothing about the work): " + "; ".join(already), ""]
    if rec.get("past"):
        lines += ["## Past failures", "", rec["past"], ""]
    lines += ["## How to run it", "",
              f"From a shell: `alexus plan start {rec.get('id')}`.",
              "The worker does the work in the folder above so every checklist line is true.", ""]
    return "\n".join(lines)


def save_plan(rec):
    rec["updated"] = stamp()
    d = plan_path(rec["id"])
    if d is None:
        raise ValueError("bad plan id")
    d.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(plans_dir(), 0o700)
    except OSError:
        pass
    clean = {k: v for k, v in rec.items() if k != "raw" and not (k == "past" and not v)}
    if not clean.get("past"):
        clean.pop("past", None)
    clean["plan_md"] = str(d / "PLAN.md")
    if _enforced(clean.get("walls")):
        clean["walls_limit"] = WALLS_LIMIT
    else:
        clean.pop("walls_limit", None)
    (d / "plan.json").write_text(json.dumps(clean, indent=1) + "\n")
    (d / "checklist.md").write_text((rec.get("checklist") or "").strip() + "\n")
    (d / "PLAN.md").write_text(plan_md(clean))
    if rec.get("raw"):
        with open(d / "planner.log", "a") as f:
            f.write(f"\n===== {rec['updated']}\n{rec['raw']}\n")
    return clean


def all_plans():
    root = plans_dir()
    if not root.exists():
        return []
    out = []
    for d in sorted((p for p in root.iterdir() if p.is_dir()), key=lambda p: p.name, reverse=True):
        rec = load_plan(d.name)
        if rec:
            out.append(rec)
    return out


def _enforced(walls):
    return [w for w in (walls or []) if isinstance(w, dict) and w.get("enforced")]


def plan_model(rec, who):
    """A saved model name belongs to the provider that planned. Another provider uses its own default."""
    return rec.get("model") if (not rec.get("who") or rec.get("who") == who) else None


def revise_request(rec, change):
    """Every planner call gets a new copy, so an old conversation points at a folder that is gone.

    The planner starts fresh and is handed the request and the plan so far.
    """
    walls = [f"- {w['text']}" for w in rec.get("walls") or [] if isinstance(w, dict) and w.get("text")] or ["none"]
    earlier = [f"UNDERSTOOD: {rec.get('understood') or ''}", f"WILL: {rec.get('will') or ''}",
               f"WONT: {rec.get('wont') or ''}", "WALLS:", *walls, "## Checklist", (rec.get("checklist") or "").strip()]
    return "\n\n".join([task_text(rec), "The plan so far:\n" + "\n".join(earlier), "Change:\n" + change])


def tell_next(plan):
    """stdout stays JSON. This is the plain version for the person at the terminal."""
    if not (plan.get("ok") and plan.get("id")):
        return
    lines = [f"Plan saved. Read it: {plan.get('plan_md')}"]
    if plan.get("walls_limit"):
        lines.append(plan["walls_limit"])
    lines += [f"Change it: alexus plan revise {plan['id']} -- \"what to change\"",
              f"Run it: alexus plan start {plan['id']}"]
    print("\n".join(lines), file=sys.stderr)


def start_plan(pid, model=None, who=None):
    """Start the worker with the settings worker and handoff, unless enforced walls say otherwise."""
    a = agent_mod()
    cfg = a.require_config()
    rec = load_plan(pid)
    if not rec:
        return None, f"no plan {pid}"
    d = plan_path(pid)
    ck_path = d / "checklist.md"
    checklist = ck_path.read_text() if ck_path.is_file() else (rec.get("checklist") or "")
    if not a.parse_checklist(checklist):
        return None, "this plan has no checklist line with a command yet"
    walls = rec.get("walls") or []
    enforced = _enforced(walls)
    if enforced:
        if who and a.normalize_who(who) != "claude":
            return None, WALLS_LIMIT
        worker = "claude"
        handoff = "none"
    else:
        worker = a.normalize_who(who) if who else a.normalize_who(
            cfg.get("default_who") or (cfg.get("clis") or ["claude"])[0])
        chain = [str(w) for w in (cfg.get("handoff") or []) if str(w).strip()]
        handoff = ",".join(chain) if chain else "none"
    cmd = [sys.executable, "-B", "-I", str(HERE / "alexus"), "start",
           "--cwd", rec["cwd"], "--name", rec.get("name") or pid,
           "--who", worker, "--checklist", str(ck_path)]
    if handoff == "none":
        cmd.append("--no-handoff")
    else:
        cmd += ["--handoff", handoff]
    use_model = model or plan_model(rec, worker)
    if use_model:
        cmd += ["--model", use_model]
    if walls:
        outcome = rec.get("understood") or (rec.get("asks") or [""])[0] or rec.get("name") or "the agreed plan"
        domain = {"outcome": outcome, "proof": [], "walls": [w.get("text") or "" for w in walls if w.get("text")]}
        df = d / "domain.json"
        df.write_text(json.dumps(domain) + "\n")
        cmd += ["--domain", str(df)]
    task = task_text(rec) + f"\n\nRead the plan first. It lists any past failures to avoid: {d / 'PLAN.md'}"
    r = subprocess.run(cmd + ["--", task], capture_output=True, text=True)
    if r.returncode != 0:
        return None, (r.stderr or r.stdout).strip()
    rid = r.stdout.strip().splitlines()[-1]
    fresh = load_plan(pid) or rec
    fresh.setdefault("runs", []).append(rid)
    save_plan(fresh)
    return rid, None


def _take(it):
    try:
        return next(it)
    except StopIteration:
        sys.exit("alexus plan: missing a value for the last flag")


def _wall_lines(path):
    text = Path(os.path.expanduser(path)).read_text()
    return [re.sub(r"^\s*[-*]\s*", "", ln).strip() for ln in text.splitlines() if ln.strip()]


def selfcheck():
    """Fake CLIs only. No model call. Prints one ok line per case."""
    ok = True

    def check(name, cond):
        nonlocal ok
        print(("ok  " if cond else "FAIL ") + name)
        if not cond:
            ok = False

    home = Path(tempfile.mkdtemp(prefix="alexus-plan-sc-"))
    state = home / "state"
    work = home / "workbox"
    bindir = home / "bin"
    state.mkdir()
    work.mkdir()
    bindir.mkdir()
    (work / "keep.txt").write_text("keep")
    os.chmod(work, 0o1755)
    os.chmod(work / "keep.txt", 0o644)
    # Test-only: lets the fake stat the real folder during the call. The product does not set this.
    os.environ["PLAN_SC_REAL"] = str(work.resolve())
    os.environ["HOME"] = str(home)
    os.environ["ALEXUS_HOME"] = str(state)
    os.environ["ALEXUS_CRITICS"] = "claude"
    os.environ["PATH"] = str(bindir) + os.pathsep + "/usr/bin" + os.pathsep + "/bin"
    for key in ("ALEXUS_CLAUDE", "ALEXUS_GROK", "ALEXUS_CODEX", "ALEXUS_MUSE"):
        os.environ.pop(key, None)
    agent_mod().write_config({"owner": "Ada", "clis": ["claude", "grok", "codex"],
                              "default_who": "claude", "handoff": ["grok", "codex"]})

    sample = """UNDERSTOOD: Make primes.txt.
WILL: write the file.
WONT: nothing else.
WALLS:
- no-network
- be kind
## Checklist
- [ ] primes.txt lists five primes :: verify: test -f primes.txt
- [ ] already true :: verify: true
- [ ] looks right :: verify: HUMAN
"""
    parsed = parse_plan(sample)
    walls = parsed_walls(parsed["walls"])
    check("plan-parse", parsed["understood"] == "Make primes.txt." and parsed["wont"] == "nothing else."
          and parsed["checklist"].count("- [ ]") == 3 and [w["kind"] for w in walls] == ["no-network", "text"]
          and walls[0]["enforced"] is True and walls[1]["enforced"] is False)
    steps = {s["claim"]: s for s in precheck(str(work), parsed["checklist"])}
    already = steps.get("already true") or {}
    missing = steps.get("primes.txt lists five primes") or {}
    human = steps.get("looks right") or {}
    check("plan-precheck-flags-already-true", already.get("ok") is True and already.get("proves_nothing") is True
          and already.get("note") == "already true, proves nothing" and missing.get("ok") is False
          and missing.get("proves_nothing") is False and human.get("ok") is None and human.get("proves_nothing") is False)
    src = (HERE / "alexus-plan").read_text()
    check("plan-timeout-600", PLAN_TIMEOUT == 600 and "timeout=PLAN_TIMEOUT" in src
          and ("timeout=" + "90") not in src)

    reply = sample.replace("WALLS:\n- no-network\n- be kind\n", "WALLS:\nnone\n")

    def write_fake(who, body_lines):
        path = bindir / who
        path.write_text(body_lines)
        path.chmod(0o755)
        os.environ["ALEXUS_" + who.upper()] = str(path)
        return path

    def planner_body(who, document):
        if who == "codex":
            lines = [
                json.dumps({"type": "thread.started", "thread_id": f"sess-{who}"}),
                json.dumps({"type": "item.completed", "item": {"id": "m", "type": "agent_message", "text": document}}),
                json.dumps({"type": "turn.completed"}),
            ]
        else:
            lines = [
                json.dumps({"type": "assistant", "message": {"content": [{"type": "text", "text": document}]}}),
                json.dumps({"type": "result", "result": "ok", "session_id": f"sess-{who}", "total_cost_usd": 0.01}),
            ]
        payload = "\n".join(lines) + "\n"
        return (
            "#!/usr/bin/env python3\n"
            "import json, os, pathlib, subprocess, sys\n"
            f"who = {who!r}\n"
            "home = os.environ.get('ALEXUS_HOME', '')\n"
            "pathlib.Path(home, 'ran-' + who).write_text('yes')\n"
            "pathlib.Path(home, 'argv-' + who).write_text(json.dumps(sys.argv))\n"
            "try:\n"
            "    parent = subprocess.check_output(['ps', '-o', 'command=', '-p', str(os.getppid())], text=True)\n"
            "except Exception:\n"
            "    parent = ''\n"
            "pathlib.Path(home, 'parent-' + who).write_text(parent)\n"
            "try:\n"
            "    pathlib.Path('planner-must-not-write').write_text('rel')\n"
            "except OSError:\n"
            "    pass\n"
            "blob = ' '.join(sys.argv)\n"
            "marker = 'Task folder: '\n"
            "i = blob.find(marker)\n"
            "folder = blob[i + len(marker):].split()[0] if i >= 0 else ''\n"
            "watch = os.environ.get('PLAN_SC_REAL') or folder\n"
            "if watch:\n"
            "    try:\n"
            "        dmode = os.stat(watch).st_mode & 0o7777\n"
            "        fmode = os.stat(os.path.join(watch, 'keep.txt')).st_mode & 0o7777\n"
            "        pathlib.Path(home, 'modes-' + who).write_text('%d %d' % (dmode, fmode))\n"
            "    except OSError:\n"
            "        pass\n"
            "if folder:\n"
            "    try:\n"
            "        pathlib.Path(folder, 'planner-must-not-write').write_text('abs')\n"
            "    except OSError:\n"
            "        pass\n"
            "sys.stdout.write(" + repr(payload) + ")\n"
        )

    script = str(HERE / "alexus")
    py = sys.executable

    def run_cli(args, env=None, timeout=40):
        return subprocess.run([py, "-B", "-I", script, "plan", *args], capture_output=True, text=True,
                              timeout=timeout, env=env or os.environ.copy())

    claude_id = None
    for who in ("claude", "codex", "grok"):
        for other in ("claude", "codex", "grok"):
            for name in (f"ran-{other}", f"argv-{other}"):
                p = state / name
                if p.exists():
                    p.unlink()
        bad = work / "planner-must-not-write"
        if bad.exists():
            bad.unlink()
        write_fake(who, planner_body(who, reply))
        # The other two stay installed so a silent fallback would touch their marker.
        for other in ("claude", "codex", "grok"):
            if other != who and not (bindir / other).exists():
                write_fake(other, planner_body(other, reply))
        r = run_cli(["new", "--who", who, "--cwd", str(work), "--name", f"Marker {who}", "--", "add a marker file"])
        data = {}
        try:
            data = json.loads(r.stdout or "{}")
        except ValueError:
            data = {}
        argv = []
        argv_path = state / f"argv-{who}"
        if argv_path.is_file():
            try:
                argv = json.loads(argv_path.read_text())
            except ValueError:
                argv = []
        ran_only = (state / f"ran-{who}").is_file() and not any(
            (state / f"ran-{o}").is_file() for o in ("claude", "codex", "grok") if o != who)
        good = (r.returncode == 0 and data.get("ok") is True and data.get("who") == who
                and data.get("session") == f"sess-{who}" and ran_only)
        if not good:
            sys.stderr.write(f"plan-who-{who}: rc {r.returncode} out {r.stdout[:400]!r} err {r.stderr[:400]!r}\n")
        check(f"plan-who-{who}", good)
        untouched = (not bad.exists()) and (work / "keep.txt").read_text() == "keep"
        if not untouched:
            sys.stderr.write(f"plan-write-{who}: real folder changed\n")
        check(f"plan-write-{who}", untouched)
        if who == "codex":
            try:
                i = argv.index("--sandbox")
                flagged = argv[i + 1] == "read-only"
            except ValueError:
                flagged = False
            parent = (state / "parent-codex").read_text() if (state / "parent-codex").is_file() else ""
            check("plan-codex-readonly", flagged and data.get("planner_read_only") is True
                  and data.get("planner_isolation") == "read-only sandbox")
            check("plan-codex-no-outer-sandbox", flagged and "sandbox-exec" not in parent)
        elif who == "claude":
            claude_id = data.get("id")
            check("plan-claude-not-claimed-readonly", data.get("planner_read_only") is False
                  and data.get("planner_isolation") == "throwaway copy" and "--sandbox" not in argv)
        else:
            check("plan-grok-not-claimed-readonly", data.get("planner_read_only") is False
                  and data.get("planner_isolation") == "throwaway copy" and "--sandbox" not in argv)

    sticky = True
    for who in ("claude", "codex", "grok"):
        raw = (state / f"modes-{who}").read_text().split() if (state / f"modes-{who}").is_file() else []
        if len(raw) != 2 or int(raw[0]) != 0o1755 or int(raw[1]) != 0o644:
            sticky = False
            sys.stderr.write(f"plan-sticky {who}: during {raw}\n")
    after_d = os.stat(work).st_mode & 0o7777
    after_f = os.stat(work / "keep.txt").st_mode & 0o7777
    check("plan-sticky-unchanged", sticky and after_d == 0o1755 and after_f == 0o644)

    # Revise stays on the same provider. It starts fresh, with the plan so far in the prompt.
    if claude_id:
        (state / "argv-claude").unlink(missing_ok=True)
        r = run_cli(["revise", claude_id, "--", "start the list at 2"])
        argv = []
        if (state / "argv-claude").is_file():
            argv = json.loads((state / "argv-claude").read_text())
        rec = load_plan(claude_id) or {}
        said = next((a for a in argv if "What you were asked:" in str(a)), "")
        check("plan-revise-no-resume", "--resume" not in argv and "sess-claude" not in argv
              and "add a marker file" in said and "primes.txt lists five primes" in said
              and "UNDERSTOOD: Make primes.txt." in said and "start the list at 2" in said)
        check("plan-revise", r.returncode == 0 and len(rec.get("asks") or []) == 2 and "Ada then added" in (plan_path(claude_id) / "PLAN.md").read_text())

    # A different provider still has to see the original request.
    shed = run_cli(["new", "--who", "claude", "--cwd", str(work), "--name", "Bike paint", "--",
                    "paint the bike shed red with two coats"])
    shed_rec = {}
    try:
        shed_rec = json.loads(shed.stdout or "{}")
    except ValueError:
        shed_rec = {}
    (state / "argv-codex").unlink(missing_ok=True)
    rev = run_cli(["revise", shed_rec.get("id") or "missing", "--who", "codex", "--", "start at 2"])
    argv = json.loads((state / "argv-codex").read_text()) if (state / "argv-codex").is_file() else []
    prompt = next((a for a in argv if "What you were asked:" in str(a)), "")
    kept_task = ("paint the bike shed red with two coats" in prompt and "start at 2" in prompt
                 and "--resume" not in argv and "sess-claude" not in argv)
    if not kept_task:
        sys.stderr.write(f"plan-revise-keeps-task: rc {rev.returncode} prompt {prompt[-240:]!r}\n")
    check("plan-revise-keeps-task", rev.returncode == 0 and kept_task)

    # A revise that fails must not switch the provider or claim that provider wrote the plan.
    fail_codex = bindir / "fail-codex"
    fail_codex.write_text("#!/bin/sh\nexit 1\n")
    fail_codex.chmod(0o755)
    stay = run_cli(["new", "--who", "claude", "--cwd", str(work), "--name", "Stay", "--",
                    "paint the bike shed red with two coats"])
    stay_rec = {}
    try:
        stay_rec = json.loads(stay.stdout or "{}")
    except ValueError:
        stay_rec = {}
    failed = run_cli(["revise", stay_rec.get("id") or "missing", "--who", "codex", "--", "start at 2"],
                     env=dict(os.environ, ALEXUS_CODEX=str(fail_codex)))
    failed_out = {}
    try:
        failed_out = json.loads(failed.stdout or "{}")
    except ValueError:
        failed_out = {}
    saved_stay = load_plan(stay_rec.get("id") or "") or {}
    stayed = (failed_out.get("ok") is False and saved_stay.get("who") == "claude"
              and saved_stay.get("planner_read_only") is False
              and saved_stay.get("planner_isolation") == "throwaway copy"
              and len(saved_stay.get("asks") or []) == 1
              and saved_stay.get("understood") == "Make primes.txt.")
    if not stayed:
        sys.stderr.write(f"plan-revise-failed-keeps-who: rc {failed.returncode} out {failed_out} saved {saved_stay.get('who')} {saved_stay.get('planner_read_only')} {saved_stay.get('planner_isolation')}\n")
    check("plan-revise-failed-keeps-who", stayed)

    # Past failures: keyword overlap, 3 matches, 1500 characters, nothing when the words do not overlap.
    agents = state / "agents"
    agents.mkdir(exist_ok=True)
    planted = {
        "inv-a": {"task": "repair the invoice export totals mismatch", "ended": "2026-11-09T00:00:04",
                  "status": "failed", "verdict": "dead end", "cwd": "/proj/invoices",
                  "checks": [{"claim": "totals match", "cmd": "test -f x", "ok": False}],
                  "critic": {"refuted": ["export drops the last row " + ("Z" * 4000)]}},
        "inv-b": {"task": "invoice export layout", "ended": "2026-11-09T00:00:03",
                  "status": "failed", "verdict": "dead end", "cwd": "/proj/invoices"},
        "inv-c": {"task": "invoice export printer jam", "ended": "2026-11-09T00:00:02",
                  "status": "failed", "verdict": "dead end", "cwd": "/proj/invoices"},
        "inv-d": {"task": "invoice font size", "ended": "2026-11-09T00:00:01",
                  "status": "failed", "verdict": "dead end", "cwd": "/proj/invoices"},
