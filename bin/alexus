        st_s, d_s, arh_s, work_s = arm_rec("alexus-rec-surr-", surr_fake, "surr-run")
        surr_tool = False
        sp = d_s / "receipts.jsonl"
        if sp.is_file():
            try:
                blob = sp.read_bytes().decode("utf-8", errors="surrogatepass")
            except Exception:
