                         "now": "", "plan": [], "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0,
                         "remark": "", "final": "", "cost_usd": None, "turns": None, "session": None, "pid": None})
        run(rid)
        return load(tmp / "agents" / rid), tmp

    ps, ptmp = proved_run("good")
    claims = {c["claim"]: c for c in ps.get("checks") or []}
    check("proved-loop", ps["verdict"] == "needs you" and ps["status"] == "done"
          and (ptmp / "agents/p-good/fake-legs").read_text().strip() == "3"
          and (ptmp / "agents/p-good/fake-critics").read_text().strip() == "2"
          and ps["critic"]["verdict"] == "pass" and abs(ps["cost_usd"] - 2.0) < 1e-9)
    check("proved-freeze", claims.get("out.txt exists", {}).get("cmd") == "test -s out.txt"
          and "first version" in claims.get("out.txt exists", {}).get("restored", "")
          and claims.get("new line", {}).get("added") and claims.get("the result looks right", {}).get("ok") is None)
    ss, _ = proved_run("stuck")
    check("proved-dead-end", ss["verdict"] == "dead end" and ss["status"] == "failed" and "nothing new" in ss["verdict_note"])
    ws, _ = proved_run("write")
    sandbox_blocked = (sbx_probe is not None and ws["checks"][0]["ok"] is False and not sbx_probe.exists())
    if sbx_probe is not None and sbx_probe.exists():
        sbx_probe.unlink()
    check("proved-sandbox", sandbox_blocked)

    # Check force-stop
    stop_tmp = Path(tempfile.mkdtemp(prefix="alexus-stop-"))
    os.environ["ALEXUS_HOME"] = str(stop_tmp)
    s_rid = "test-stop-run"
    (stop_tmp / "agents" / s_rid).mkdir(parents=True)
    save(stop_tmp / "agents" / s_rid, {"id": s_rid, "name": s_rid, "task": "test", "cwd": str(stop_tmp), "who": "claude",
                            "status": "running", "pid": 9999999, "plan": [{"step": "step 1", "status": "in_progress"}]})
    stop(s_rid, force=True)
    stopped_st = load(stop_tmp / "agents" / s_rid)
    check("agent-force-stop", stopped_st["status"] == "stopped" and "force" in stopped_st.get("now", "")
          and stopped_st["pid"] is None and stopped_st["plan"][0]["status"] == "left")

    # Provider handoff checks:
    # 1. Auto-handoff on provider failure (codex quota fail -> grok succeeds and receives handoff context)
    ho_tmp = Path(tempfile.mkdtemp(prefix="alexus-handoff-"))
    grok_ho = bin_dir / "grok-handoff"
    grok_ho.write_text(r"""#!/bin/bash
D="$ALEXUS_HOME/agents/$ALEXUS_RUN"
printf '%s' "$*" > "$D/grok-args.txt"
printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-grok-ho","model":"grok-4.7"}'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"w1","name":"Read","input":{"file_path":"x"}}]}}'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"DONE: finished after handoff\nLEFT: nothing"}]}}'
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: finished after handoff\nLEFT: nothing","total_cost_usd":0.02,"num_turns":1,"session_id":"sess-grok-ho"}'
""")
    os.chmod(grok_ho, 0o755)
    os.environ.update(ALEXUS_HOME=str(ho_tmp),
                      ALEXUS_CODEX=str(codex_fail), ALEXUS_GROK=str(grok_ho),
                      ALEXUS_CLAUDE=str(claude))
    ho_rid = "test-auto-handoff"
    (ho_tmp / "agents" / ho_rid).mkdir(parents=True)
    save(ho_tmp / "agents" / ho_rid, {"id": ho_rid, "name": ho_rid, "task": "relay task across providers", "cwd": str(ho_tmp),
                           "who": "codex", "started_who": "codex", "handoff_chain": ["grok"],
                           "handoffs": [], "mode": "plain", "status": "starting", "started": now(), "ended": None,
                           "now": "", "plan": [{"step": "step one", "status": "in_progress"}], "actions": [],
                           "tools": 0, "errors": 0, "hook_blocks": 0, "remark": "", "final": "", "cost_usd": None,
                           "turns": None, "session": None, "pid": None})
    run(ho_rid)
    ho_st = load(ho_tmp / "agents" / ho_rid)
    grok_args = (ho_tmp / "agents" / ho_rid / "grok-args.txt").read_text() if (ho_tmp / "agents" / ho_rid / "grok-args.txt").exists() else ""
    check("auto-handoff-on-fail", ho_st["status"] == "done" and ho_st["who"] == "grok"
          and ho_st["started_who"] == "codex" and len(ho_st.get("handoffs") or []) == 1
          and ho_st["handoffs"][0]["from"] == "codex" and ho_st["handoffs"][0]["to"] == "grok"
          and "quota" in ho_st["handoffs"][0]["reason"].lower()
          and "HANDOFF FROM CODEX" in grok_args and "relay task across providers" in grok_args
          and "codex->grok" in run_summary(ho_st))

    # 2. Auto-handoff when a provider finishes but leaves non-human work in LEFT: or unfinished plan steps
    grok_partial = bin_dir / "grok-partial"
    grok_partial.write_text(r"""#!/bin/bash
printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-grok-part","model":"grok-4.7"}'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"todo_write","input":{"merge":false,"todos":[{"id":"1","content":"part 1","status":"completed"},{"id":"2","content":"part 2","status":"pending"}]}},{"type":"text","text":"DONE: completed part 1\nLEFT: implement part 2 in module.py"}]}}'
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: completed part 1\nLEFT: implement part 2 in module.py","total_cost_usd":0.01,"num_turns":1,"session_id":"sess-grok-part"}'
""")
    os.chmod(grok_partial, 0o755)
    os.environ["ALEXUS_GROK"] = str(grok_partial)
    hp_rid = "test-unfinished-handoff"
    (ho_tmp / "agents" / hp_rid).mkdir(parents=True)
    save(ho_tmp / "agents" / hp_rid, {"id": hp_rid, "name": hp_rid, "task": "two part task", "cwd": str(ho_tmp),
                           "who": "grok", "started_who": "grok", "handoff_chain": ["claude"],
                           "handoffs": [], "mode": "plain", "status": "starting", "started": now(), "ended": None,
                           "now": "", "plan": [], "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0,
                           "remark": "", "final": "", "cost_usd": None, "turns": None, "session": None, "pid": None})
    run(hp_rid)
    hp_st = load(ho_tmp / "agents" / hp_rid)
    check("auto-handoff-unfinished-steps", hp_st["status"] == "done" and hp_st["who"] == "claude"
          and len(hp_st.get("handoffs") or []) == 1 and hp_st["handoffs"][0]["from"] == "grok"
          and hp_st["handoffs"][0]["to"] == "claude" and abs((hp_st.get("cost_usd") or 0) - 1.51) < 1e-6)

    # 3. Human-only LEFT: ("Physical touch on YubiKey") must NOT hand off to another AI
    grok_human = bin_dir / "grok-human"
    grok_human.write_text(r"""#!/bin/bash
printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-grok-hum","model":"grok-4.7"}'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"DONE: code verified\nLEFT: waiting for you to confirm"}]}}'
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: code verified\nLEFT: waiting for you to confirm","total_cost_usd":0.01,"num_turns":1,"session_id":"sess-grok-hum"}'
""")
    os.chmod(grok_human, 0o755)
    os.environ["ALEXUS_GROK"] = str(grok_human)
    hh_rid = "test-human-no-handoff"
    (ho_tmp / "agents" / hh_rid).mkdir(parents=True)
    save(ho_tmp / "agents" / hh_rid, {"id": hh_rid, "name": hh_rid, "task": "verify hardware key", "cwd": str(ho_tmp),
                           "who": "grok", "started_who": "grok", "handoff_chain": ["claude"],
                           "handoffs": [], "mode": "plain", "status": "starting", "started": now(), "ended": None,
                           "now": "", "plan": [], "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0,
                           "remark": "", "final": "", "cost_usd": None, "turns": None, "session": None, "pid": None})
    run(hh_rid)
    hh_st = load(ho_tmp / "agents" / hh_rid)
    check("handoff-preserves-human-stop", hh_st["status"] == "done" and hh_st["who"] == "grok"
          and len(hh_st.get("handoffs") or []) == 0)

    # 4. Manual `alexus handoff` command creates a linked continuation run with carried-over state
    m_new_id = handoff([hh_rid, "--who", "claude", "--no-handoff", "continue after hardware touch"], spawn=False)
    m_new_st = load(ho_tmp / "agents" / m_new_id)
    hh_after = load(ho_tmp / "agents" / hh_rid)
    check("manual-handoff-cmd", m_new_st and m_new_st["who"] == "claude"
          and m_new_st["handoff_from"] == hh_rid and hh_after.get("handed_off_to") == m_new_id
          and m_new_st["handoff_chain"] == [] and len(m_new_st.get("handoffs") or []) == 1
          and (ho_tmp / "agents" / m_new_id / "handoff_prompt.txt").exists())

    # 5. Optional local auditor (flags unsupported claim, sends back for correction)
    horn_bin = bin_dir / "auditor-fake"
    horn_bin.write_text(r"""#!/usr/bin/env python3
import json, sys
inp = json.load(sys.stdin)
if "unverified-claim" in inp.get("answer", ""):
    print(json.dumps({"unsupported": [{"claim": "unverified-claim", "why": "no tool output backs this"}]}))
else:
    print(json.dumps({"unsupported": []}))
""")
    os.chmod(horn_bin, 0o755)
    grok_horn = bin_dir / "grok-horn"
    grok_horn.write_text(r"""#!/bin/bash
if [[ "$*" == *"Local auditor"* ]]; then
  printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-grok-horn","model":"grok-4.7"}'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"w1","name":"Read","input":{"file_path":"x"}}]}}'
  printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: verified and corrected claim after auditor check\nLEFT: nothing","total_cost_usd":0.01,"num_turns":1,"session_id":"sess-grok-horn"}'
else
  printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-grok-horn","model":"grok-4.7"}'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"w1","name":"Read","input":{"file_path":"x"}}]}}'
  printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: made an unverified-claim about a file without checking\nLEFT: nothing","total_cost_usd":0.01,"num_turns":1,"session_id":"sess-grok-horn"}'
fi
""")
    os.chmod(grok_horn, 0o755)
    os.environ["ALEXUS_AUDITOR"] = str(horn_bin)
    os.environ["ALEXUS_GROK"] = str(grok_horn)
    gh_rid = "test-auditor"
    (ho_tmp / "agents" / gh_rid).mkdir(parents=True)
    save(ho_tmp / "agents" / gh_rid, {"id": gh_rid, "name": gh_rid, "task": "test auditor", "cwd": str(ho_tmp),
                           "who": "grok", "started_who": "grok", "handoff_chain": [], "handoffs": [],
                           "mode": "plain", "status": "starting", "started": now(), "ended": None,
                           "now": "", "plan": [], "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0,
                           "remark": "", "final": "", "cost_usd": None, "turns": None, "session": None, "pid": None})
    run(gh_rid)
    os.environ.pop("ALEXUS_AUDITOR", None)
    gh_st = load(ho_tmp / "agents" / gh_rid)
    check("local-auditor", gh_st["status"] == "done" and gh_st["hook_blocks"] == 1
          and "corrected claim after auditor" in gh_st["final"]
          and any(a.get("kind") == "hook" and "📯 [auditor]" in (a.get("what") or "") for a in gh_st["actions"]))

    # 6. Human helper intervention & resume:
    #    - Agent pauses with a question/context request in LEFT: ("Which port should I bind?") -> verdict="needs you", human_request set
    #    - Human answers via `alexus resume <id> "Use port 5433"` -> resumes session, passes answer, completes run
    grok_ask = bin_dir / "grok-ask"
    grok_ask.write_text(r"""#!/bin/bash
D="$ALEXUS_HOME/agents/$ALEXUS_RUN"
if [[ "$*" == *"--resume"* ]]; then
  printf '%s' "$*" > "$D/resume-args.txt"
  printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-grok-ask","model":"grok-4.7"}'
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t2","name":"todo_write","input":{"merge":true,"todos":[{"id":"1","status":"completed"},{"id":"2","status":"completed"}]}},{"type":"text","text":"DONE: bound service to port 5433 as requested\nLEFT: nothing"}]}}'
  printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: bound service to port 5433 as requested\nLEFT: nothing","total_cost_usd":0.02,"num_turns":1,"session_id":"sess-grok-ask"}'
else
  printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-grok-ask","model":"grok-4.7"}'
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"todo_write","input":{"merge":false,"todos":[{"id":"1","content":"inspect config","status":"completed"},{"id":"2","content":"bind port","status":"in_progress"}]}},{"type":"text","text":"DONE: inspected config\nLEFT: Which port should I bind (staging 5433 or prod 5432)?"}]}}'
  printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: inspected config\nLEFT: Which port should I bind (staging 5433 or prod 5432)?","total_cost_usd":0.01,"num_turns":1,"session_id":"sess-grok-ask"}'
fi
""")
    os.chmod(grok_ask, 0o755)
    os.environ["ALEXUS_GROK"] = str(grok_ask)
    hr_rid = "test-human-resume"
    (ho_tmp / "agents" / hr_rid).mkdir(parents=True)
    save(ho_tmp / "agents" / hr_rid, {"id": hr_rid, "name": hr_rid, "task": "configure service port", "cwd": str(ho_tmp),
                           "who": "grok", "started_who": "grok", "handoff_chain": ["claude"], "handoffs": [],
                           "mode": "plain", "status": "starting", "started": now(), "ended": None,
                           "now": "", "plan": [], "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0,
                           "remark": "", "final": "", "cost_usd": None, "turns": None, "session": None, "pid": None})
    run(hr_rid)
    hr_paused = load(ho_tmp / "agents" / hr_rid)
    check("human-request-detected", hr_paused["status"] == "done" and hr_paused["verdict"] == "needs you"
          and "Which port should I bind" in (hr_paused.get("human_request") or "")
          and len(hr_paused.get("handoffs") or []) == 0
          and hr_paused["plan"][1]["status"] == "left")
    resume_run([hr_rid, "Use staging port 5433"], spawn=False)
    run(hr_rid)
    hr_done = load(ho_tmp / "agents" / hr_rid)
    res_args = (ho_tmp / "agents" / hr_rid / "resume-args.txt").read_text() if (ho_tmp / "agents" / hr_rid / "resume-args.txt").exists() else ""
    check("human-resume-completed", hr_done["status"] == "done" and hr_done.get("verdict") is None
          and hr_done.get("human_request") is None
          and "port 5433" in (hr_done.get("final") or "")
          and "--resume sess-grok-ask" in res_args and "Use staging port 5433" in res_args
          and len(hr_done.get("human_replies") or []) == 1
          and hr_done["human_replies"][0]["reply"] == "Use staging port 5433"
          and all(s["status"] == "completed" for s in hr_done["plan"])
          and abs((hr_done.get("cost_usd") or 0) - 0.03) < 1e-6)

    # 7. Proved mode human check approval on resume (`verify: HUMAN` becomes ok=True -> verdict="proved")
    os.environ.update(ALEXUS_HOME=str(ptmp), ALEXUS_CLAUDE=str(fake))
    resume_run(["p-good", "--approve-human", "Looks great, approved"], spawn=False)
    run("p-good")
    ps_resumed = load(ptmp / "agents" / "p-good")
    check("human-resume-proved", ps_resumed["verdict"] == "proved" and ps_resumed["status"] == "done"
          and ps_resumed.get("human_request") is None
          and any(c["claim"] == "the result looks right" and c["ok"] is True for c in (ps_resumed.get("checks") or [])))

    codex_res_cmd = launch_cmd({"who": "codex", "task": "t", "cwd": "/tmp/proj", "model": "gpt-6.1-sol"},
                               prompt="human answer", resume="thread-123")
    check("codex-resume-flags", "resume" in codex_res_cmd
          and codex_res_cmd[codex_res_cmd.index("resume") + 1] == "thread-123"
          and codex_res_cmd[codex_res_cmd.index("resume") + 2] == "human answer")

    # 8. Multi-hop handoff context preservation (Leg 1 substantive -> Leg 2 short crash -> Leg 3 gets both)
    mh_prompt = build_handoff_prompt({
        "task": "build and wire parser",
        "cwd": str(ho_tmp),
        "plan": [{"step": "build parser", "status": "completed"}, {"step": "wire CLI", "status": "pending"}],
        "handoffs": [
            {"from": "claude", "to": "codex", "reason": "unfinished work left: wire CLI", "summary": "DONE: built parser in parser.py"},
            {"from": "codex", "to": "grok", "reason": "failed: quota exhausted", "summary": "quota exhausted"},
        ],
        "actions": [{"kind": "tool", "tool": "Write", "what": "parser.py", "result": "wrote 120 lines"}],
        "final": "quota exhausted",
        "last_good_final": "DONE: built parser in parser.py with full AST support\nLEFT: wire CLI",
    }, "codex", "failed: quota exhausted")
    check("multi-hop-handoff-context",
          "PRIOR HANDOFF CHAIN HISTORY:" in mh_prompt
          and "Leg 1 (claude -> codex)" in mh_prompt
          and "EARLIER SUBSTANTIVE PROVIDER OUTPUT:" in mh_prompt
          and "full AST support" in mh_prompt
          and "RECENT TOOL ACTIONS IN THIS RUN:" in mh_prompt
          and "[Write] parser.py" in mh_prompt)


    # "done" must mean something, on every runner.
    nw_tmp = Path(tempfile.mkdtemp(prefix="alexus-nowork-"))
    codex_empty = bin_dir / "codex-empty"
    codex_empty.write_text(r"""#!/bin/bash
printf '%s\n' '{"type":"thread.started","thread_id":"t-empty"}'
printf '%s\n' '{"type":"item.completed","item":{"id":"m","type":"agent_message","text":"{\"name\":\"fake_tool\"}"}}'
printf '%s\n' '{"type":"turn.completed"}'
""")
    os.chmod(codex_empty, 0o755)
    grok_works = bin_dir / "grok-works"
    grok_works.write_text(r"""#!/bin/bash
printf '%s\n' '{"type":"system","subtype":"init","session_id":"sess-w","model":"grok-4.7"}'
printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"w1","name":"Read","input":{"file_path":"x"}}]}}'
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: took over the job\nLEFT: nothing","num_turns":1,"session_id":"sess-w"}'
""")
    os.chmod(grok_works, 0o755)
    os.environ.update(ALEXUS_HOME=str(nw_tmp),
                      ALEXUS_CODEX=str(codex_empty), ALEXUS_GROK=str(grok_works))
    def nw_run(rid, who, chain, mode):
        (nw_tmp / "agents" / rid).mkdir(parents=True)
        save(nw_tmp / "agents" / rid, {"id": rid, "name": rid, "task": "make a change", "cwd": str(nw_tmp), "who": who,
                            "started_who": who, "handoff_chain": chain, "handoffs": [], "mode": mode,
                            "status": "starting", "started": now(), "ended": None, "now": "", "plan": [],
                            "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0, "remark": "", "final": "",
                            "cost_usd": None, "turns": None, "session": None, "pid": None})
        run(rid)
        return load(nw_tmp / "agents" / rid)
    e1 = nw_run("no-work-fails", "codex", [], "plain")
    check("no-work-is-not-done", e1["status"] == "failed" and "did no work" in e1["final"] and e1["tools"] == 0)
    e2 = nw_run("no-work-hands-off", "codex", ["grok"], "plain")
    check("no-work-hands-off", e2["status"] == "done" and e2["who"] == "grok"
          and "did no work" in e2["handoffs"][0]["reason"])
    pcmd = {w: " ".join(launch_cmd({"who": w, "task": "t", "cwd": "/tmp/proj", "_dir": "/tmp/run1", "id": "r",
                                    "mode": "proved"})) for w in ("claude", "grok", "muse", "codex")}
    check("proof-guide-every-runner", all("/tmp/run1/checklist.md" in c for c in pcmd.values())
          and "writable_roots" in pcmd["codex"] and "--add-dir" not in pcmd["grok"])
    mt = {"actions": [], "plan": [], "tools": 0, "errors": 0, "now": ""}
    apply_muse_event(mt, {"payload_type": "tool.result", "payload": {"kind": "tool_result", "command_id": "c1"}}, {}, {})
    check("muse-tool-result-counts", mt["tools"] == 1)
    os.environ.pop("ALEXUS_CRITICS", None)
    ccmd = launch_cmd({"who": "codex", "task": "t", "cwd": "/tmp/proj", "mode": "proved"}, prompt="p",
                      guide=CRITIC_GUIDE, tools=CRITIC_TOOLS)
    check("critic-read-only", "--sandbox" in ccmd and "read-only" in ccmd and "--approve-for-me" not in ccmd
          and critic_order("grok") == ["claude", "codex", "grok"]
          and critic_order("claude") == ["codex", "grok", "claude"])
    ct = Path(tempfile.mkdtemp(prefix="alexus-critic-copy-"))
    (ct / "src").mkdir(); (ct / "src" / "a.txt").write_text("real")
    cc = critic_copy(str(ct / "src"), ct)
    if cc:
        Path(cc, "a.txt").write_text("changed by a critic")
    check("critic-copy-protects-work", bool(cc) and (ct / "src" / "a.txt").read_text() == "real")
    gc = " ".join(launch_cmd({"who": "grok", "task": "t", "cwd": "/tmp/copy"}, prompt="p", guide=CRITIC_GUIDE))
    check("every-critic-gets-its-guide", "--cwd /tmp/copy" in gc and "critic in a proved run" in gc)

    # the domain: proofs labelled and all required; walls parsed, enforced before the move, backstopped after
    dom = load_domain({"outcome": "one post", "proof": ["shows on profile", "- [ ] saved :: verify: test -s r.txt"],
                       "walls": ["no-network", "app-only: Safari", "once: aria-label=..Post", "deny: rm -rf",
                                 "write-only: out", "no-tool: WebSearch", "no second click"]})
    check("domain-labels", [p["label"] for p in dom["proof"]] == ["P1", "P2"] and dom["proof"][1]["checked"]
          and not dom["proof"][0]["checked"] and domain_seed(dom) == "- [ ] P2: saved :: verify: test -s r.txt\n")
    check("domain-walls-parsed", [w["kind"] for w in dom["walls"]] == ["no-network", "app-only", "once", "deny",
                                                                        "write-only", "no-tool", "text"]
          and not dom["walls"][-1]["enforced"])
    try:
        load_domain({"outcome": "x", "proof": []})
        check("domain-needs-proof", False)
    except ValueError:
        check("domain-needs-proof", True)
    wall_home = Path(tempfile.mkdtemp(prefix="alexus-walls-"))
    os.environ["ALEXUS_HOME"] = str(wall_home)
    wd = wall_home / "agents" / "wallrun"
    wd.mkdir(parents=True)
    wst = {"_dir": str(wd), "cwd": str(wd), "who": "claude", "domain": dom}
    items = parse_checklist("- [ ] P2: saved :: verify: true\n")
    check("proof-coverage", [p["label"] for p in missing_proofs(wst, items)] == ["P1"]
          and not missing_proofs(wst, items + parse_checklist("- [ ] P1: on profile :: verify: HUMAN\n")))
    dec = lambda n, i: (wall_decision(wst, n, i) or ({"text": ""}, ""))[0]["text"]
    check("wall-app-only", dec("Bash", {"command": "osascript -e 'tell application \"Messages\" to activate'"}) == "app-only: Safari"
          and dec("Bash", {"command": "osascript -e 'tell application \"Safari\" to do JavaScript \"1\" in document 1'"}) == ""
          and dec("Bash", {"command": "osascript -e 'tell application \"System Events\" to tell process \"Mail\" to click'"}) == "app-only: Safari"
          and dec("Bash", {"command": "open -a TextEdit x"}) == "app-only: Safari")
    check("wall-deny-tool-network", dec("Bash", {"command": "rm -rf /x"}) == "deny: rm -rf"
          and dec("WebSearch", {"query": "q"}) == "no-network"
          and dec("mcp__x__y", {}) == "no-network")
    check("wall-write-only", dec("Write", {"file_path": str(wd / "out" / "a")}) == ""
          and dec("Write", {"file_path": str(wd / "checklist.md")}) == ""
          and dec("Write", {"file_path": "/Users/x/y"}) == "write-only: out")
    post = {"command": "osascript -e 'click [aria-label=\"Post\"]'"}
    check("checklist-shell-write-refused", "Write tool" in str(wall_decision(wst, "Bash", {"command": f"cat >> {wd}/checklist.md <<'E'\nx\nE"}))
          and wall_decision(wst, "Bash", {"command": f"cat {wd}/checklist.md 2>&1"}) is None)
    check("once-not-spent-on-refused", dec("Bash", {"command": "rm -rf x; click aria-label=\"Post\""}) == "deny: rm -rf"
          and not (wd / "once-2.used").exists())
    check("wall-once", dec("Write", {"file_path": str(wd / "checklist.md"), "content": "aria-label=\"Post\" rm -rf"}) == ""
          and dec("Bash", post) == "" and dec("Bash", post) == "once: aria-label=..Post")
    prof = walls_sandbox(wst) or ""
    check("wall-sandbox", "(deny network-outbound (remote ip))" in prof and '(deny file-write* (subpath "/"))' in prof
          and json.dumps(os.path.realpath(str(wd / "out"))) in prof)
    env = prepare_walls(wd, wst)
    check("wall-files", (wd / "walls-settings.json").exists() and "wall-hook" in (wd / "walls-settings.json").read_text()
          and env.get("CLAUDE_CODE_SHELL_PREFIX", "").endswith("walls-shell.sh"))
    wcmd = launch_cmd(dict(wst, task="t", mode="proved"))
    ccmd = launch_cmd(dict(wst, task="t", mode="proved"), guide="critic", tools="Read")
    check("walls-only-on-agent-legs", "--settings" in wcmd and "--settings" not in ccmd
          and "THE DOMAIN OF THIS TASK" in wcmd[wcmd.index("--append-system-prompt") + 1])
    seen = {}
    use = {"type": "assistant", "message": {"content": [{"type": "tool_use", "id": "u1", "name": "Bash",
                                                          "input": {"command": "open -a Mail"}}]}}
    res = {"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": "u1", "is_error": False}]}}
    check("wall-backstop", wall_backstop(wst, use, seen) is None and "app-only" in (wall_backstop(wst, res, seen) or ""))
    bk = {}
    for n, (tool, inp) in enumerate([("Write", {"file_path": str(wd / "checklist.md"), "content": "click aria-label=\"Post\""}),
                                     ("TaskCreate", {"subject": "rm -rf and click aria-label=\"Post\""}),
                                     ("Bash", {"command": "click aria-label=\"Post\""})]):
        wall_backstop(wst, {"type": "assistant", "message": {"content": [{"type": "tool_use", "id": f"b{n}", "name": tool, "input": inp}]}}, bk)
        r = wall_backstop(wst, {"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": f"b{n}"}]}}, bk)
    check("deny-judges-moves-not-documents",
          dec("Write", {"file_path": str(wd / "README.md"), "content": "then run: rm -rf build"}) == ""
          and dec("Bash", {"command": "rm -rf build"}) == "deny: rm -rf")
    cd = Path(tempfile.mkdtemp(prefix="alexus-color-"))
    colour = run_checks(cd, str(cd), parse_checklist("- [ ] colour :: verify: printf '\\033[32m Tests  20 passed\\033[0m' :: expect: Tests\\s+\\d+ passed\n"
                                                    "- [ ] nocolor :: verify: test \"$NO_COLOR\" = 1 && test -z \"$FORCE_COLOR\"\n"))
    shutil.rmtree(cd, ignore_errors=True)
    check("checks-strip-colour", all(c["ok"] for c in colour))
    check("bookkeeping-not-a-move", r is None and wall_decision(wst, "TaskCreate", {"subject": "rm -rf"}) is None)
    (wd / "state.json").write_text(json.dumps({k: v for k, v in wst.items() if not k.startswith("_")}))
    hk = subprocess.run([sys.executable, "-I", os.path.abspath(__file__), "wall-hook", str(wd)], capture_output=True,
                        text=True, input=json.dumps({"tool_name": "Bash", "tool_input": {"command": "open -a Mail"}}))
    hk2 = subprocess.run([sys.executable, "-I", os.path.abspath(__file__), "wall-hook", str(wd)], capture_output=True,
                         text=True, input=json.dumps({"tool_name": "Bash", "tool_input": {"command": "ls"}}))
    check("wall-hook-blocks", hk.returncode == 2 and "app-only: Safari" in hk.stderr and hk2.returncode == 0
          and (wd / "walls.log").exists())
    shutil.rmtree(wd, ignore_errors=True)

    # A stop sticks: the provider dying is not a failure, a handoff already being decided does not
    # commit, and a checklist or critic round does not start. Help and a dash-led task start nothing.
    script = os.path.abspath(__file__)
    py = sys.executable
    bin_stop = Path(tempfile.mkdtemp(prefix="alexus-stopbug-"))

    def write_bin(name, body):
        p = bin_stop / name
        p.write_text(body)
        os.chmod(p, 0o755)
        return p

    success_stream = (
        '{"type":"system","subtype":"init","session_id":"sess-ok","model":"fake"}\n'
        '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"x"}}]}}\n'
        '{"type":"result","is_error":false,"result":"DONE: accepted a dash task\\nLEFT: nothing","total_cost_usd":0.01,"num_turns":1,"session_id":"sess-ok"}\n'
    )
    other = write_bin("other", "#!/usr/bin/env python3\n"
                      "import os, sys\n"
                      "root = os.environ.get('ALEXUS_HOME', '')\n"
                      "run = os.environ.get('ALEXUS_RUN', '')\n"
                      "d = os.path.join(root, 'agents', run)\n"
                      "os.makedirs(d, exist_ok=True)\n"
                      "open(os.path.join(d, 'other-started'), 'w').close()\n"
                      "sys.stdout.write(" + repr(success_stream) + ")\n"
                      "sys.stdout.flush()\n")
    claude_marker = write_bin("claude-marker", "#!/usr/bin/env python3\n"
                               "import os, sys\n"
                               "root = os.environ.get('ALEXUS_HOME', '')\n"
                               "run = os.environ.get('ALEXUS_RUN', '')\n"
                               "d = os.path.join(root, 'agents', run)\n"
                               "os.makedirs(d, exist_ok=True)\n"
                               "open(os.path.join(d, 'claude-started'), 'w').close()\n"
                               "sys.stdout.write(" + repr(success_stream) + ")\n"
                               "sys.stdout.flush()\n")
    claude_ok = write_bin("claude-ok", "#!/usr/bin/env python3\n"
                          "import os, sys\n"
                          "root = os.environ.get('ALEXUS_HOME', '')\n"
                          "open(os.path.join(root, 'cli-invoked'), 'a').write(' '.join(sys.argv) + '\\n')\n"
                          "sys.stdout.write(" + repr(success_stream) + ")\n"
                          "sys.stdout.flush()\n")
    grok_fail = write_bin("grok-fail", "#!/usr/bin/env python3\n"
                          "import sys\n"
                          "sys.stdout.write('{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"sess-fail\",\"model\":\"grok\"}\\n')\n"
                          "sys.stdout.write('{\"type\":\"result\",\"is_error\":true,\"result\":\"boom from the provider\"}\\n')\n"
                          "sys.stdout.flush()\n"
                          "sys.exit(1)\n")
    # 0.8s is past leg()'s 0.5s save throttle, so the error line would be saved if a stop were a failure.
    grok_term = write_bin("grok-term", r"""#!/usr/bin/env python3
import os, signal, sys, time
root = os.environ["ALEXUS_HOME"]
d = os.path.join(root, "agents", os.environ["ALEXUS_RUN"])
os.makedirs(d, exist_ok=True)
hit = {"v": False}
def on_term(sig, frame):
    hit["v"] = True
signal.signal(signal.SIGTERM, on_term)
def emit(s):
    sys.stdout.write(s + "\n")
    sys.stdout.flush()
emit('{"type":"system","subtype":"init","session_id":"sess-term","model":"grok"}')
open(os.path.join(d, "provider-up"), "w").close()
while not hit["v"]:
    time.sleep(0.05)
time.sleep(0.8)
emit('{"type":"result","is_error":true,"result":"killed by stop"}')
time.sleep(0.4)
sys.exit(1)
""")
    grok_sleep = write_bin("grok-sleep", r"""#!/usr/bin/env python3
import os, sys, time
root = os.environ["ALEXUS_HOME"]
d = os.path.join(root, "agents", os.environ["ALEXUS_RUN"])
os.makedirs(d, exist_ok=True)
sys.stdout.write('{"type":"system","subtype":"init","session_id":"sess-sleep","model":"grok"}\n')
sys.stdout.flush()
open(os.path.join(d, "provider-up"), "w").close()
while True:
    time.sleep(0.2)
""")
    grok_ign = write_bin("grok-ign", r"""#!/usr/bin/env python3
import os, signal, sys, time
signal.signal(signal.SIGTERM, signal.SIG_IGN)
root = os.environ["ALEXUS_HOME"]
d = os.path.join(root, "agents", os.environ["ALEXUS_RUN"])
os.makedirs(d, exist_ok=True)
open(os.path.join(d, "provider.pid"), "w").write(str(os.getpid()))
sys.stdout.write('{"type":"system","subtype":"init","session_id":"sess-ign","model":"grok"}\n')
sys.stdout.flush()
open(os.path.join(d, "provider-up"), "w").close()
while True:
    time.sleep(0.2)
""")
    grok_resume = write_bin("grok-resume", r"""#!/usr/bin/env python3
import os, signal, sys, time
root = os.environ["ALEXUS_HOME"]
d = os.path.join(root, "agents", os.environ["ALEXUS_RUN"])
os.makedirs(d, exist_ok=True)
open(os.path.join(d, "argv.txt"), "w").write("\n".join(sys.argv))
if "ANSWER-RESUME" in " ".join(sys.argv):
    sys.stdout.write('{"type":"system","subtype":"init","session_id":"sess-resume","model":"grok"}\n')
    sys.stdout.write('{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"x"}}]}}\n')
    sys.stdout.write('{"type":"result","is_error":false,"result":"DONE: resumed after the stop\\nLEFT: nothing","total_cost_usd":0.01,"num_turns":1,"session_id":"sess-resume"}\n')
    sys.stdout.flush()
    sys.exit(0)
hit = {"v": False}
def on_term(sig, frame):
    hit["v"] = True
signal.signal(signal.SIGTERM, on_term)
sys.stdout.write('{"type":"system","subtype":"init","session_id":"sess-live","model":"grok"}\n')
sys.stdout.flush()
open(os.path.join(d, "provider-up"), "w").close()
while not hit["v"]:
    time.sleep(0.05)
sys.exit(1)
""")
    claude_prove = write_bin("claude-prove", r"""#!/usr/bin/env python3
import os, sys
root = os.environ.get("ALEXUS_HOME", "")
run = os.environ.get("ALEXUS_RUN", "")
d = os.path.join(root, 'agents', run)
os.makedirs(d, exist_ok=True)
args = " ".join(sys.argv)
if "critic in a proved" in args:
    open(os.path.join(d, "critic-started"), "w").close()
    sys.stdout.write('{"type":"result","is_error":false,"result":"VERDICT: pass"}\n')
    sys.stdout.flush()
    sys.exit(0)
open(os.path.join(d, "checklist.md"), "w").write("- [ ] marker :: verify: true\n")
sys.stdout.write('{"type":"system","subtype":"init","session_id":"sess-prove","model":"opus"}\n')
sys.stdout.write('{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"x"}}]}}\n')
sys.stdout.write('{"type":"result","is_error":false,"result":"DONE: wrote the marker\\nLEFT: nothing","total_cost_usd":0.01,"num_turns":1,"session_id":"sess-prove"}\n')
sys.stdout.flush()
""")
    grok_touch = write_bin("grok-touch", "#!/usr/bin/env python3\n"
                           "import os, sys\n"
                           "root = os.environ.get('ALEXUS_HOME', '')\n"
                           "run = os.environ.get('ALEXUS_RUN', '')\n"
                           "d = os.path.join(root, 'agents', run)\n"
                           "os.makedirs(d, exist_ok=True)\n"
                           "open(os.path.join(d, 'grok-started'), 'w').close()\n"
                           "sys.stdout.write(" + repr(success_stream) + ")\n"
                           "sys.stdout.flush()\n")

    def arm(tmp, grok, claude, extra=None):
        os.environ["ALEXUS_HOME"] = str(tmp)
        write_config({"owner": "Ada", "clis": ["claude", "grok", "codex"],
                      "default_who": "claude", "handoff": ["grok", "codex"]})
        os.environ["ALEXUS_CRITICS"] = "claude"
        os.environ["ALEXUS_GROK"] = str(grok)
        os.environ["ALEXUS_CLAUDE"] = str(claude)
        os.environ["ALEXUS_CODEX"] = str(other)
        os.environ["ALEXUS_MUSE"] = str(other)
        for k in ("ALEXUS_AUDITOR", "ALEXUS_AFTER_LEG", "ALEXUS_BEFORE_PROVE"):
            os.environ.pop(k, None)
        if extra:
            os.environ.update(extra)
        return os.environ.copy()

    def seed(tmp, rid, who, chain, mode="plain"):
        d = tmp / "agents" / rid
        d.mkdir(parents=True)
        save(d, {"id": rid, "name": rid, "task": "stop must stick", "cwd": str(tmp),
                 "who": who, "started_who": who, "handoff_chain": list(chain), "handoffs": [],
                 "mode": mode, "gen": 0, "status": "starting", "started": now(), "ended": None,
                 "now": "", "plan": [], "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0,
                 "remark": "", "final": "", "cost_usd": None, "turns": None, "session": None, "pid": None})
        return d

    def reap(rid, d=None):
        if d is not None:
            st = load(d) or {}
            if st.get("pid"):
                _killpg(st["pid"], signal.SIGKILL)
        try:
            subprocess.run(["pkill", "-f", script + " run " + rid],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        except Exception:
            pass

    def spawn_worker(env, rid, tmp):
        log = open(tmp / (rid + ".worker-log"), "w")
        proc = subprocess.Popen([py, "-B", "-I", script, "run", rid], env=env, stdout=log, stderr=log)
        return proc, log

    def wait_file(path, timeout=10):
        end = time.time() + timeout
        while time.time() < end:
            if path.exists():
                return True
            time.sleep(0.05)
        return False

    def wait_running(d, timeout=10):
        end = time.time() + timeout
        while time.time() < end:
            st = load(d) or {}
            if st.get("status") == "running" and st.get("pid") and (d / "provider-up").exists():
                return st
            time.sleep(0.05)
        return None

    def wait_status(d, done, timeout=20):
        end = time.time() + timeout
        last = None
        while time.time() < end:
            last = load(d)
            if last and done(last):
                return last
            time.sleep(0.05)
        return last

    def hook_script(tmp, name, args):
        p = tmp / name
        p.write_text("#!/bin/bash\nexec " + shlex.quote(py) + " -I " + shlex.quote(script)
                     + " " + " ".join(shlex.quote(a) for a in args) + ' "$1"\n')
        os.chmod(p, 0o755)
        return p

    def stopped_clean(d, who):
        st = load(d) or {}
        now_s = st.get("now") or ""
        return (st.get("status") == "stopped" and st.get("who") == who
                and not st.get("handoffs") and "stopped" in now_s and "fail" not in now_s.lower()
                and not (d / "claude-started").exists() and not (d / "other-started").exists()
                and (d / "STOP").exists())

    def worker_cannot_revive(d):
        before = (d / "state.json").read_text()
        disk = load(d)
        gen = int(disk.get("gen") or 0)
        stale = dict(disk)
        stale["_worker_gen"] = gen - 1
        stale["status"] = "running"
        stale["who"] = "claude"
        if save(d, stale) is not False or (d / "state.json").read_text() != before:
            return False
        cur = dict(load(d))
        cur["_worker_gen"] = gen
        cur["status"] = "running"
        if save(d, cur) is not False or (d / "state.json").read_text() != before:
            return False
        auth = dict(load(d))
        auth["status"] = "running"
        if save(d, auth) is not True or (load(d) or {}).get("status") != "stopped":
            return False
        return True

    def live_stop(kind, grok_bin, force):
        tmp = Path(tempfile.mkdtemp(prefix="alexus-live-"))
        rid = "live-" + kind
        d = seed(tmp, rid, "grok", ["claude"])
        env = arm(tmp, grok_bin, claude_marker)
        proc, log = spawn_worker(env, rid, tmp)
        try:
            if not wait_running(d):
                return False
            cmd = [py, "-I", script, "stop", rid]
            if force:
                cmd.insert(4, "--force")
            r = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=15)
            if r.returncode != 0:
                return False
            try:
                proc.wait(timeout=20)
            except subprocess.TimeoutExpired:
                return False
            time.sleep(2)
            return stopped_clean(d, "grok") and (not force or "force" in (load(d).get("now") or ""))
        finally:
            log.close()
            if proc.poll() is None:
                proc.kill()
                proc.wait(timeout=5)
            reap(rid, d)

    def decision_stop(force):
        tmp = Path(tempfile.mkdtemp(prefix="alexus-decide-"))
        rid = "decide-" + ("force" if force else "term")
        d = seed(tmp, rid, "grok", ["claude"])
        hook = hook_script(tmp, "after", ["stop", "--force"] if force else ["stop"])
        arm(tmp, grok_fail, claude_marker, {"ALEXUS_AFTER_LEG": str(hook)})
        try:
            run(rid)
            st = load(d) or {}
            now_s = st.get("now") or ""
            return (st.get("status") == "stopped" and st.get("who") == "grok" and not st.get("handoffs")
                    and not (d / "claude-started").exists() and "stopped" in now_s
                    and (not force or "force" in now_s))
        finally:
            os.environ.pop("ALEXUS_AFTER_LEG", None)
            reap(rid, d)

    def case_stop_nonzero():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-term-"))
        rid = "term-nonzero"
        d = seed(tmp, rid, "grok", ["claude"])
        env = arm(tmp, grok_term, claude_marker)
        proc, log = spawn_worker(env, rid, tmp)
        try:
            if not wait_running(d):
                sys.stderr.write("stop-nonzero: provider never reached running\n")
                return False
            r = subprocess.run([py, "-I", script, "stop", rid], env=env, capture_output=True, text=True, timeout=15)
            if r.returncode != 0:
                sys.stderr.write("stop-nonzero: stop exit %s %s\n" % (r.returncode, r.stderr))
                return False
            try:
                proc.wait(timeout=20)
            except subprocess.TimeoutExpired:
                sys.stderr.write("stop-nonzero: worker still running\n")
                return False
            time.sleep(2)
            if not stopped_clean(d, "grok") or not worker_cannot_revive(d):
                sys.stderr.write("stop-nonzero: %s\n" % (load(d),))
                return False
            return True
        finally:
            log.close()
            if proc.poll() is None:
                proc.kill()
                proc.wait(timeout=5)
            reap(rid, d)

    def case_force():
        decided = decision_stop(True)
        lived = live_stop("force", grok_sleep, True)
        if not (decided and lived):
            sys.stderr.write("force-stop: decision %s live %s\n" % (decided, lived))
        return decided and lived

    def case_during():
        ok_d = decision_stop(False)
        if not ok_d:
            sys.stderr.write("during-handoff: %s\n" % "not stopped")
        return ok_d

    def case_prove():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-prove-stop-"))
        rid = "prove-stop"
        d = seed(tmp, rid, "claude", ["grok"], mode="proved")
        hook = hook_script(tmp, "before", ["stop"])
        arm(tmp, grok_touch, claude_prove, {"ALEXUS_BEFORE_PROVE": str(hook)})
        try:
            run(rid)
            st = load(d) or {}
            good = (st.get("status") == "stopped" and st.get("who") == "claude" and not st.get("checks")
                    and not st.get("handoffs") and not (d / "critic-started").exists()
                    and not (d / "grok-started").exists() and "stopped" in (st.get("now") or ""))
            if not good:
                sys.stderr.write("stop-skips-prove: %s critic %s grok %s\n" % (
                    {k: st.get(k) for k in ("status", "who", "now", "checks", "handoffs", "final")},
                    (d / "critic-started").exists(), (d / "grok-started").exists()))
            return good
        finally:
            os.environ.pop("ALEXUS_BEFORE_PROVE", None)
            reap(rid, d)

    def case_resume():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-resume-stop-"))
        rid = "resume-stop"
        d = seed(tmp, rid, "grok", ["claude"])
        env = arm(tmp, grok_resume, claude_marker)
        proc, log = spawn_worker(env, rid, tmp)
        try:
            if not wait_running(d):
                sys.stderr.write("resume-after-stop: never running\n")
                return False
            r = subprocess.run([py, "-I", script, "stop", rid], env=env, capture_output=True, text=True, timeout=15)
            if r.returncode != 0:
                return False
            try:
                proc.wait(timeout=20)
            except subprocess.TimeoutExpired:
                return False
            if (load(d) or {}).get("status") != "stopped" or not (d / "STOP").exists():
                return False
            r2 = subprocess.run([py, "-I", script, "resume", rid, "ANSWER-RESUME"], env=env,
                                capture_output=True, text=True, timeout=20)
            if r2.returncode != 0:
                sys.stderr.write("resume-after-stop: resume %s %s\n" % (r2.returncode, r2.stderr))
                return False
            st = wait_status(d, lambda s: s.get("status") in ("done", "failed", "stopped") and s.get("ended"), timeout=20)
            if not st or st.get("status") != "done" or "resumed after the stop" not in (st.get("final") or ""):
                sys.stderr.write("resume-after-stop: %s\n" % (st,))
                return False
            return (not (d / "STOP").exists() and st.get("id") == rid and not st.get("handed_off_to")
                    and st.get("who") == "grok" and not st.get("handoffs"))
        finally:
            log.close()
            if proc.poll() is None:
                proc.kill()
                proc.wait(timeout=5)
            reap(rid, d)

    def case_handoff():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-handoff-stop-"))
        rid = "handoff-stop"
        d = seed(tmp, rid, "grok", ["claude"])
        env = arm(tmp, grok_resume, claude_ok)
        proc, log = spawn_worker(env, rid, tmp)
        r2 = None
        try:
            if not wait_running(d):
                sys.stderr.write("handoff-after-stop: never running\n")
                return False
            r = subprocess.run([py, "-I", script, "stop", rid], env=env, capture_output=True, text=True, timeout=15)
            if r.returncode != 0:
                return False
            try:
                proc.wait(timeout=20)
            except subprocess.TimeoutExpired:
                return False
            r2 = subprocess.run([py, "-I", script, "handoff", rid, "--who", "claude", "--no-handoff", "note"],
                                env=env, capture_output=True, text=True, timeout=20)
            if r2.returncode != 0:
                sys.stderr.write("handoff-after-stop: %s %s\n" % (r2.returncode, r2.stderr))
                return False
            new_id = (r2.stdout or "").strip().splitlines()[-1]
            nd = tmp / "agents" / new_id
            old = load(d) or {}
            if old.get("status") != "stopped" or not (d / "STOP").exists() or old.get("handed_off_to") != new_id:
                sys.stderr.write("handoff-after-stop old: %s\n" % (old,))
                return False
            if (nd / "STOP").exists():
                return False
            st = wait_status(nd, lambda s: s.get("status") in ("done", "failed", "stopped") and s.get("ended"), timeout=20)
            if not st or st.get("status") != "done" or st.get("handoff_from") != rid or st.get("who") != "claude":
                sys.stderr.write("handoff-after-stop new: %s\n" % (st,))
                return False
            again = load(d) or {}
            return again.get("status") == "stopped" and (d / "STOP").exists()
        finally:
            log.close()
            if proc.poll() is None:
                proc.kill()
                proc.wait(timeout=5)
            reap(rid, d)
            new_id = ""
            if r2 is not None and r2.returncode == 0:
                lines = (r2.stdout or "").strip().splitlines()
                if lines and re.fullmatch(r"[0-9]{8}-[0-9]{6}-[0-9a-f]{6}", lines[-1]):
                    new_id = lines[-1]
            if new_id:
                reap(new_id, tmp / "agents" / new_id)

    def case_help():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-help-"))
        work = tmp / "work"
        work.mkdir()
        env = arm(tmp, claude_ok, claude_ok)
        argv_sets = [
            ["--help"], ["-h"], ["help"],
            ["start", "--help"], ["start", "-h"], ["start", "--cwd", str(work), "--help"],
            ["resume", "--help"], ["handoff", "-h"], ["stop", "--help"], ["list", "--help"],
        ]
        for args in argv_sets:
            r = subprocess.run([py, "-I", script, *args], cwd=str(work), env=env,
                               capture_output=True, text=True, timeout=15)
            if r.returncode != 0 or "alexus" not in (r.stdout or ""):
                sys.stderr.write("start-help: %s rc %s\n" % (args, r.returncode))
                return False
            if (tmp / "cli-invoked").exists() or any((tmp / "agents").glob("*/state.json")):
                sys.stderr.write("start-help: started a run for %s\n" % (args,))
                return False
        return True

    def case_dash_refused():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-dash-"))
        work = tmp / "work"
        work.mkdir()
        env = arm(tmp, claude_ok, claude_ok)
        argv_sets = [
            ["start", "--weird"],
            ["start", "-weird"],
            ["start", "--plain", "-x", "--", "real task"],
        ]
        for args in argv_sets:
            r = subprocess.run([py, "-I", script, *args], cwd=str(work), env=env,
                               capture_output=True, text=True, timeout=15)
            text = (r.stdout or "") + (r.stderr or "")
            if r.returncode == 0 or "dash" not in text or "--" not in text:
                sys.stderr.write("dash-refused: %s rc %s %s\n" % (args, r.returncode, text))
                return False
            if (tmp / "cli-invoked").exists() or any((tmp / "agents").glob("*/state.json")):
                sys.stderr.write("dash-refused: started a run for %s\n" % (args,))
                return False
        return True

    def case_dash_ok():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-ddash-"))
        work = tmp / "work"
        work.mkdir()
        env = arm(tmp, claude_ok, claude_ok)
        got = {}
        for args, expect in (
            (["start", "--no-plan", "--plain", "--no-handoff", "--", "--help"], "--help"),
            (["start", "--no-plan", "--plain", "--no-handoff", "--", "-leading", "task"], "-leading task"),
        ):
            r = subprocess.run([py, "-I", script, *args], cwd=str(work), env=env,
                               capture_output=True, text=True, timeout=20)
            if r.returncode != 0:
                sys.stderr.write("dash-ok: %s %s\n" % (r.returncode, r.stderr))
                return False
            rid = (r.stdout or "").strip().splitlines()[-1]
            d = tmp / "agents" / rid
            if not (d / "task.txt").exists() or (d / "task.txt").read_text() != expect:
                sys.stderr.write("dash-ok task: %s\n" % (rid,))
                return False
            st = wait_status(d, lambda s: s.get("ended"), timeout=20)
            got[expect] = st
            if not st or st.get("status") != "done":
                sys.stderr.write("dash-ok state: %s\n" % (st,))
                reap(rid, d)
                return False
            reap(rid, d)
        return (tmp / "cli-invoked").exists() and got["--help"]["status"] == "done" and got["-leading task"]["status"] == "done"

    def alive(pid):
        try:
            os.kill(int(pid), 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
        return True

    def case_force_ignorer():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-ign-"))
        rid = "ign-term"
        d = seed(tmp, rid, "grok", ["claude"])
        env = arm(tmp, grok_ign, claude_marker)
        proc, log = spawn_worker(env, rid, tmp)
        provider = None
        try:
            st = wait_running(d)
            if not st or not (d / "provider.pid").exists():
                sys.stderr.write("ign: never running\n")
                return False
            provider = int((d / "provider.pid").read_text().strip())
            if provider != int(st.get("pid") or 0):
                sys.stderr.write("ign: pid %s state %s\n" % (provider, st.get("pid")))
                return False
            r = subprocess.run([py, "-I", script, "stop", rid], env=env, capture_output=True, text=True, timeout=15)
            if r.returncode != 0:
                sys.stderr.write("ign: stop %s %s\n" % (r.returncode, r.stderr))
                return False
            time.sleep(0.4)
            mid = load(d) or {}
            if mid.get("status") != "stopped" or mid.get("pid") is not None or not alive(provider):
                sys.stderr.write("ign after stop: %s alive %s\n" % (mid.get("status"), alive(provider)))
                return False
            if int(mid.get("stop_pid") or 0) != provider:
                sys.stderr.write("ign: remembered %s lstart %s\n" % (mid.get("stop_pid"), mid.get("stop_lstart")))
                return False
            r2 = subprocess.run([py, "-I", script, "stop", "--force", rid], env=env,
                                capture_output=True, text=True, timeout=15)
            if r2.returncode != 0:
                sys.stderr.write("ign: force %s %s\n" % (r2.returncode, r2.stderr))
                return False
            try:
                proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                sys.stderr.write("ign: worker still blocked after force\n")
                return False
            if alive(provider):
                sys.stderr.write("ign: provider %s still alive\n" % provider)
                return False
            end = load(d) or {}
            return (end.get("status") == "stopped" and end.get("who") == "grok" and not end.get("handoffs")
                    and "force" in (end.get("now") or "") and not (d / "claude-started").exists())
        finally:
            log.close()
            if proc.poll() is None:
                proc.kill()
                proc.wait(timeout=5)
            if provider and alive(provider):
                _killpg(provider, signal.SIGKILL)
            reap(rid, d)

    def _no_run(tmp):
        return not (tmp / "cli-invoked").exists() and not any((tmp / "agents").glob("*/state.json"))

    def case_stdin_dash():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-stdin-"))
        work = tmp / "work"
        work.mkdir()
        env = arm(tmp, claude_ok, claude_ok)
        for payload in ("--help", " --help", "\n--help"):
            r = subprocess.run([py, "-I", script, "start", "--no-plan", "--plain", "--no-handoff", "--cwd", str(work), "-"],
                               cwd=str(work), env=env, input=payload, capture_output=True, text=True, timeout=15)
            text = (r.stdout or "") + (r.stderr or "")
            if r.returncode == 0 or "dash" not in text or "--" not in text or not _no_run(tmp):
                sys.stderr.write("stdin-dash: %r rc %s %s\n" % (payload, r.returncode, text))
                return False
        r = subprocess.run([py, "-I", script, "start", "--no-plan", "--plain", "--no-handoff", "--cwd", str(work), "-"],
                           cwd=str(work), env=env, input="build the widget", capture_output=True, text=True, timeout=20)
        if r.returncode != 0:
            sys.stderr.write("stdin-ok: %s %s\n" % (r.returncode, r.stderr))
            return False
        rid = (r.stdout or "").strip().splitlines()[-1]
        d = tmp / "agents" / rid
        if not (d / "task.txt").exists() or (d / "task.txt").read_text() != "build the widget":
            sys.stderr.write("stdin-ok task: %s\n" % (list(tmp.glob("*/task.txt")),))
            return False
        st = wait_status(d, lambda s: s.get("ended"), timeout=20)
        reap(rid, d)
        if not st or st.get("status") != "done":
            sys.stderr.write("stdin-ok state: %s\n" % (st,))
            return False
        return True

    def case_spaced_dash():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-space-"))
        work = tmp / "work"
        work.mkdir()
        env = arm(tmp, claude_ok, claude_ok)
        r = subprocess.run([py, "-I", script, "start", "--plain", "--no-handoff", "--cwd", str(work), " --help"],
                           cwd=str(work), env=env, capture_output=True, text=True, timeout=15)
        text = (r.stdout or "") + (r.stderr or "")
        if r.returncode == 0 or "dash" not in text or "--" not in text or not _no_run(tmp):
            sys.stderr.write("spaced-dash: rc %s %s\n" % (r.returncode, text))
            return False
        r = subprocess.run([py, "-I", script, "start", "--no-plan", "--plain", "--no-handoff", "--cwd", str(work), "--", " --help"],
                           cwd=str(work), env=env, capture_output=True, text=True, timeout=20)
        if r.returncode != 0:
            sys.stderr.write("spaced-ok: %s %s\n" % (r.returncode, r.stderr))
            return False
        rid = (r.stdout or "").strip().splitlines()[-1]
        d = tmp / "agents" / rid
        if not (d / "task.txt").exists() or (d / "task.txt").read_text() != "--help":
            sys.stderr.write("spaced-ok task\n")
            return False
        st = wait_status(d, lambda s: s.get("ended"), timeout=20)
        reap(rid, d)
        return bool(st and st.get("status") == "done" and (tmp / "cli-invoked").exists())


    def _setup_env(bindir, arh, home):
        env = os.environ.copy()
        env["HOME"] = str(home)
        env["ALEXUS_HOME"] = str(arh)
        env["PYTHONDONTWRITEBYTECODE"] = "1"
        env["PATH"] = str(bindir) + os.pathsep + "/usr/bin" + os.pathsep + "/bin"
        for k in list(env):
            if k.startswith("ALEXUS_") and k != "ALEXUS_HOME":
                env.pop(k, None)
        return env

    def _write_fake_cli(bindir, name, body=None):
        p = bindir / name
        p.write_text(body or "#!/bin/sh\nexit 0\n")
        os.chmod(p, 0o755)
        return p

    stream_ok = (
        '{"type":"system","subtype":"init","session_id":"s","model":"x"}\\n'
        '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"x"}}]}}\\n'
        '{"type":"result","is_error":false,"result":"DONE: ok\\\\nLEFT: nothing","num_turns":1,"session_id":"s"}\\n'
    )
    stream_script = (
        "#!/usr/bin/env python3\n"
        "import sys\n"
        "sys.stdout.write(" + repr(
            '{"type":"system","subtype":"init","session_id":"s","model":"x"}\n'
            '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"x"}}]}}\n'
            '{"type":"result","is_error":false,"result":"DONE: ok\\nLEFT: nothing","num_turns":1,"session_id":"s"}\n'
        ) + ")\n"
        "sys.stdout.flush()\n"
    )

    def case_setup():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-setup-"))
        home, arh, bindir = tmp / "home", tmp / "arh", tmp / "bin"
        home.mkdir(); bindir.mkdir()
        _write_fake_cli(bindir, "claude")
        _write_fake_cli(bindir, "grok")
        env = _setup_env(bindir, arh, home)
        r = subprocess.run([py, "-I", script, "setup", "--owner", "Ada", "--who", "grok",
                            "--handoff", "claude", "--yes"], env=env, capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            sys.stderr.write("setup-writes-config: %s %s\\n" % (r.returncode, r.stderr))
            return False
        cfgp = arh / "config.json"
        if not cfgp.is_file():
            return False
        if cfgp.stat().st_mode & 0o777 != 0o600:
            sys.stderr.write("setup-writes-config mode %o\\n" % (cfgp.stat().st_mode & 0o777))
            return False
        data = json.loads(cfgp.read_text())
        keys = [str(k).lower() for k in data]
        if any(any(w in k for w in ("token", "password", "secret", "api_key")) for k in keys):
            return False
        if "key" in keys:
            return False
        return (data.get("owner") == "Ada" and data.get("default_who") == "grok"
                and "claude" in (data.get("handoff") or []) and data.get("clis"))

    def case_setup_no_cli():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-nocli-"))
        home, arh, bindir = tmp / "home", tmp / "arh", tmp / "bin"
        home.mkdir(); bindir.mkdir()
        env = _setup_env(bindir, arh, home)
        r = subprocess.run([py, "-I", script, "setup", "--yes"], env=env,
                           capture_output=True, text=True, timeout=15)
        text_out = (r.stdout or "") + (r.stderr or "")
        if r.returncode == 0 or "no supported" not in text_out.lower() or (arh / "config.json").exists():
            sys.stderr.write("setup-no-cli: rc %s %s\\n" % (r.returncode, text_out))
            return False
        return True

    def case_setup_run():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-setuprun-"))
        home, arh, bindir, work = tmp / "home", tmp / "arh", tmp / "bin", tmp / "work"
        home.mkdir(); bindir.mkdir(); work.mkdir()
        _write_fake_cli(bindir, "claude", stream_script)
        _write_fake_cli(bindir, "grok", stream_script)
        env = _setup_env(bindir, arh, home)
        r = subprocess.run([py, "-I", script, "setup", "--owner", "Ada", "--who", "grok",
                            "--handoff", "claude", "--yes"], env=env, capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            sys.stderr.write("setup-run setup: %s\\n" % r.stderr)
            return False
        r2 = subprocess.run([py, "-I", script, "start", "--no-plan", "--plain", "--cwd", str(work), "--", "proof task"],
                            env=env, capture_output=True, text=True, timeout=20)
        if r2.returncode != 0:
            sys.stderr.write("setup-run start: %s %s\\n" % (r2.returncode, r2.stderr))
            return False
        rid = (r2.stdout or "").strip().splitlines()[-1]
        d = arh / "agents" / rid
        st = wait_status(d, lambda s: s.get("ended"), timeout=20)
        reap(rid, d)
        if not st or st.get("started_who") != "grok":
            sys.stderr.write("setup-run state: %s\\n" % (st,))
            return False
        return (st.get("handoff_chain") or []) == ["claude"]

    def case_start_no_config():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-noconfig-"))
        home, arh, bindir, work = tmp / "home", tmp / "arh", tmp / "bin", tmp / "work"
        home.mkdir(); bindir.mkdir(); work.mkdir()
        _write_fake_cli(bindir, "claude", stream_script)
        env = _setup_env(bindir, arh, home)
        r = subprocess.run([py, "-I", script, "start", "--plain", "--no-handoff", "--cwd", str(work), "--", "task"],
                           env=env, capture_output=True, text=True, timeout=15)
        text_out = (r.stdout or "") + (r.stderr or "")
        if r.returncode == 0 or "setup" not in text_out.lower():
            sys.stderr.write("start-no-config: rc %s %s\\n" % (r.returncode, text_out))
            return False
        lines = [ln for ln in text_out.splitlines() if ln.strip()]
        if len(lines) != 1:
            sys.stderr.write("start-no-config extra: %r\n" % text_out)
            return False
        if (arh / "agents").exists() and any((arh / "agents").glob("*")):
            return False
        if (arh / "config.json").exists():
            return False
        return True

    def case_run_stays_in_home():
        tmp = Path(tempfile.mkdtemp(prefix="alexus-iso-"))
        home, arh, bindir, work = tmp / "home", tmp / "arh", tmp / "bin", tmp / "work"
        home.mkdir(); bindir.mkdir(); work.mkdir()
        _write_fake_cli(bindir, "claude", stream_script)
        env = _setup_env(bindir, arh, home)
        r = subprocess.run([py, "-I", script, "setup", "--owner", "Ada", "--who", "claude",
                            "--handoff", "none", "--yes"], env=env, capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            return False
        r2 = subprocess.run([py, "-I", script, "start", "--no-plan", "--plain", "--no-handoff", "--cwd", str(work), "--", "iso task"],
                            env=env, capture_output=True, text=True, timeout=20)
        if r2.returncode != 0:
            sys.stderr.write("run-stays-in-home start: %s\\n" % r2.stderr)
            return False
        rid = (r2.stdout or "").strip().splitlines()[-1]
        d = arh / "agents" / rid
        st = wait_status(d, lambda s: s.get("ended"), timeout=20)
        reap(rid, d)
        if not st or not st.get("ended"):
            return False
        home_files = [p for p in home.rglob("*") if p.is_file()]
        if home_files:
            sys.stderr.write("run-stays-in-home home files %s\n" % home_files)
            return False
        if (home / ".alexus").exists():
            return False
        if not (arh / "config.json").is_file() or not (d / "state.json").is_file():
            return False
        return True

    def _proved_fake(bindir):
        payload = (
            '{"type":"system","subtype":"init","session_id":"s","model":"x"}\n'
            '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"x"}}]}}\n'
            '{"type":"result","is_error":false,"result":"DONE: started\\nLEFT: nothing","num_turns":1,"session_id":"s"}\n'
        )
        critic = '{"type":"result","is_error":false,"result":"VERDICT: pass","session_id":"crit"}\n'
        body = (
            "#!/usr/bin/env python3\n"
            "import os, sys\n"
            "args = ' '.join(sys.argv)\n"
            "root = os.environ.get('ALEXUS_HOME', '')\n"
            "run = os.environ.get('ALEXUS_RUN', '')\n"
            "d = os.path.join(root, 'agents', run) if root and run else ''\n"
            "if 'VERDICT:' in args or 'critic in a proved' in args:\n"
            "    sys.stdout.write(" + repr(critic) + ")\n"
            "    sys.exit(0)\n"
            "if d:\n"
            "    os.makedirs(d, exist_ok=True)\n"
            "    if not os.path.exists(os.path.join(d, 'checklist.frozen')):\n"
            "        open(os.path.join(d, 'checklist.md'), 'w').write('- [ ] marker :: verify: true\\n')\n"
            "sys.stdout.write(" + repr(payload) + ")\n"
            "sys.stdout.flush()\n"
        )
        return _write_fake_cli(bindir, "claude", body)

    def _arm_config(prefix, handoff=None):
        tmp = Path(tempfile.mkdtemp(prefix=prefix))
        home, arh, bindir, work = tmp / "home", tmp / "arh", tmp / "bin", tmp / "work"
        home.mkdir(); bindir.mkdir(); work.mkdir()
        fake = _proved_fake(bindir)
        env = _setup_env(bindir, arh, home)
        env["ALEXUS_CLAUDE"] = str(fake)
        env["ALEXUS_CRITICS"] = "claude"
        os.environ["ALEXUS_HOME"] = str(arh)
        os.environ["HOME"] = str(home)
        write_config({"owner": "Ada", "clis": ["claude", "grok", "codex"],
                      "default_who": "claude", "handoff": [] if handoff is None else handoff})
        return env, arh, work

    def case_start_needs_plan():
