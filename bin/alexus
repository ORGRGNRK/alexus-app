        sr_env = arm(sr_tmp, grok_touch, sr_fake)
        sr_proc, sr_log = spawn_worker(sr_env, sr_rid, sr_tmp)
        try:
            got4 = False
            end = time.time() + 15
            while time.time() < end:
                rp = sr_d / "receipts.jsonl"
                if rp.is_file():
                    n = len([ln for ln in rp.read_text(encoding="utf-8", errors="replace").splitlines() if ln.strip()])
                    if n >= 4:
                        got4 = True
                        break
                time.sleep(0.05)
            r_stop = subprocess.run([py, "-I", script, "stop", sr_rid], env=sr_env,
                                    capture_output=True, text=True, timeout=15)
            r_ver = subprocess.run([py, "-I", script, "verify", sr_rid], env=sr_env,
                                   capture_output=True, text=True, timeout=15)
            r_res = subprocess.run([py, "-I", script, "resume", sr_rid, "continue"], env=sr_env,
                                   capture_output=True, text=True, timeout=15)
            res_blob = (r_res.stdout or "") + (r_res.stderr or "")
            found["stop_resume"] = (got4 and r_stop.returncode == 0 and r_ver.returncode == 0
                                    and "intact" in (r_ver.stdout or "")
                                    and r_res.returncode == 0 and "chain_broken" not in res_blob)
            if not found["stop_resume"]:
                sys.stderr.write("receipts-stop-resume got4=%s stop=%s ver=%s res=%s %r\n" % (
                    got4, r_stop.returncode, (r_ver.returncode, r_ver.stdout),
