        env["PYTHONDONTWRITEBYTECODE"] = "1"
        r = subprocess.run([py, "-I", script, "receipts", "dn-run"], env=env,
                           capture_output=True, text=True, timeout=15)
        text = r.stdout or ""
        dn_lines = text.splitlines()
        done_pass = any(re.match(r"^DONE\s", ln) and "pass-line" in ln for ln in dn_lines)
        not_fail = any(re.match(r"^NOT DONE\s", ln) and "fail-line" in ln for ln in dn_lines)
        inverted = any((re.match(r"^DONE\s", ln) and "fail-line" in ln)
                       or (re.match(r"^NOT DONE\s", ln) and "pass-line" in ln) for ln in dn_lines)
        planted_claim_key = "sk-" + ("b" * 24)
        done_secret = any(re.match(r"^DONE\s", ln) and "[redacted]" in ln and "#" in ln for ln in dn_lines)
        found["done_not_done"] = (r.returncode == 0 and done_pass and not_fail and not inverted
                                  and planted_claim_key not in text and done_secret)
        if not found["done_not_done"]:
            sys.stderr.write("receipts-done-not-done rc=%s out=%r err=%r\n" % (r.returncode, text, r.stderr))

        html_arh = Path(tempfile.mkdtemp(prefix="alexus-rec-html-"))
        (html_arh / "home").mkdir()
        rid = "html-run"
