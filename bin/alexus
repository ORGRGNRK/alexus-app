def setup(argv):
    """Find installed CLIs, write $ALEXUS_HOME/config.json. Never asks for keys."""
    if wants_help(argv):
        print(__doc__)
        return
    owner = who = handoff_raw = None
    yes = False
    it = iter(argv)
    for a in it:
        if a in ("--yes", "-y"):
            yes = True
        elif a == "--owner":
            owner = next(it, None)
            if owner is None:
                sys.exit("alexus setup: --owner needs a name")
        elif a == "--who":
            raw = next(it, None)
            if raw is None:
                sys.exit("alexus setup: --who needs a value")
            who = normalize_who(raw)
            if who not in LISTED_CLIS:
                sys.exit(f"alexus setup: {who} is not a listed provider")
        elif a == "--handoff":
            handoff_raw = next(it, None)
            if handoff_raw is None:
                sys.exit("alexus setup: --handoff needs a value")
        else:
            sys.exit(f"alexus setup: unknown flag {a}")
    found = discover_clis()
    if not found:
        sys.exit("alexus: no supported AI CLI found on PATH (looked for claude, grok, and codex)")
    listed = [w for w in LISTED_CLIS if w in found]
    if (not yes) and sys.stdin.isatty():
        print("Found:")
        for w in listed:
            print(f"  {w}  {found[w]}")
        if owner is None:
            typed = input(f"Display name [{_account_name()}]: ").strip()
            owner = typed or _account_name()
        if who is None:
            options = ", ".join(listed)
            typed = input(f"Default CLI ({options}) [{listed[0]}]: ").strip().lower()
            who = normalize_who(typed or listed[0])
        if handoff_raw is None:
            rest = [w for w in listed if w != who]
            default = ",".join(rest)
            typed = input(f"Handoff order after {who} (comma-separated, or none) [{default}]: ").strip()
            handoff_raw = typed if typed else default
    else:
        if owner is None:
            owner = _account_name()
        if who is None:
            who = listed[0]
        if handoff_raw is None:
            handoff_raw = ",".join(w for w in ("claude", "codex", "grok") if w in found and w != who)
    owner = str(owner or "").strip()
    if not owner:
        sys.exit("alexus setup: owner name is empty")
    if who not in found:
        sys.exit(f"alexus setup: {who} is not installed")
    if who not in LISTED_CLIS:
        sys.exit(f"alexus setup: {who} is not a listed provider")
    raw = (handoff_raw or "").strip()
    if not raw or raw.lower() in ("none", "off", "false", "0", "no"):
        handoff = []
    else:
        handoff = []
        for part in raw.split(","):
            part = part.strip()
            if not part:
                continue
            w = normalize_who(part)
            if w not in LISTED_CLIS:
                sys.exit(f"alexus setup: {w} is not a listed provider")
            if w not in found:
                sys.exit(f"alexus setup: {w} is not installed")
            if w != who and w not in handoff:
                handoff.append(w)
    clis = []
    for w in [who] + handoff:
        if w not in clis:
            clis.append(w)
    path = write_config({
        "owner": owner,
        "clis": clis,
        "default_who": who,
        "handoff": handoff,
    })
    print(f"wrote {path}")


def load_plan_cli(argv):
    """bin/alexus-plan is the planner. It reuses this file's checklist parser and check runner."""
    path = str(Path(__file__).resolve().parent / "alexus-plan")
    name = "alexus_plan"
    mod = sys.modules.get(name)
    if mod is None:
        loader = importlib.machinery.SourceFileLoader(name, path)
        mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
        sys.modules[name] = mod
        loader.exec_module(mod)
    return mod.main(argv)


def main():
    a = sys.argv[1:]
    if a and a[0] == "plan":
        sys.exit(load_plan_cli(a[1:]))
    commands = {"setup", "start", "resume", "handoff", "run", "stop", "force-stop", "show", "list",
                "verify", "receipts", "selfcheck", "wall-hook"}
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
    elif a[0] in commands and wants_help(a[1:]):
        print(__doc__)
    elif a[0] == "setup":
        setup(a[1:])
    elif a[0] == "start":
        start(a[1:])
    elif a[0] == "resume":
        resume_run(a[1:])
    elif a[0] == "handoff":
        handoff(a[1:])
    elif a[0] == "run" and len(a) == 2:
        run(a[1])
    elif a[0] in ("stop", "force-stop"):
        force = a[0] == "force-stop" or "--force" in a or "-f" in a
        ids = [arg for arg in a[1:] if arg not in ("--force", "-f")]
        if not ids:
            sys.exit(f"usage: alexus {a[0]} [--force] <id>")
        stop(ids[0], force=force)
    elif a[0] == "show" and len(a) == 2:
        print(json.dumps(load(run_dir(a[1])), indent=1))
    elif a[0] == "list":
        for st in runs()[:30]:
            print(run_summary(st))
    elif a[0] == "verify":
        sys.exit(cmd_verify(a[1:]))
    elif a[0] == "receipts":
        sys.exit(cmd_receipts(a[1:]))
    elif a[0] == "selfcheck":
        sys.exit(selfcheck())
    elif a[0] == "wall-hook" and len(a) == 2:
        sys.exit(wall_hook(a[1]))
    else:
        sys.exit(__doc__)


def _inside_state(path, root):
    """True when the resolved directory stays inside the state root."""
    try:
        path.resolve().relative_to(root.resolve())
    except (OSError, ValueError):
        return False
    return True


if __name__ == "__main__":
    main()
