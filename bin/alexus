        for nan_i, (nan_word, nan_val) in enumerate(
                (("NaN", float("nan")), ("Infinity", float("inf")), ("-Infinity", float("-inf")))):
            n1 = rec_obj(1, "run_started", {"who": "claude"}, RECEIPT_GENESIS)
