    cs = _fake_run("claude", str(claude), {"model": None})
    check("claude-run", cs and cs["status"] == "done" and cs["session"] == "sess-c"
          and cs["plan"] and cs["plan"][0]["status"] == "completed" and cs["plan"][0]["step"] == "step one"
          and cs["final"].startswith("DONE: claude path") and cs["cost_usd"] == 1.5 and cs["tools"] == 2)

    muse = bin_dir / "muse"
    muse.write_text("""#!/bin/bash
printf '%s\\n' '{"stream":{"kind":"session","id":"sess-muse-1"},"payload_type":"session.started","payload":{"kind":"session_started"}}'
printf '%s\\n' '{"stream":{"kind":"session","id":"sess-muse-1"},"payload_type":"runtime.session","payload":{"kind":"run","event":{"kind":"assistant_tool_calls_committed","tool_calls":[{"call_id":"c1","name":"write_todos","args":"{\\"todos\\":[{\\"text\\":\\"look\\",\\"status\\":\\"in_progress\\"},{\\"text\\":\\"report\\",\\"status\\":\\"pending\\"}]}"}]}}}'
