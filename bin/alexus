    fake = bin_dir / "claude-proved"
    fake.write_text(r"""#!/bin/bash
D="$ALEXUS_HOME/agents/$ALEXUS_RUN"; N="$D/fake-legs"; C="$D/fake-critics"
emit() { printf '%s\n' "$1"; }
done_() { emit '{"type":"result","is_error":false,"result":"DONE: fake work here\nLEFT: nothing","total_cost_usd":0.5,"num_turns":1,"session_id":"sess-p"}'; }
if [[ "$*" == *"VERDICT: pass"* ]]; then
  c=$(( $(cat "$C" 2>/dev/null || echo 0) + 1 )); echo $c > "$C"
  emit '{"type":"system","subtype":"init","session_id":"sess-critic"}'
  emit '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"r","name":"Read","input":{"file_path":"out.txt"}}]}}'
  if [ $c = 1 ]; then v='REFUTED: out.txt has no date\nVERDICT: fail'; else v='CONFIRMED: out.txt fine\nVERDICT: pass'; fi
  emit '{"type":"result","is_error":false,"result":"'"$v"'","total_cost_usd":0.25,"num_turns":1}'; exit 0
fi
n=$(( $(cat "$N" 2>/dev/null || echo 0) + 1 )); echo $n > "$N"
emit '{"type":"system","subtype":"init","session_id":"sess-p"}'
case "$MODE:$n" in
  good:1) printf -- '- [ ] out.txt exists :: verify: test -s out.txt\n- [ ] the result looks right :: verify: HUMAN\n' > "$D/checklist.md" ;;
  good:2) echo hello > out.txt
          printf -- '- [ ] out.txt exists :: verify: true\n- [ ] new line :: verify: grep -q hello out.txt\n' > "$D/checklist.md" ;;
  good:3) date >> out.txt ;;
  stuck:1) printf -- '- [ ] never :: verify: test -f nope\n' > "$D/checklist.md" ;;
  write:1) printf -- '- [ ] sandbox :: verify: touch __SBX_PROBE__\n' > "$D/checklist.md" ;;
esac
done_
""".replace("__SBX_PROBE__", shlex.quote(str(sbx_probe or "/alexus-sbx-unusable"))))
    os.chmod(fake, 0o755)

    def proved_run(mode):
        os.environ["MODE"] = mode
        tmp = Path(tempfile.mkdtemp(prefix="alexus-p-"))
        os.environ.update(ALEXUS_HOME=str(tmp), ALEXUS_CLAUDE=str(fake))
