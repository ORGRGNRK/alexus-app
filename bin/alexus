        planted_prompt = "PLANTEDPROMPT_" + ("Q" * 40)
        planted_key = "sk-" + ("b" * 24)
        secret_fake = (
            "#!/usr/bin/env python3\n"
            "import json, os, sys\n"
            "args = ' '.join(sys.argv)\n"
            "root = os.environ.get('ALEXUS_HOME', '')\n"
            "runid = os.environ.get('ALEXUS_RUN', '')\n"
