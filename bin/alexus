            "sys.stdout.write('{\"type\":\"result\",\"is_error\":false,\"result\":\"DONE: ok\\\\nLEFT: nothing\",\"num_turns\":1,\"session_id\":\"s\"}\\n')\n"
        )
        st, d, arh, work = arm_rec("alexus-rec-sec-", secret_fake, "sec-run",
                                   task="do the task " + planted_prompt)
        blob = (d / "receipts.jsonl").read_text(encoding="utf-8") if (d / "receipts.jsonl").is_file() else ""
        found["no_prompt_or_key"] = bool(blob) and planted_prompt not in blob and planted_key not in blob
        if not found["no_prompt_or_key"]:
            sys.stderr.write("receipts-no-prompt-or-key blob_len=%s has_prompt=%s has_key=%s\n" % (
                len(blob), planted_prompt in blob, planted_key in blob))

        oh_root = Path(tempfile.mkdtemp(prefix="alexus-rec-oh-"))
        oh_d = oh_root / "run"
        oh_d.mkdir(parents=True)
        oh_work = oh_root / "work"
        oh_work.mkdir()
        st_oh = {"_receipt_head": RECEIPT_GENESIS, "_receipt_seq": 0}
        items_oh = parse_checklist("- [ ] long-out :: verify: python3 -c \"print('A'*2000)\"\n")
        try:
            run_checks(oh_d, str(oh_work), items_oh, st=st_oh)
        except Exception:
            import traceback
            traceback.print_exc()
        oh_recs = []
        ohp = oh_d / "receipts.jsonl"
        if ohp.is_file():
            _, _, _, oh_recs = validate_receipts_file(ohp)
        want_hash = sha256_text("A" * 2000 + "\n")
        squeezed_hash = sha256_text(one("A" * 2000, 400))
        got_hash = None
        for rec in oh_recs:
            if rec.get("type") == "check_result":
                got_hash = (rec.get("data") or {}).get("output_sha256")
        found["output_hash"] = (got_hash == want_hash and got_hash != squeezed_hash
                                and items_oh and items_oh[0].get("ok") is True)
        if not found["output_hash"]:
            sys.stderr.write("receipts-output-hash got=%s want=%s squeezed=%s ok=%s\n" % (
                got_hash, want_hash, squeezed_hash, (items_oh[0].get("ok") if items_oh else None)))

        # output_sha256 is sha256 of the exact stdout bytes: trailing newline, CR, ANSI codes kept,
        # stderr left out, and not replaced by the "output did not match" message.
        raw_root = Path(tempfile.mkdtemp(prefix="alexus-rec-rawout-"))
        raw_cases = [
            ("raw-pass", "printf '\\033[31mred\\033[0m\\r\\n  pad  \\n'; printf 'to-stderr\\n' >&2",
             "", b"\x1b[31mred\x1b[0m\r\n  pad  \n", True),
            ("raw-expect-miss", "printf 'hello\\n'", "nomatch", b"hello\n", False),
            ("raw-exit-1", "printf 'partial'; exit 3", "", b"partial", False),
        ]
        raw_ok = True
        for raw_i, (raw_claim, raw_cmd, raw_expect, raw_bytes, raw_pass) in enumerate(raw_cases):
            raw_d = raw_root / f"run{raw_i}"
            raw_d.mkdir()
            st_raw = {"_receipt_head": RECEIPT_GENESIS, "_receipt_seq": 0}
            raw_line = f"- [ ] {raw_claim} :: verify: {raw_cmd}" + (f" :: expect: {raw_expect}" if raw_expect else "")
            raw_items = parse_checklist(raw_line + "\n")
            try:
                run_checks(raw_d, str(raw_root), raw_items, st=st_raw)
            except Exception as e:
                sys.stderr.write("receipts-output-raw case=%s err=%r\n" % (raw_claim, e))
            raw_recs = []
            if (raw_d / "receipts.jsonl").is_file():
                _, _, _, raw_recs = validate_receipts_file(raw_d / "receipts.jsonl")
            raw_got = [r["data"] for r in raw_recs if r.get("type") == "check_result"]
            raw_want = hashlib.sha256(raw_bytes).hexdigest()
            if (len(raw_items) != 1 or len(raw_got) != 1 or raw_got[0].get("output_sha256") != raw_want
                    or raw_got[0].get("passed") is not raw_pass):
                raw_ok = False
                sys.stderr.write("receipts-output-raw case=%s want=%s got=%r items=%r\n" % (
                    raw_claim, raw_want, raw_got, raw_items))
        found["output_raw"] = raw_ok

        fl_root = Path(tempfile.mkdtemp(prefix="alexus-rec-files-"))
        fl_work = fl_root / "work"
        fl_work.mkdir()
        subprocess.run(["git", "init"], cwd=str(fl_work), capture_output=True, timeout=10)
        subprocess.run(["git", "config", "user.email", "demo@example.com"], cwd=str(fl_work),
                       capture_output=True, timeout=10)
