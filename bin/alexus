            return False
        rid = (r.stdout or "").strip().splitlines()[-1]
        d = arh / "agents" / rid
        st = wait_status(d, lambda s: s.get("ended"), timeout=25)
        reap(rid, d)
        frozen = (d / "checklist.frozen").read_text() if (d / "checklist.frozen").exists() else ""
        if not st or not st.get("given_checklist") or st.get("mode") != "proved" or "verify: true" not in frozen:
            sys.stderr.write("start-checklist state: %s frozen %r\n" % (st, frozen))
