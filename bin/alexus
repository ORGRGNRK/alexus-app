    pw_home = Path(os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir))
    temp_roots = ("/private/tmp", "/tmp", "/private/var/folders", "/var/folders")
    in_temp = any(str(pw_home) == root or str(pw_home).startswith(root + "/") for root in temp_roots)
    sbx_probe = None if in_temp else pw_home / ".alexus-sbx-test"
    if sbx_probe is not None and sbx_probe.exists():
