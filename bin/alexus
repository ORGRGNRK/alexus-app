os.makedirs(d, exist_ok=True)
key = "sk-" + ("b" * 24)
open(os.path.join(d, "checklist.md"), "w").write(
    "- [ ] pass-line :: verify: true\n- [ ] fail-line :: verify: false\n- [ ] used " + key + " :: verify: true\n")
sys.stdout.write('{"type":"system","subtype":"init","session_id":"s","model":"x"}\n')
sys.stdout.write('{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"x"}}]}}\n')
sys.stdout.write('{"type":"result","is_error":false,"result":"DONE: claimed\\nLEFT: nothing","num_turns":1,"session_id":"s"}\n')
'''
        st, d, arh, work = arm_rec("alexus-rec-dn-", dn_fake, "dn-run")
        env = os.environ.copy()
