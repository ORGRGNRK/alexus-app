        r_cl = subprocess.run([py, "-I", script, "receipts", "dup-run"], env=env_cl,
                              capture_output=True, text=True, timeout=15)
        cl_rows = [ln for ln in (r_cl.stdout or "").splitlines() if "same claim" in ln]
        ch1 = rec_obj(1, "checklist_frozen", {"checklist_sha256": "a" * 64, "claims": [
            {"claim": "frozen-unrun", "sha256": "b" * 64},
            {"claim": "frozen-failed", "sha256": "c" * 64}]}, RECEIPT_GENESIS)
        ch2 = rec_obj(2, "check_result", {"claim": "frozen-failed", "passed": False}, ch1["hash"])
        ch3 = rec_obj(3, "check_result", {"claim": "added-failed", "passed": False}, ch2["hash"])
        ch_dir = Path(tempfile.mkdtemp(prefix="alexus-rec-chainrows-"))
        (ch_dir / "checklist.md").write_text("- [ ] other :: verify: true\n")
        (ch_dir / "checklist.frozen").write_text("- [ ] other :: verify: true\n")
        ch_rows = {r["claim"]: r for r in _checklist_rows(ch_dir, [ch1, ch2, ch3])}
        found["rows_from_chain"] = (
            r_cl.returncode == 0 and len(cl_rows) == 2
            and cl_rows[0].startswith("NOT DONE") and cl_rows[1].startswith("DONE")
            and set(ch_rows) == {"frozen-unrun", "frozen-failed", "added-failed", "other"}
            and not any(r["done"] for r in ch_rows.values())
            and ch_rows["frozen-unrun"]["seq"] is None
            and ch_rows["frozen-failed"]["seq"] == 2
            and ch_rows["added-failed"]["seq"] == 3)
        if not found["rows_from_chain"]:
            sys.stderr.write("receipts-rows-from-chain rc=%s cl=%r ch=%r\n" % (
                r_cl.returncode, cl_rows, ch_rows))

        gt_root = Path(tempfile.mkdtemp(prefix="alexus-rec-gitslow-"))
        gt_repo = gt_root / "repo"
        gt_repo.mkdir()
        subprocess.run(["git", "init", "-q"], cwd=str(gt_repo), capture_output=True, timeout=10)
        real_run = subprocess.run

        def status_slow(cmd, *a, **kw):
            if isinstance(cmd, list) and cmd[:1] == ["git"] and "status" in cmd:
                raise subprocess.TimeoutExpired(cmd, kw.get("timeout") or 30)
            return real_run(cmd, *a, **kw)

        def status_fails(cmd, *a, **kw):
            if isinstance(cmd, list) and cmd[:1] == ["git"] and "status" in cmd:
                return subprocess.CompletedProcess(cmd, 128, b"", b"")
            return real_run(cmd, *a, **kw)

        gt_ok = True
        for gt_i, (gt_fake, gt_at_start) in enumerate(
                ((status_slow, True), (status_slow, False), (status_fails, True), (status_fails, False))):
            gt_d = gt_root / f"run{gt_i}"
