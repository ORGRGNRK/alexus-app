def agents_dir():
    """Run folders live under $ALEXUS_HOME/agents, defaulting to ~/.alexus/runner/agents."""
    return runner_home() / "agents"


# One path component. An absolute id, or one that contains ".." or a slash, would make
# agents_dir() / id point at some other folder.
RUN_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,200}$")


def run_dir(rid):
    """Folder for one run. The id is a single name under the state directory, nothing else."""
    if RUN_ID_RE.fullmatch(str(rid or "")) is None:
        sys.exit("alexus: bad run id")
    root = agents_dir()
    d = root / rid
    if d.parent != root:
        sys.exit("alexus: bad run id")
    return d


def cli_bin(who):
    names = {"grok": "ALEXUS_GROK", "muse": "ALEXUS_MUSE", "codex": "ALEXUS_CODEX"}
    bare = who if who in names else "claude"
    override = (os.environ.get(names.get(who, "ALEXUS_CLAUDE")) or "").strip()
    if override:
        return override
    return shutil.which(bare) or bare


def normalize_who(w):
    w = (w or "claude").strip().lower()
    if w not in ("claude", "grok", "muse", "codex"):
        sys.exit(f"alexus start: --who must be claude, grok, muse or codex, not {w}")
    return w


def resolve_ollama_url(value):
    """Validate a local model URL. Missing or invalid means no URL; there is no built-in host."""
    value = (value or "").strip()
    if not value:
        return None

    def valid_host(h):
        return (0 < len(h) <= 253 and not h.startswith("-")
                and re.fullmatch(r"[A-Za-z0-9.:-]+", h) is not None)

    value = value.rstrip("/")
    try:
        u = urlsplit(value)
        if u.scheme not in ("http", "https") or not u.hostname or not valid_host(u.hostname):
            return None
        if any(c.isspace() for c in value) or u.username or u.password or u.query or u.fragment:
            return None
        if u.port is not None and not 0 < u.port < 65536:
            return None
    except ValueError:
        return None
    path = u.path
    for suffix in ("/v1/models", "/v1", "/api/tags", "/api"):
        if path.endswith(suffix):
            path = path[:-len(suffix)]
            break
    return urlunsplit((u.scheme, u.netloc, path, "", ""))


def local_ollama_url():
    """Optional local model URL from settings or OLLAMA_URL / OLLAMA_HOST. No default host."""
    cfg = load_config() or {}
    from_cfg = str(cfg.get("local_model_url") or "").strip()
    return resolve_ollama_url(from_cfg or os.environ.get("OLLAMA_URL") or os.environ.get("OLLAMA_HOST") or "")


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def one(s, n=160):
    s = " ".join(str(s or "").split())
    return s if len(s) <= n else s[:n - 1] + "…"


def load(d):
    try:
        return json.loads((d / "state.json").read_text())
    except Exception:
        return None


# A stop is a marker plus a generation bump, both written under the state lock before the provider is
# signalled. Worker saves carry _worker_gen and are dropped once that generation is stale or the run is
# stopped, so a provider dying from the stop, a gap between legs, or a handoff that was already decided
# cannot write "running" back. resume and handoff clear or supersede this on purpose.
@contextmanager
def state_lock(d):
    d.mkdir(parents=True, exist_ok=True)
    fh = open(d / ".state.lock", "a+")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX)
        yield fh
    finally:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()


def _write_unlocked(d, state):
    clean = {k: v for k, v in state.items() if not str(k).startswith("_")}
    tmp = d / "state.json.tmp"
    tmp.write_text(json.dumps(clean, indent=1))
    os.replace(tmp, d / "state.json")


def _owns(d, st):
    """True if this worker may still write. Caller holds the state lock."""
    if (d / "STOP").exists():
        return False
    disk = load(d) or {}
    if disk.get("status") == "stopped":
        return False
    gen = st.get("_worker_gen")
    if gen is None:
        return False
    return int(disk.get("gen") or 0) == int(gen)


def save(d, state):
    """Persist state. A worker whose stop/generation is stale writes nothing. Any other write that
    finds the run stopped keeps status stopped."""
    with state_lock(d):
        if state.get("_worker_gen") is not None:
            if not _owns(d, state):
                return False
        else:
            disk = load(d) or {}
            if (disk.get("status") == "stopped" or (d / "STOP").exists()) and state.get("status") != "stopped":
                if state.get("verdict") != "chain_broken":
                    state = dict(state, status="stopped")
        _write_unlocked(d, state)
        return True


def worker_live(d, st):
    with state_lock(d):
        return _owns(d, st)


def adopt_worker(d, st):
    """Take the generation on disk. A stop, or a resume that bumped it, means this worker must not write."""
    with state_lock(d):
        if (d / "STOP").exists():
            return False
        disk = load(d) or {}
        if not disk or disk.get("status") == "stopped":
            return False
        st.clear()
        st.update(disk)
        st["_dir"] = str(d)
        st["gen"] = int(disk.get("gen") or 0)
        st["_worker_gen"] = st["gen"]
        return True


def _publish_running(d, st, pid):
    with state_lock(d):
        if not _owns(d, st):
            return False
        st.update(status="running", pid=pid)
        _write_unlocked(d, st)
        return True


def _killpg(pid, sig):
    if not pid:
        return
    try:
        os.killpg(int(pid), sig)
    except ProcessLookupError:
        try:
            os.kill(int(pid), sig)
        except ProcessLookupError:
            pass
    except PermissionError:
        pass


def _killpg_force(pid):
    """SIGTERM then SIGKILL. A provider that ignores SIGTERM must not keep writing."""
    _killpg(pid, signal.SIGTERM)
    _killpg(pid, signal.SIGKILL)


def _process_lstart(pid):
    """Start time of pid, '' if that process is gone, None if it could not be checked.
    A later stop --force uses this so a recycled pid is not killed."""
    try:
        proc = subprocess.run(["/bin/ps", "-p", str(int(pid)), "-o", "lstart="],
                              capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.TimeoutExpired, TypeError, ValueError):
        return None
    if proc.returncode == 0:
        return (proc.stdout or "").strip()
    err = ((proc.stderr or "") + (proc.stdout or "")).lower()
    if any(w in err for w in ("permit", "not allowed", "sandbox")):
        return None
    return ""


def _stop_target(st):
    """Provider to signal. The live pid wins. A pid kept from an earlier stop is used only
    while that same process is still alive (a provider can ignore SIGTERM)."""
    live = st.get("pid")
    if live:
        try:
            pid = int(live)
        except (TypeError, ValueError):
            pid = 0
        if pid > 0:
            started = _process_lstart(pid)
            return pid, started or None
    try:
        pid = int(st.get("stop_pid") or 0)
    except (TypeError, ValueError):
        return None, None
    if pid <= 0:
        return None, None
    current = _process_lstart(pid)
    recorded = st.get("stop_lstart") or ""
    if current == "":
        return None, None
    if current and recorded and current != recorded:
        return None, None
    if current:
        return pid, current
    return pid, recorded or None


def _authority_update(d, mutate, clear_stop=False):
    """A person's resume or handoff. Bumps the generation so the old worker cannot write over it."""
    with state_lock(d):
        st = load(d)
        if not st:
            return None
        if clear_stop:
            try:
                (d / "STOP").unlink()
            except FileNotFoundError:
                pass
        st["gen"] = int(st.get("gen") or 0) + 1
        mutate(st)
        if not clear_stop and (d / "STOP").exists() and st.get("status") != "stopped":
            st["status"] = "stopped"
        _write_unlocked(d, st)
        return st


def wants_help(argv):
    for a in argv:
        if a == "--":
            return False
        if a in ("-h", "--help"):
            return True
    return False


def run_optional_hook(hook, arg):
    """Run a user hook. Missing is skipped."""
    if not hook or not os.path.isfile(hook):
        return
    try:
        subprocess.run([hook, str(arg)], check=False)
    except Exception:
        pass


def receipt(action, cmd, ref, session=None, who="claude"):
    """Optional receipt hook from settings. Off by default."""
    hook = hook_cmd("receipt")
    if not hook:
        return
    run_optional_hook(hook, ref or "")


# ------------------------------------------------------------------ hash-chained receipts (runner-written)
RECEIPT_GENESIS = "0" * 64
RECEIPT_HASH_RE = re.compile(r"^[0-9a-f]{64}$")
RECEIPT_FIELDS = ("seq", "ts", "type", "data", "prev_hash", "hash")
FILE_HASH_MAX = 10 * 1024 * 1024
# Same shapes as the planner's past-failure scrub. Built from pieces so the
# source does not contain a token that looks like a live key.
SECRET_TEXT_RE = re.compile(
    r"-----BEGIN [A-Z ]*PRIVATE KEY-----.*?(?:-----END [A-Z ]*PRIVATE KEY-----|\Z)"
    r"|\b(?:" + "sk-" + r"[A-Za-z0-9_-]{16,}|" + "ghp_" + r"[A-Za-z0-9]{16,}|"
    + "github_pat_" + r"[A-Za-z0-9_]{16,}|" + "xai-" + r"[A-Za-z0-9]{16,})",
    re.S,
)


def canonical_json(obj):
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def _utf8_bytes(s):
    """UTF-8 bytes for hashing. Lone surrogates (e.g. a tool input) must not crash the run."""
    return str(s).encode("utf-8", errors="surrogatepass")


def sha256_text(s):
    return hashlib.sha256(_utf8_bytes(s)).hexdigest()


def sha256_json(obj):
    try:
        raw = canonical_json(obj)
    except (TypeError, ValueError):
        raw = canonical_json(str(obj))
    return hashlib.sha256(_utf8_bytes(raw)).hexdigest()


def receipt_hash(obj):
    body = {k: obj[k] for k in obj if k != "hash"}
    return sha256_text(canonical_json(body))


def redact_text(s):
    if s is None:
        return s
    return SECRET_TEXT_RE.sub("[redacted]", str(s))


def redact_value(v):
    if isinstance(v, str):
        return redact_text(v)
    if isinstance(v, dict):
        return {k: redact_value(x) for k, x in v.items()}
    if isinstance(v, list):
        return [redact_value(x) for x in v]
    return v


def receipts_path(d):
    return Path(d) / "receipts.jsonl"


@contextmanager
def receipts_lock(d):
    Path(d).mkdir(parents=True, exist_ok=True)
    fh = open(Path(d) / ".receipts.lock", "a+")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX)
        yield fh
    finally:
        fcntl.flock(fh, fcntl.LOCK_UN)
        fh.close()


def _field_type_ok(name, value):
    if name == "seq":
        return isinstance(value, int) and not isinstance(value, bool)
    if name in ("ts", "type", "prev_hash", "hash"):
        return isinstance(value, str)
    if name == "data":
        return isinstance(value, dict)
    return False


def _reject_json_constant(name):
    """Python's parser accepts NaN and Infinity, but they are not JSON."""
    raise ValueError(f"{name} is not valid JSON")


def validate_receipts_file(path):
    """Return (ok, lineno, reason, records). lineno is 1-based. reason is exact."""
    path = Path(path)
    records = []
    try:
        raw = path.read_bytes()
    except OSError as e:
        return False, 0, f"cannot read receipts file: {e}", records
    parts = raw.split(b"\n")
    if parts and parts[-1] == b"":
        parts = parts[:-1]
    for i, blob in enumerate(parts, 1):
        try:
            line = blob.decode("utf-8", errors="surrogatepass")
        except UnicodeDecodeError:
            return False, i, "line is not valid JSON", records
        try:
            obj = json.loads(line, parse_constant=_reject_json_constant)
        except (ValueError, RecursionError, MemoryError):
            return False, i, "line is not valid JSON", records
        if not isinstance(obj, dict):
            return False, i, "line is not a JSON object", records
        for name in RECEIPT_FIELDS:
            if name not in obj:
                return False, i, f"missing field {name}", records
            if not _field_type_ok(name, obj[name]):
                return False, i, f"{name} is the wrong type", records
        if not RECEIPT_HASH_RE.fullmatch(obj["hash"]):
            return False, i, "hash is not exactly 64 lowercase hex characters", records
        if not RECEIPT_HASH_RE.fullmatch(obj["prev_hash"]):
            return False, i, "prev_hash is not exactly 64 lowercase hex characters", records
        expected_seq = (records[-1]["seq"] + 1) if records else 1
        if obj["seq"] != expected_seq:
            return False, i, "seq is not the previous seq plus one", records
        expected_prev = records[-1]["hash"] if records else RECEIPT_GENESIS
        if obj["prev_hash"] != expected_prev:
            return False, i, "prev_hash does not equal the previous line's hash", records
        if obj["hash"] != receipt_hash(obj):
            return False, i, "recomputed hash differs", records
        if line != canonical_json(obj):
            return False, i, "line is not in canonical form", records
        records.append(obj)
    return True, 0, "", records


def receipts_status(path, expected_head=None, known_head=None):
    """Validate a chain. Returns a dict: ok, lineno, reason, records, head, count.
    Missing file is not a crash: ok is False with a plain reason."""
    path = Path(path)
    if not path.is_file():
        return {"ok": False, "lineno": 0, "reason": "no receipts file", "records": [],
                "head": None, "count": 0, "path": str(path)}
    ok, lineno, reason, records = validate_receipts_file(path)
    head = records[-1]["hash"] if records else RECEIPT_GENESIS
    if ok and expected_head:
        if records and records[-1]["hash"] == expected_head:
            pass
        elif not records:
            ok, lineno, reason = False, 0, "chain has been shortened"
        else:
            found = any(r.get("hash") == expected_head for r in records)
            if found:
                ok, lineno, reason = False, len(records), "head does not match"
            elif known_head and expected_head == known_head:
                ok, lineno, reason = False, len(records), "chain has been shortened"
            else:
                ok, lineno, reason = False, len(records), "head was not found"
    return {"ok": ok, "lineno": lineno, "reason": reason, "records": records,
            "head": head if records else None, "count": len(records), "path": str(path)}


def fail_chain(d, st, lineno, reason):
    """Stop the agent, write no further receipts, record chain_broken. Never proved."""
    if st.get("_chain_broken"):
        return
    st["_chain_broken"] = True
    st["receipts_broken"] = True
    pid = st.get("pid")
    if pid:
        _killpg_force(pid)
    note = f"line {lineno}: {reason}" if lineno else reason
    st.update(status="failed", verdict="chain_broken", verdict_note=note,
              ended=now(), pid=None, phase=None, now="chain_broken: " + note)
    save(d, st)


def _had_receipts(st):
    return bool(st.get("_receipt_seq") or st.get("receipts_seq") or st.get("receipts_head")
                or st.get("receipts_broken") or st.get("verdict") == "chain_broken")


def _cursor_error(d, st):
    path = receipts_path(d)
    if not path.is_file():
        if _had_receipts(st):
            return 0, "receipts file is missing"
        return None
    ok, lineno, reason, recs = validate_receipts_file(path)
    if not ok:
        return lineno, reason
    if not recs and _had_receipts(st):
        return 0, "chain has been shortened"
    expected = st.get("_receipt_head")
    if expected and (not recs or recs[-1]["hash"] != expected):
        return (len(recs) if recs else 1), "receipts were changed after the runner last wrote"
    return None


def init_receipt_cursor(d, st):
    """Load the last runner-written hash from disk. Broken chain stops the run."""
    if st.get("receipts_broken") or st.get("verdict") == "chain_broken":
        fail_chain(d, st, 0, st.get("verdict_note") or "receipts chain is broken")
        return False
    path = receipts_path(d)
    if not path.is_file():
        if _had_receipts(st):
            fail_chain(d, st, 0, "receipts file is missing")
            return False
        st["_receipt_head"] = RECEIPT_GENESIS
        st["_receipt_seq"] = 0
        return True
    ok, lineno, reason, recs = validate_receipts_file(path)
    if not ok:
        fail_chain(d, st, lineno, reason)
        return False
    if not recs and _had_receipts(st):
        fail_chain(d, st, 0, "chain has been shortened")
        return False
    st["_receipt_head"] = recs[-1]["hash"] if recs else RECEIPT_GENESIS
    st["_receipt_seq"] = recs[-1]["seq"] if recs else 0
    if recs:
        st["receipts_head"] = st["_receipt_head"]
        st["receipts_seq"] = st["_receipt_seq"]
    return True


def chain_ok(d, st):
    """Validate the whole chain. On failure: stop, no more receipts, chain_broken."""
    if st.get("_chain_broken") or st.get("receipts_broken") or st.get("verdict") == "chain_broken":
        return False
    with receipts_lock(d):
        err = _cursor_error(d, st)
    if err is None:
        return True
    fail_chain(d, st, err[0], err[1])
    return False


def write_receipt(d, st, typ, data):
    """Append one runner-written receipt. Returns the object, or None if the chain is broken."""
    if st.get("_chain_broken") or st.get("verdict") == "chain_broken":
        return None
    d = Path(d)
    data = redact_value(data if isinstance(data, dict) else {"value": data})
    with receipts_lock(d):
        err = _cursor_error(d, st)
        if err:
            fail_chain(d, st, err[0], err[1])
            return None
        path = receipts_path(d)
        prev_hash = st.get("_receipt_head") or RECEIPT_GENESIS
        seq = int(st.get("_receipt_seq") or 0) + 1
        obj = {"seq": seq, "ts": now(), "type": str(typ), "data": data, "prev_hash": prev_hash}
        obj["hash"] = receipt_hash(obj)
        try:
            payload = _utf8_bytes(canonical_json(obj) + "\n")
            with open(path, "ab") as fh:
                fh.write(payload)
        except (UnicodeEncodeError, OSError):
            fail_chain(d, st, 0, "could not write receipt")
            return None
        st["_receipt_head"] = obj["hash"]
        st["_receipt_seq"] = seq
        st["receipts_head"] = obj["hash"]
        st["receipts_seq"] = seq
        save(d, st)
        return obj


def write_frozen_receipt(d, st):
    fro = Path(d) / "checklist.frozen"
    if not fro.is_file():
        return None
    text = fro.read_text(encoding="utf-8")
    items = parse_checklist(text)
    return write_receipt(d, st, "checklist_frozen", {
        "checklist_sha256": sha256_text(text),
        "claims": [{"claim": redact_text(c["claim"]), "sha256": sha256_text(c["claim"])} for c in items],
    })


FILES_WALK_SKIP = {".git", "node_modules", "__pycache__", ".venv", "venv"}
FILES_WALK_CAP = 2000
GIT_READ_ERRORS = (subprocess.SubprocessError, OSError)


def files_snap_path(d):
    return Path(d) / "files_snap.json"


def _git_z_paths(cwd, args):
    """NUL-separated git paths, unquoted. Returns decoded path strings."""
    r = subprocess.run(["git", "-C", cwd, "-c", "core.quotepath=false", *args],
                       capture_output=True, timeout=30)
    if r.returncode != 0:
        raise subprocess.CalledProcessError(r.returncode, "git")
    if not r.stdout:
        return []
    names = []
    for chunk in r.stdout.split(b"\0"):
        if chunk:
            names.append(os.fsdecode(chunk))
    return names


def _git_status_names(cwd):
    status = subprocess.run(
        ["git", "-C", cwd, "-c", "core.quotepath=false", "status", "-z", "--porcelain",
         "--untracked-files=all", "--no-renames"],
        capture_output=True, timeout=30)
    if status.returncode != 0:
        raise subprocess.CalledProcessError(status.returncode, "git")
    if not status.stdout:
        return []
    names = []
    chunks = status.stdout.split(b"\0")
    i = 0
    while i < len(chunks):
        rec = chunks[i]
        i += 1
        if not rec:
            continue
        xy = rec[:2].decode("ascii", "replace") if len(rec) >= 2 else ""
        path = rec[3:] if len(rec) > 3 else rec
        if xy[:1] in ("R", "C") and i < len(chunks):
            path = chunks[i]
            i += 1
        if path:
            names.append(os.fsdecode(path))
    return names


def _git_show_prefix(cwd):
    r = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-prefix"],
                       capture_output=True, text=True, timeout=10)
    if r.returncode != 0:
        raise subprocess.CalledProcessError(r.returncode, "git")
    return (r.stdout or "").replace("\\", "/").strip()


def _git_paths_in_cwd(cwd, names):
    """Git prints repo-root paths. Keep files inside cwd, relative to cwd."""
    prefix = _git_show_prefix(cwd)
    out = []
    seen = set()
    for name in names:
        if not name:
            continue
        n = str(name).replace("\\", "/")
        if n.startswith("./"):
            n = n[2:]
        if prefix:
            if n.startswith(prefix):
                n = n[len(prefix):]
            else:
                continue
        if n and n not in seen:
            seen.add(n)
            out.append(n)
    return out


def _git_changed_names(cwd, base):
    seen = []
    if base:
        seen.extend(_git_z_paths(cwd, ["diff", "-z", "--name-only", "--no-renames", "--diff-filter=ACDMRT", base]))
    seen.extend(_git_status_names(cwd))
    return _git_paths_in_cwd(cwd, seen)


def _path_fingerprint(root, name):
    p = Path(root) / name
    try:
        if p.is_symlink():
            return {"symlink": True}
        if not p.exists():
            return {"deleted": True}
        if not p.is_file():
            return {"skip": True}
        if p.stat().st_size > FILE_HASH_MAX:
            return {"sha256": None}
        return {"sha256": hashlib.sha256(p.read_bytes()).hexdigest()}
    except OSError:
        return {"sha256": None}


def _walk_rel_files(root, cap=FILES_WALK_CAP):
    names = []
    capped = False
    root = Path(root)
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [n for n in dirnames if n not in FILES_WALK_SKIP and not n.startswith(".")]
        rel_dir = os.path.relpath(dirpath, str(root))
        for fn in filenames:
            rel = fn if rel_dir == "." else str(Path(rel_dir) / fn)
            names.append(rel)
            if len(names) >= cap:
                return names, True
    return names, False


def _load_files_snap(d):
    path = files_snap_path(d)
    if not path.is_file():
        return None
    try:
        snap = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    return snap if isinstance(snap, dict) else None


def snapshot_git_head(st):
    cwd = st.get("cwd") or ""
    if not cwd:
        return
    r = subprocess.run(["git", "-C", cwd, "rev-parse", "HEAD"],
                       capture_output=True, text=True, timeout=10)
    if r.returncode == 0:
        st["_git_head"] = (r.stdout or "").strip() or None


def snapshot_worktree(d, st):
    """Record dirty/untracked (git) or existing files (not git) at the start of the run."""
    existing = _load_files_snap(d)
    if existing is not None:
        if existing.get("head"):
            st["_git_head"] = existing["head"]
        return
    cwd = st.get("cwd") or ""
    snap = {"git": False, "head": None, "files": {}, "capped": False}
    if cwd and Path(cwd).is_dir():
        try:
            git = subprocess.run(["git", "-C", cwd, "rev-parse", "--is-inside-work-tree"],
                                 capture_output=True, text=True, timeout=10)
            if git.returncode == 0 and git.stdout.strip() == "true":
                snap["git"] = True
                snapshot_git_head(st)
                snap["head"] = st.get("_git_head")
                for name in _git_changed_names(cwd, snap["head"]):
                    if name:
                        snap["files"][name] = _path_fingerprint(cwd, name)
            else:
                names, capped = _walk_rel_files(cwd)
                snap["capped"] = capped
                for name in names:
                    snap["files"][name] = _path_fingerprint(cwd, name)
        except GIT_READ_ERRORS:
            # A slow or failing git must not kill the run; the files receipt says it is incomplete.
            snap["undetermined"] = True
    files_snap_path(d).write_text(json.dumps(snap))


def _file_entry(name, fp):
    if not fp or fp.get("skip") or fp.get("symlink"):
        return None
    if fp.get("deleted"):
        return {"path": name, "deleted": True}
    return {"path": name, "sha256": fp.get("sha256")}


def write_files_receipt(d, st):
    cwd = st.get("cwd") or ""
    snap = _load_files_snap(d) or {}
    if snap.get("head") and not st.get("_git_head"):
        st["_git_head"] = snap["head"]
    snap_files = snap.get("files") if isinstance(snap.get("files"), dict) else {}
    undetermined = False
    names = set()
    if cwd and Path(cwd).is_dir():
        try:
            git = subprocess.run(["git", "-C", cwd, "rev-parse", "--is-inside-work-tree"],
                                 capture_output=True, text=True, timeout=10)
            is_git = git.returncode == 0 and git.stdout.strip() == "true"
            if is_git:
                names.update(_git_changed_names(cwd, st.get("_git_head") or snap.get("head")))
                names.update(snap_files)
            else:
                walked, capped = _walk_rel_files(cwd)
                names.update(walked)
                names.update(snap_files)
                if not snap or snap.get("capped") or capped:
                    undetermined = True
        except GIT_READ_ERRORS:
            names.update(snap_files)
            undetermined = True
    else:
        undetermined = True
    if not snap or snap.get("undetermined"):
        undetermined = True
    files = []
    for name in sorted(names):
        if not name or name.endswith("/"):
            continue
        now = _path_fingerprint(cwd, name) if cwd else {"deleted": True}
        before = snap_files.get(name)
        if before == now:
            continue
        entry = _file_entry(name, now)
        if entry:
            files.append(entry)
    data = {"files": files}
    if undetermined:
        data["undetermined"] = True
    return write_receipt(d, st, "files", data)


def cmd_verify(argv):
    if wants_help(argv) or not argv:
        sys.exit("usage: alexus verify ID [--head HASH]")
    rid, expected = None, None
    it = iter(argv)
    for a in it:
        if a == "--head":
            expected = next(it, None)
            if not expected:
                sys.exit("alexus verify: --head needs a hash")
        elif rid is None:
            rid = a
        else:
            sys.exit("usage: alexus verify ID [--head HASH]")
    d = run_dir(rid)
    path = receipts_path(d)
    st = load(d) or {}
    info = receipts_status(path, expected_head=expected, known_head=st.get("receipts_head"))
    if info["ok"]:
        print(f"intact {info['count']} receipts head {info['head']}")
        return 0
    if info["reason"] == "no receipts file":
        print(f"run {rid} has no receipts file")
        return 1
    loc = f"line {info['lineno']}" if info["lineno"] else "file"
    print(f"{path} {loc}: {info['reason']}")
    return 1


def _checklist_rows(d, records):
    """One row per checklist line. The chain decides which lines exist: the editable
    checklist files can only add a line that has no receipt yet, never remove one."""
    counts = {}
    by_claim = {}
    for rec in records:
        data = rec.get("data") if isinstance(rec.get("data"), dict) else {}
        if rec.get("type") == "checklist_frozen" and isinstance(data.get("claims"), list):
            frozen = {}
            for c in data["claims"]:
                claim = c.get("claim") if isinstance(c, dict) else None
                if isinstance(claim, str) and claim:
                    frozen[claim] = frozen.get(claim, 0) + 1
            for claim, n in frozen.items():
                counts[claim] = max(counts.get(claim, 0), n)
    for rec in records:
        data = rec.get("data") if isinstance(rec.get("data"), dict) else {}
        claim = data.get("claim")
        if rec.get("type") == "check_result" and isinstance(claim, str) and claim:
            by_claim.setdefault(claim, []).append(rec)
            counts.setdefault(claim, 1)
    try:
        has_files = (Path(d) / "checklist.md").exists() or (Path(d) / "checklist.frozen").exists()
        items = merged_checklist(d) if has_files else []
    except (OSError, ValueError):
        items = []
    in_files = {}
    for it in items:
        claim = redact_text(it.get("claim") or "")
        if claim:
            in_files[claim] = in_files.get(claim, 0) + 1
    for claim, n in in_files.items():
        counts[claim] = max(counts.get(claim, 0), n)
    rows = []
    for claim, n in counts.items():
        recs = (by_claim.get(claim) or [])[-n:]
        for i in range(n):
            rec = recs[i] if i < len(recs) else None
            rows.append({
                "claim": claim,
                "done": bool(rec and rec["data"].get("passed") is True),
                "seq": rec["seq"] if rec else None,
                "hash": rec["hash"] if rec else None,
            })
    return rows


def cmd_receipts(argv):
    if wants_help(argv) or not argv:
        sys.exit("usage: alexus receipts ID [--html FILE]")
    rid, html_path = None, None
    it = iter(argv)
    for a in it:
        if a == "--html":
            html_path = next(it, None)
            if not html_path:
                sys.exit("alexus receipts: --html needs a file")
        elif rid is None:
            rid = a
        else:
            sys.exit("usage: alexus receipts ID [--html FILE]")
    d = run_dir(rid)
    path = receipts_path(d)
    info = receipts_status(path)
    if info["reason"] == "no receipts file":
        print(f"run {rid} has no receipts file")
        return 1
    if not info["ok"]:
        loc = f"line {info['lineno']}" if info["lineno"] else "file"
        print(f"{path} {loc}: {info['reason']}")
        return 1
    rows = _checklist_rows(d, info["records"])
    head = info["head"] or RECEIPT_GENESIS
    keep = "Keep this head hash somewhere else. A rewritten receipts file can still chain."
    if html_path:
        Path(html_path).write_text(receipts_html_page(rid, rows, head, keep), encoding="utf-8")
        print(html_path)
        return 0
    for row in rows:
        mark = "DONE" if row["done"] else "NOT DONE"
        if row["seq"] is None:
            extra = "           -"
        else:
            extra = f"#{row['seq']:<10} {(row['hash'] or '')[:12]}"
        print(f"{mark:<8} {extra}  {row['claim']}")
    if not rows:
        print("(no checklist lines)")
    print(f"head {head}")
    print(keep)
    return 0


def receipts_html_page(rid, rows, head, keep):
    esc = html.escape
    body_rows = []
    for row in rows:
        mark = "DONE" if row["done"] else "NOT DONE"
        seq = "" if row["seq"] is None else str(row["seq"])
        short = (row["hash"] or "")[:12]
        body_rows.append(
            "<tr>"
            f"<td>{esc(mark)}</td>"
            f"<td>{esc(seq)}</td>"
            f"<td>{esc(short)}</td>"
            f"<td>{esc(row['claim'])}</td>"
            "</tr>"
        )
    inner = "\n".join(body_rows) or "<tr><td colspan=\"4\">(no checklist lines)</td></tr>"
    return (
        "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
        f"<title>Receipts {esc(str(rid))}</title>\n"
        "<style>\n"
        ":root { color-scheme: light dark; }\n"
        "body { font-family: system-ui, sans-serif; margin: 0 auto; padding: 1rem;"
        " max-width: 40rem; line-height: 1.4; }\n"
        "h1 { font-size: 1.2rem; }\n"
        "table { width: 100%; border-collapse: collapse; }\n"
        "th, td { text-align: left; padding: 0.4rem 0.5rem; border-bottom: 1px solid #888;"
        " vertical-align: top; word-break: break-word; }\n"
        ".head { font-family: ui-monospace, monospace; word-break: break-all; }\n"
        "@media (prefers-color-scheme: dark) {\n"
        "  body { background: #111; color: #eee; }\n"
        "  th, td { border-color: #555; }\n"
        "}\n"
        "</style>\n</head>\n<body>\n"
        f"<h1>Receipts {esc(str(rid))}</h1>\n"
        "<table>\n<thead><tr><th>Status</th><th>Seq</th><th>Hash</th><th>Claim</th></tr></thead>\n"
        f"<tbody>\n{inner}\n</tbody>\n</table>\n"
        f"<p>head <span class=\"head\">{esc(head)}</span></p>\n"
        f"<p>{esc(keep)}</p>\n"
        "</body>\n</html>\n"
    )



def describe(name, inp):
    v = VERB.get(name, "using " + name)
    what = (inp.get("file_path") or inp.get("target_file") or inp.get("notebook_path") or inp.get("path")
            or inp.get("pattern") or inp.get("command") or inp.get("url") or inp.get("query")
            or inp.get("description") or "")
    if name in FILE_TOOLS:
        what = str(what).replace(str(Path.home()), "~", 1)
    return v, one(what, 140)


def _todo_item(t):
    step = t.get("content") or t.get("subject")
    doing = t.get("activeForm")
    out = {"status": t.get("status") or "pending"}
    if t.get("id") is not None:
        out["id"] = str(t.get("id"))
    if step:
        out["step"] = one(step, 200)
    if doing:
        out["doing"] = one(doing, 200)
    return out


def plan_from(name, inp, plan):
    """TodoWrite replaces the whole list (merge keeps items by id). TaskCreate/TaskUpdate add or change one item.
    Muse write_todos sends the full list every time: {todos: [{text, status}]}."""
    if name == "write_todos" and isinstance(inp.get("todos"), list):
        return [{"step": one(t.get("text") or t.get("step") or "", 200), "doing": "",
                 "status": t.get("status") or "pending"}
                for t in inp["todos"] if isinstance(t, dict)]
    if name in ("TodoWrite", "todo_write") and isinstance(inp.get("todos"), list):
        items = [_todo_item(t) for t in inp["todos"] if isinstance(t, dict)]
        if inp.get("merge") and plan:
            by_id = {str(s.get("id")): i for i, s in enumerate(plan) if s.get("id")}
            for it in items:
                i = by_id.get(str(it.get("id"))) if it.get("id") else None
                if i is None:
                    plan.append(dict(it, step=it.get("step") or ""))
                else:
                    plan[i] = dict(plan[i], **it)
            return plan
        return [dict(it, step=it.get("step") or "", doing=it.get("doing") or "") for it in items]
    if name == "TaskCreate":
        return plan + [{"step": one(inp.get("subject") or inp.get("description"), 200),
                        "doing": one(inp.get("activeForm"), 200), "status": "pending"}]
    if name == "TaskUpdate":
        try:
            i = int(str(inp.get("taskId", "")).strip().lstrip("#")) - 1   # "Task #1 created" -> ids count from 1
            if 0 <= i < len(plan):
                ch = {k: inp[k] for k in ("status",) if inp.get(k)}
                if inp.get("subject"):
                    ch["step"] = one(inp["subject"], 200)
                if inp.get("activeForm"):
                    ch["doing"] = one(inp["activeForm"], 200)
                plan[i] = dict(plan[i], **ch)
        except ValueError:
            pass
    return plan


def proof_extra(st):
    """The proved-mode instructions for this run, the same for every runner. Empty for a plain run."""
    if st.get("mode") != "proved" or not st.get("_dir"):
        return ""
    ckp = Path(st["_dir"]) / "checklist.md"
    frozen = ckp.parent / "checklist.frozen"
    if st.get("given_checklist") and frozen.exists():
        return DO_GUIDE.format(ck=ckp, cwd=st["cwd"], items=frozen.read_text().strip(), owner=owner_name()) + domain_text(st.get("domain"))
    return PROOF_GUIDE.format(ck=ckp, cwd=st["cwd"], t=CHECK_TIMEOUT, owner=owner_name()) + domain_text(st.get("domain"))


def launch_cmd(st, prompt=None, resume=None, guide=None, tools=None):
    """The CLI argv for this run (or one more leg of it). Does not start it."""
    who = st.get("who") or "claude"
    prompt = prompt or st["task"]
    if who == "grok":
        cmd = [cli_bin("grok"), "--cwd", st["cwd"], "-p", prompt,
               "--output-format", "streaming-messages-json",
               "--always-approve", "--no-plan",
               "--rules", guide or (grok_guide() + proof_extra(st)),
               "--disallowed-tools", GROK_OFF]
        if resume:
            cmd += ["--resume", resume]
    elif who == "muse":
        # muse exec is headless: --yolo = no approval prompts + sandbox off + workspace trusted for this run;
        # request_user_input is withheld so it can never wait on a person. The guide rides in the prompt (no system flag).
        if resume:      # muse exec has no resume here: a send-back is a fresh process, so it needs the task again
            prompt = f"Original task: {st['task']}\n\nYou already worked on this in this folder. Now: {prompt}"
        cmd = [cli_bin("muse"), "exec", "--json", "--yolo", "--disable-request-user-input",
               "--workspace", st["cwd"], (guide or (muse_guide() + proof_extra(st))) + "\n\nTask: " + prompt]
    elif who == "codex":
        # --approve-for-me routes approvals through review in the workspace-write sandbox.
        provider = (st.get("provider") or "").lower()
        if guide:       # the critic: looks, never changes
            cmd = [cli_bin("codex"), "exec", "--json", "--sandbox", "read-only", "--skip-git-repo-check"]
            prompt = guide + "\n\n" + prompt
        else:
            cmd = [cli_bin("codex"), "exec", "--json", "--approve-for-me", "--skip-git-repo-check"]
            if st.get("mode") == "proved" and st.get("_dir"):   # the checklist lives outside the workspace sandbox
                cmd += ["-c", "sandbox_workspace_write.writable_roots=" + json.dumps([st["_dir"]])]
        if "ollama" in provider:
            cmd += ["--oss", "--local-provider", "ollama"]
        elif "lmstudio" in provider or "lm-studio" in provider:
            cmd += ["-c", "model_provider=lmstudio", "--oss", "--local-provider", "lmstudio"]
        cmd += ["--cd", st["cwd"]]
        if resume:
            cmd += ["resume", resume, prompt]
        else:
            cmd += [prompt + ("" if guide else "\n\n" + APP_LOG_GUIDE + proof_extra(st))]
    else:
        if guide is None:
            guide = claude_guide() + proof_extra(st)
        cmd = [cli_bin("claude"), "-p", prompt, "--output-format", "stream-json", "--verbose",
               "--permission-mode", "auto", "--append-system-prompt", guide,
               "--tools", tools or TOOLS]
        walls_settings = Path(st.get("_dir") or "/nonexistent") / "walls-settings.json"
        if tools is None and enforced_walls(st) and walls_settings.exists():
            cmd += ["--settings", str(walls_settings)]
        if resume:
            cmd += ["--resume", resume]
    if st.get("model"):
        if who == "muse":
            cmd = cmd[:-1] + ["--model", st["model"], cmd[-1]]   # options before the prompt, not after it
        elif who == "codex":
            cmd[2:2] = ["--model", st["model"]]
        else:
            cmd += ["--model", st["model"]]
    return cmd


def note_tool(st, tools, name, inp, tid):
    """Record one tool call on the tracker. tools maps the CLI's id to an actions index."""
    v, what = describe(name, inp if isinstance(inp, dict) else {})
    st["plan"] = plan_from(name, inp if isinstance(inp, dict) else {}, st["plan"])
    i = inp if isinstance(inp, dict) else {}
    if name == "TaskCreate":
        v, what = "planned step:", one(i.get("subject") or i.get("description"), 140)
    elif name == "TaskUpdate":
        k = str(i.get("taskId", "")).lstrip("#")
        label = st["plan"][int(k) - 1]["step"] if k.isdigit() and 0 < int(k) <= len(st["plan"]) else k
        v, what = f"step {k} →", f"{i.get('status') or 'changed'}: {label}"
    elif name in ("TaskList", "TaskGet"):
        v, what = "checking the plan", ""
    elif name in ("TodoWrite", "todo_write"):
        bits = [f"{t.get('content') or t.get('subject') or t.get('id')}: {t.get('status') or 'pending'}"
                for t in (i.get("todos") or []) if isinstance(t, dict)]
        v, what = "updating the plan", one(", ".join(bits), 140)
    elif name == "write_todos":
        bits = [f"{t.get('text') or t.get('step') or ''}: {t.get('status') or 'pending'}"
                for t in (i.get("todos") or []) if isinstance(t, dict)]
        v, what = "updating the plan", one(", ".join(bits), 140)
    st["actions"].append({"at": now(), "kind": "tool", "tool": name, "what": f"{v} {what}".strip(), "result": None})
    if tid:
        tools[tid] = len(st["actions"]) - 1
    st["tools"] += 1
    st["now"] = f"{v} {what}".strip()
    run_folder = st.get("_dir")
    if run_folder and not st.get("_chain_broken"):
        write_receipt(run_folder, st, "tool_call", {
            "tool": name,
            "target": redact_text(one(what, 140)),
            "input_sha256": sha256_json(inp if inp is not None else {}),
        })


def note_text(st, ctx, text):
    text = (text or "").strip()
    if not text:
        return
    st["remark"] = one(text, 600)
    if len(text) > 20:
        ctx["summary"] = text
    st["actions"].append({"at": now(), "kind": "said", "what": one(text, 300)})


def apply_muse_event(st, e, tools, ctx):
    """Fold one Muse MSP record (muse exec --json) into the tracker.

    Shapes seen on the wire (Muse Code 1.4.x): every line is {stream:{kind,id}, payload_type, payload}.
    Session id rides on stream.id; tool calls arrive as payload.event.kind=assistant_tool_calls_committed
    (tool_calls[].{call_id,name,args-as-JSON-string}); tool outcomes as payload_type=tool_batch.effect.terminal
    (record.{call_id,outcome.kind}); assistant text as payload.kind=run_output_delta chunks; the end as
    payload.kind=run_terminal ({terminal, text}). Everything else is runtime bookkeeping and is ignored here
    (it stays in events.jsonl)."""
    stream = e.get("stream") or {}
    if stream.get("kind") == "session" and stream.get("id"):
        if not st.get("session"):
            st.update(session=stream["id"], now="agent ready")
    payload = e.get("payload") or {}
    ev = payload.get("event") or {}
    kind = ev.get("kind") or payload.get("kind")
    if kind == "assistant_tool_calls_committed":
        for tc in ev.get("tool_calls") or []:
            try:
                inp = json.loads(tc.get("args") or "{}")
            except ValueError:
                inp = {}
            note_tool(st, tools, tc.get("name") or "?", inp if isinstance(inp, dict) else {}, tc.get("call_id"))
    elif kind == "tool_result":        # newer Muse reports each tool as a tool.result record instead
        note_tool(st, tools, payload.get("tool_name") or payload.get("name") or "tool", {},
                  payload.get("call_id") or payload.get("command_id"))
    elif e.get("payload_type") == "tool_batch.effect.terminal":
        rec = payload.get("record") or {}
        k = tools.get(rec.get("call_id"))
        bad = (rec.get("outcome") or {}).get("kind") not in (None, "completed")
        if bad:
            st["errors"] += 1
        if k is not None and k < len(st["actions"]):
            st["actions"][k]["result"] = "error" if bad else "ok"
    elif kind == "run_output_delta":
        text = payload.get("text") or ""
        if text:
            ctx["muse_text"] = ctx.get("muse_text", "") + text
            st["remark"] = one(ctx["muse_text"], 600)
            st["now"] = one(ctx["muse_text"].splitlines()[-1] if ctx["muse_text"].splitlines() else "", 140) or st["now"]
    elif kind == "run_terminal":
        text = (payload.get("text") or ctx.get("muse_text") or "").strip()
        failed = payload.get("terminal") not in (None, "completed")
        if text:
            ctx["summary"] = text
        st.update(final=text or st.get("final") or "", status="failed" if failed else "done")
    elif kind == "model_completed":
        st["turns"] = (st.get("turns") or 0) + 1
    if len(st["actions"]) > MAX_ACTIONS:
        drop = len(st["actions"]) - MAX_ACTIONS
        st["actions"] = st["actions"][drop:]
        tools_left = {k: v - drop for k, v in tools.items() if v - drop >= 0}
        tools.clear()
        tools.update(tools_left)


def apply_codex_event(st, e, tools, ctx):
    """Fold Codex exec --json events into the common run tracker."""
    kind = e.get("type") or ""
    if kind == "thread.started":
        st.update(session=e.get("thread_id") or st.get("session"), now="agent ready")
    elif kind == "turn.started":
        st["now"] = "working"
    elif kind in ("item.started", "item.updated", "item.completed"):
        item = e.get("item") or {}
        typ, iid = item.get("type") or "", item.get("id")
        if typ in ("command_execution", "file_change", "web_search", "mcp_tool_call"):
            if kind == "item.started":
                name = {"command_execution": "Bash", "file_change": "Edit", "web_search": "WebSearch",
                        "mcp_tool_call": item.get("tool") or "MCP"}.get(typ, typ)
                raw = {"command": item.get("command") or item.get("title") or "",
                       "path": item.get("path") or item.get("title") or ""}
                note_tool(st, tools, name, raw, iid)
            elif kind == "item.completed" and iid in tools:
                action = st["actions"][tools[iid]]
                failed = item.get("exit_code") not in (None, 0) or item.get("status") in ("failed", "error")
                action["result"] = "error" if failed else "ok"
                if failed: st["errors"] += 1
        if kind == "item.completed" and typ == "agent_message":
            note_text(st, ctx, item.get("text") or "")
    elif kind == "turn.completed":
        text = (ctx.get("summary") or st.get("remark") or "").strip()
        st.update(final=text or st.get("final") or "Codex finished.", status="done")
    elif kind in ("turn.failed", "error"):
        err = e.get("error") or {}
        st.update(status="failed", final=one(err.get("message") or e.get("message") or "Codex run failed", 2000))
    if len(st["actions"]) > MAX_ACTIONS:
        drop = len(st["actions"]) - MAX_ACTIONS
        st["actions"] = st["actions"][drop:]
        tools_left = {k: v - drop for k, v in tools.items() if v - drop >= 0}
        tools.clear()
        tools.update(tools_left)


def apply_event(st, e, tools, ctx):
    """Fold one stream line into the tracker. Claude stream-json and Grok streaming-messages-json share a shape.
    Grok's own streaming-json types (tool_call, text, plan, end) are accepted too. Muse MSP records
    (any line carrying a payload) go to apply_muse_event."""
    if (st.get("who") or "claude") == "codex":
        apply_codex_event(st, e, tools, ctx)
        return
    if "payload" in e or e.get("payload_type"):
        apply_muse_event(st, e, tools, ctx)
        return
    t, sub = e.get("type"), e.get("subtype")
    if t == "system" and sub == "init":
        st.update(session=e.get("session_id") or st.get("session"), model=e.get("model") or st.get("model"),
                  now="agent ready")
    elif t == "system" and sub in ("thinking_tokens", "notification", "status"):
        pass
    elif t == "system" and sub in ("task_started", "task_notification") and not e.get("is_backgrounded"):
        pass    # a foreground Bash call announcing itself: the tool row already shows it
    elif t == "system":
        st["actions"].append({"at": now(), "kind": "system", "what": one(sub or "system event", 140)})
    elif t == "assistant":
        for c in (e.get("message") or {}).get("content") or []:
            if c.get("type") == "tool_use":
                note_tool(st, tools, c.get("name", "?"), c.get("input") or {}, c.get("id"))
            elif c.get("type") == "text":
                note_text(st, ctx, c.get("text") or "")
    elif t == "user":
        content = (e.get("message") or {}).get("content")
        if isinstance(content, str) and (any(w in content.lower() for w in ("hook", "referee", "auditor")) or "📯" in content or "🟧" in content):
            st["hook_blocks"] += 1
            st["actions"].append({"at": now(), "kind": "hook", "what": one(content, 300)})
        for c in content if isinstance(content, list) else []:
            if isinstance(c, dict) and c.get("type") == "tool_result":
                k = tools.get(c.get("tool_use_id"))
                bad = bool(c.get("is_error"))
                if bad:
                    st["errors"] += 1
                if k is not None and k < len(st["actions"]):
                    st["actions"][k]["result"] = "error" if bad else "ok"
            elif isinstance(c, dict) and c.get("type") == "text":
                txt = c.get("text") or ""
                if any(w in txt.lower() for w in ("hook", "referee", "auditor")) or "📯" in txt or "🟧" in txt:
                    st["hook_blocks"] += 1
                    st["actions"].append({"at": now(), "kind": "hook", "what": one(txt, 300)})
    elif t == "result":
        res = (e.get("result") or "").strip()
        st.update(final=res if len(res) > 20 or not ctx["summary"] else ctx["summary"],
                  cost_usd=e.get("total_cost_usd"), turns=e.get("num_turns"),
                  status="failed" if e.get("is_error") else "done")
        if e.get("session_id"):
            st["session"] = e.get("session_id")
    elif t == "tool_call":
        note_tool(st, tools, e.get("toolName") or e.get("title") or "?", e.get("rawInput") or {}, e.get("toolCallId"))
    elif t == "tool_call_update":
        k = tools.get(e.get("toolCallId"))
        bad = (e.get("status") or "") in ("failed", "error")
        if bad:
            st["errors"] += 1
        if k is not None and k < len(st["actions"]):
            st["actions"][k]["result"] = "error" if bad else "ok"
    elif t == "text":
        note_text(st, ctx, e.get("data") or "")
    elif t == "plan" and isinstance(e.get("entries"), list):
        st["plan"] = [{"step": one(ent.get("content") or ent.get("step") or ent.get("subject"), 200),
                       "doing": one(ent.get("activeForm") or ent.get("doing"), 200),
                       "status": ent.get("status") or "pending"}
                      for ent in e["entries"] if isinstance(ent, dict)]
        st["now"] = "updated the plan"
    elif t == "end":
        reason = e.get("stopReason") or "end_turn"
        text = (ctx.get("summary") or st.get("remark") or "").strip()
        st.update(final=st.get("final") or text, cost_usd=e.get("total_cost_usd", st.get("cost_usd")),
                  turns=e.get("num_turns", st.get("turns")),
                  session=e.get("sessionId") or st.get("session"),
                  status="done" if reason == "end_turn" else "failed")
    elif t == "error":
        st.update(status="failed", final=one(e.get("message") or "grok error", 2000))
    if len(st["actions"]) > MAX_ACTIONS:
        drop = len(st["actions"]) - MAX_ACTIONS
        st["actions"] = st["actions"][drop:]
        tools_left = {k: v - drop for k, v in tools.items() if v - drop >= 0}
        tools.clear()
        tools.update(tools_left)



# ------------------------------------------------------------------ proved mode
MAX_ROUNDS = 4
CHECK_TIMEOUT = 120
STEP_RE = re.compile(r"^\s*- \[[ xX]\] (.*?) :: verify: (.*?)(?: :: expect: (.*))?\s*$")
# Checks run what the agent wrote, outside Claude's permission check, so they run read-only.
SANDBOX = """(version 1)
(allow default)
(deny file-write* (subpath "/"))
(allow file-write* (subpath "/private/tmp") (subpath "/private/var/folders") (literal "/dev/null")
       (literal "/dev/tty") (regex #"^/dev/fd/"))
(deny process-exec (regex #"/(ssh|scp|sftp|rsync)$"))
"""

# ------------------------------------------------------------------ the domain: outcome, proof, walls
# A task can come with its domain (--domain). The domain says WHAT must be true, HOW that
# is shown and what must NOT be crossed; never which clicks, scripts or order (that is the agent's thinking).
# This program enforces it: every proof needs its own checked line before a run can be proved, and walls written in a
# form the runner knows are blocked before the move happens (Claude runs only; other runners can't be held to them).
#   no-network            Bash runs in a macOS sandbox with no outbound network; web and MCP tools are refused
#   read-only             Bash sandboxed with no file writes (temp folders and the run's own folder excepted);
#                         Write/Edit refused outside the run folder
#   write-only: A, B      as read-only, but these paths may be written too
#   app-only: Safari, …   Bash commands that drive another app (tell application/process, Application(), open -a/-b)
#                         are refused (checked on the command text before it runs; the sandbox can't filter apps)
#   deny: <regex>         any tool call whose input matches is refused
#   once: <regex>         the first matching tool call is allowed, every later one is refused ("Click Post once")
#   no-tool: A, B         these tools are refused
# Any other wall is plain text: it goes in the brief and the critic sees it, but nothing blocks it.
NET_TOOLS = {"webfetch", "websearch", "listmcpresourcestool", "readmcpresourcetool", "readmcpresourcedirtool"}
WRITE_TOOLS = {"write", "edit", "notebookedit"}
LABEL_RE = re.compile(r"^\s*(P\d+)\b", re.I)
APP_RES = [re.compile(r"""tell\s+application\s+(?:id\s+)?["']([^"']+)["']""", re.I),
           re.compile(r"""tell\s+process\s+["']([^"']+)["']""", re.I),
           re.compile(r"""Application\(\s*\\?["']([^"'\\]+)\\?["']\s*\)"""),
           re.compile(r"""\bopen\s+(?:-\w+\s+)*-a\s+(?:"([^"]+)"|'([^']+)'|(\S+))"""),
           re.compile(r"""\bopen\s+(?:-\w+\s+)*-b\s+(\S+)""")]
# Planning and bookkeeping: their text describes moves, they aren't moves. Walls don't apply to them.
BOOKKEEPING_TOOLS = {"taskcreate", "taskupdate", "tasklist", "taskget", "todowrite", "todo_write", "write_todos",
                     "toolsearch", "search_tool"}


def bookkeeping(st, name, inp):
    """True for planning tools and Write/Edit into the run's own folder (checklist.md)."""
    low = (name or "").lower()
    if low in BOOKKEEPING_TOOLS:
        return True
    inp = inp if isinstance(inp, dict) else {}
    if low in WRITE_TOOLS:
        path = os.path.realpath(os.path.expanduser(str(inp.get("file_path") or inp.get("notebook_path") or "/nonexistent")))
        return path.startswith(os.path.realpath(st["_dir"]) + "/")
    return False


CHECKLIST_SHELL_WRITE = re.compile(r"""(>>?|\btee\b(\s+-a)?|\bsed\s+-i|\bcp\b|\bmv\b)\s*['"]?[^\s'";|&]*checklist\.md""")
APP_CONTAINERS = {"system events"}   # needed to click inside the allowed app; `tell process "X"` is checked itself


def parse_wall(text):
    t = " ".join(str(text).split())
    low = t.lower()
    if low in ("no-network", "read-only"):
        return {"text": t, "kind": low, "enforced": True}
    m = re.match(r"^(write-only|app-only|deny|once|no-tool)\s*:\s*(.+)$", t, re.I)
    if not m:
        return {"text": t, "kind": "text", "enforced": False}
    kind, arg = m.group(1).lower(), m.group(2).strip()
    w = {"text": t, "kind": kind, "arg": arg, "enforced": True}
    if kind in ("deny", "once"):
        try:
            re.compile(arg, re.I)
        except re.error as e:
            return {"text": t, "kind": "text", "enforced": False, "why": f"bad regex: {e}"}
    else:
        w["items"] = [x.strip() for x in arg.split(",") if x.strip()]
    return w


def load_domain(raw, require_proof=True):
    """Check a domain (dict or JSON text) and give it labels: proofs P1.., walls parsed. Raises ValueError.

    require_proof=False is for an approved checklist plus walls: the checklist is the exam, so proofs may be empty.
    """
    d = json.loads(raw) if isinstance(raw, str) else raw
    if not isinstance(d, dict):
        raise ValueError("the domain must be a JSON object")
    outcome = " ".join(str(d.get("outcome") or "").split())
    proofs = d.get("proof") or []
    walls = d.get("walls") or []
    if not outcome:
        raise ValueError("the domain needs an outcome")
    if not isinstance(proofs, list) or not all(isinstance(x, (str, dict)) for x in proofs):
        raise ValueError("the domain needs at least one proof")
    if not isinstance(walls, list):
        raise ValueError("walls must be a list")
    if not proofs and require_proof:
        raise ValueError("the domain needs at least one proof")
    out = []
    for i, p in enumerate(proofs, 1):
        text = p.get("text") if isinstance(p, dict) else p
        text = re.sub(r"^\s*(?:- \[[ xX]\]\s*)?", "", " ".join(str(text).split()))
        text = LABEL_RE.sub("", text).lstrip(":.) ").strip() if LABEL_RE.match(text) else text
        if not text:
            continue
        m = STEP_RE.match(f"- [ ] P{i}: {text}")
        out.append({"label": f"P{i}", "text": text, "checked": bool(m and m.group(2).strip())})
    if not out and require_proof:
        raise ValueError("the domain needs at least one proof")
    parsed = [w if isinstance(w, dict) and "kind" in w else parse_wall(w) for w in walls if str(w).strip()]
    return {"outcome": outcome, "proof": out, "walls": parsed}


def enforced_walls(st):
    return [w for w in ((st.get("domain") or {}).get("walls") or []) if w.get("enforced")]


def domain_seed(dom):
    """Checklist lines for proofs that already carry their command; frozen before the agent starts."""
    return "".join(f"- [ ] {p['label']}: {p['text']}\n" for p in dom["proof"] if p["checked"])


def missing_proofs(st, items):
    dom = st.get("domain")
    if not dom:
        return []
    have = {m.group(1).upper() for c in items for m in [LABEL_RE.match(c["claim"])] if m}
    return [p for p in dom["proof"] if p["label"].upper() not in have]


def domain_text(dom, for_critic=False):
    if not dom:
        return ""
    lines = ["", "THE DOMAIN OF THIS TASK (set by whoever asked; this program holds the run to it):",
             f"OUTCOME (what must be true when done): {dom['outcome']}", "PROOF (each needs its own checked line):"]
    lines += [f"  {p['label']}: {p['text']}" + ("  [already in the checklist]" if p["checked"] else "")
              for p in dom["proof"]]
    if dom.get("walls"):
        lines.append("WALLS (never cross these):")
        for w in dom["walls"]:
            lines.append(f"  - {w['text']}  " + ("[enforced: this program blocks moves that cross it]" if w.get("enforced")
                                                 else "[not machine-enforced: honour it anyway]"))
    if for_critic:
        lines.append("Also check the outcome is really true and that no wall was crossed (look at what it did).")
    else:
        lines += ["For every proof, your checklist must have a line whose claim starts with its label, e.g.",
                  "  - [ ] P2: <what is true> :: verify: <command>      (verify: HUMAN only if only the operator can judge it)",
                  "A run is not proved until every label has a line and every line passes.",
                  "If the outcome can't be reached inside the walls, stop and say which wall stops you.",
                  "How you get there (which tools, clicks, scripts, in what order) is yours to decide. Take the shortest",
                  "path to the outcome and its proof; don't explore beyond it."]
    return "\n".join(lines) + "\n"


def wall_paths(st, w):
    out = []
    for x in w.get("items") or []:
        x = os.path.expanduser(x)
        out.append(os.path.realpath(x if os.path.isabs(x) else os.path.join(st["cwd"], x)))
    return out


def walls_sandbox(st):
    """The sandbox profile Bash commands run under, or None when no wall needs one."""
    ws = enforced_walls(st)
    kinds = {w["kind"] for w in ws}
    if not kinds & {"no-network", "read-only", "write-only"}:
        return None
    lines = ["(version 1)", "(allow default)"]
    if "no-network" in kinds:
        lines.append("(deny network-outbound (remote ip))")
    if kinds & {"read-only", "write-only"}:
        ok = ['(subpath "/private/tmp")', '(subpath "/private/var/folders")', '(literal "/dev/null")',
              '(literal "/dev/tty")', '(regex #"^/dev/fd/")', f'(subpath {json.dumps(os.path.realpath(st["_dir"]))})']
        for w in ws:
            if w["kind"] == "write-only":
                ok += [f"(subpath {json.dumps(p)})" for p in wall_paths(st, w)]
        lines += ['(deny file-write* (subpath "/"))', "(allow file-write* " + " ".join(ok) + ")"]
    return "\n".join(lines) + "\n"


def apps_in(cmd):
    out = []
    for rx in APP_RES:
        for m in rx.finditer(cmd or ""):
            out.append(next(g for g in m.groups() if g))
    return out


def wall_decision(st, name, inp, mode="hook"):
    """None if the move is inside the walls, else (wall, reason). mode 'hook' also counts once-walls (before the move);
    'backstop' leaves once-walls to the caller."""
    inp = inp if isinstance(inp, dict) else {}
    # deny/once judge moves. For Write/Edit the move is the path; the text being written is a document, and a README
    # that says "run wrangler deploy" is not running it.
    blob = (json.dumps({"path": inp.get("file_path") or inp.get("notebook_path")}) if (name or "").lower() in WRITE_TOOLS
            else json.dumps(inp, sort_keys=True))
    cmd = str(inp.get("command") or inp.get("cmd") or "")
    low = (name or "").lower()
    own = bookkeeping(st, name, inp)
    walls = enforced_walls(st)
    if walls and not own and CHECKLIST_SHELL_WRITE.search(cmd):
        # through the shell a checklist write can carry a real move with it; the Write tool can't, so it's exempt
        return {"text": "checklist via the Write tool"}, ("write checklist.md with the Write tool, not the shell "
                                                          "(Write to the run's own folder is exempt from the walls)")
    if own:          # the run's own bookkeeping (checklist.md): its text mentions the moves, it isn't one
        return None
    for i, w in enumerate(walls):
        k = w["kind"]
        if k == "no-tool" and low in {x.lower() for x in w["items"]}:
            return w, f"the tool {name} is not allowed"
        if k == "no-network" and (low in NET_TOOLS or low.startswith("mcp__")):
            return w, f"{name} reaches the network"
        if k in ("read-only", "write-only") and low in WRITE_TOOLS:
            path = os.path.realpath(os.path.expanduser(str(inp.get("file_path") or inp.get("notebook_path") or "")))
            okp = [os.path.realpath(st["_dir"])] + (wall_paths(st, w) if k == "write-only" else [])
            if not any(path == q or path.startswith(q.rstrip("/") + "/") for q in okp):
                return w, f"writing {path} is outside the walls"
        if k == "app-only" and cmd:
            allowed = {x.lower() for x in w["items"]}
            bad = [a for a in apps_in(cmd) if a.lower() not in allowed and a.lower() not in APP_CONTAINERS
                   and not any(a.lower() in (f"com.apple.{x}", x) for x in allowed)]
            if bad:
                return w, f"the command drives {', '.join(sorted(set(bad)))}"
        if k == "deny" and re.search(w["arg"], blob, re.I):
            return w, "the move matches a denied pattern"
    for i, w in enumerate(walls):    # once-walls last: a move another wall refuses must not use up the one allowed
        k = w["kind"]
        if k == "once" and mode == "hook" and re.search(w["arg"], blob, re.I):
            mark = Path(st["_dir"]) / f"once-{i}.used"
            try:
                fd = os.open(mark, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)   # atomic: only the first gets it
                os.write(fd, blob.encode()[:4000])
                os.close(fd)
            except FileExistsError:
                return w, "this may happen only once and it already did"
    return None


def wall_hook(hook_dir):
    """PreToolUse hook for a walled Claude run: exit 2 refuses the move before it happens and tells the agent why."""
    root = agents_dir()
    try:
        if not _inside_state(Path(hook_dir), root):
            return 2
    except Exception:
        return 2
    try:
        e = json.load(sys.stdin)
    except ValueError:
        return 0
    st = load(Path(hook_dir)) or {}
    st["_dir"] = hook_dir
    if not st.get("domain"):
        return 0
    hit = wall_decision(st, e.get("tool_name"), e.get("tool_input"))
    if not hit:
        return 0
    w, why = hit
    with open(Path(hook_dir) / "walls.log", "a") as f:
        f.write(json.dumps({"at": now(), "tool": e.get("tool_name"), "wall": w["text"], "why": why,
                            "input": one(json.dumps(e.get("tool_input")), 400)}) + "\n")
    print(f"Blocked by the task's wall \"{w['text']}\": {why}. Reach the outcome inside the walls, "
          "or stop and say which wall stops you.", file=sys.stderr)
    return 2


def prepare_walls(d, st):
    """Write the per-run hook settings, sandbox profile and shell prefix. Returns extra env for the agent's legs."""
    if not enforced_walls(st):
        return {}
    me = os.path.abspath(__file__)
    hook = f"/usr/bin/python3 -I {shlex.quote(me)} wall-hook {shlex.quote(str(d))}"
    (d / "walls-settings.json").write_text(json.dumps(
        {"hooks": {"PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": hook}]}]}}))
    prof = walls_sandbox(st)
    if not prof:
        return {}
    (d / "walls.sb").write_text(prof)
    pre = d / "walls-shell.sh"
    # Claude passes every shell command it runs (Bash tool calls, but also hooks and MCP servers) as one string.
    # Only Bash tool calls (they source Claude's shell snapshot first) go in the sandbox.
    pre.write_text("#!/bin/bash\n"
                   'case "$1" in\n'
                   f'  *"/.claude/shell-snapshots/snapshot-"*) exec /usr/bin/sandbox-exec -f {shlex.quote(str(d / "walls.sb"))} /bin/zsh -c "$1" ;;\n'
                   '  *) exec /bin/zsh -c "$1" ;;\n'
                   "esac\n")
    pre.chmod(0o700)
    return {"CLAUDE_CODE_SHELL_PREFIX": str(pre)}


def wall_backstop(st, e, seen):
    """After the fact, for the case a block didn't hold: a move across a wall that came back as a success.
    Returns the reason, or None. seen: tool id -> (name, input), plus once-wall counts."""
    if (st.get("who") or "claude") != "claude" or not enforced_walls(st):
        return None
    msg = e.get("message") or {}
    for c in msg.get("content") or [] if isinstance(msg.get("content"), list) else []:
        if not isinstance(c, dict):
            continue
        if c.get("type") == "tool_use":
            seen[c.get("id")] = (c.get("name"), c.get("input") or {})
        elif c.get("type") == "tool_result" and not c.get("is_error") and c.get("tool_use_id") in seen:
            name, inp = seen.pop(c.get("tool_use_id"))
            if bookkeeping(st, name, inp):
                continue
            hit = wall_decision(st, name, inp, mode="backstop")
            if hit:
                return f"crossed the wall \"{hit[0]['text']}\" ({hit[1]}) with {name}"
            blob = json.dumps(inp, sort_keys=True)
            for i, w in enumerate(enforced_walls(st)):
                if w["kind"] == "once" and re.search(w["arg"], blob, re.I):
                    seen[f"once-{i}"] = seen.get(f"once-{i}", 0) + 1
                    if seen[f"once-{i}"] > 1:
                        return f"crossed the wall \"{w['text']}\" (it happened twice) with {name}"
    return None


PROOF_GUIDE = """
PROOF (proved mode): your own "done" is not believed. Before you change anything, write the file
{ck} with one line per thing that must be true when you're finished:
- [ ] <what must be true> :: verify: <shell command that exits 0 only when it is true>
Optionally end a line with  :: expect: <regex the command's output must match>. Use  :: verify: HUMAN  only for what
only {owner} can judge (taste, "is this the right one", something on another device). Make the commands strict enough
that empty or fake work fails them. They run in {cwd}, read-only (no writes outside temp folders, no ssh, scp or
rsync), with a {t} s limit each, so prove things on this computer: files, git, curl, test, grep, jq.
That file is frozen the first time you write it: later you can add lines, but a line you remove or change comes back
as first written. When you finish, this program runs every command itself; failures come back to you with the output.
Then a separate critic tries to prove you wrong."""

DO_GUIDE = """
PROOF (proved mode): the person who started this run already agreed the checklist this work will be judged by, in {ck}:
{items}
Your job is only to do the work so every line is really true. Do not edit that file (changes are ignored). When you
finish, this program runs every command itself, read-only, in {cwd}; failures come back to you with the output. Then a
separate critic tries to prove you wrong. HUMAN lines are for {owner}: leave them, and say in LEFT what they should check."""

CRITIC_GUIDE = """You are the critic in a proved run. Another AI did a task and claims it is done. Every proof
command in its checklist passed. Your job is to find out whether the work is actually right anyway: assume it is wrong
and look. Check the real files and state yourself (read-only: do not change, create or delete anything). Look for:
checks that pass on empty or fake work, parts of the task with no check at all, claims in its reply nothing backs.
Write one line per finding:  REFUTED: <what is wrong, with the file or command that shows it>  or
CONFIRMED: <what you checked and found true>. End with exactly one line:  VERDICT: pass   or   VERDICT: fail
Write REFUTED lines only for real problems; if you found none, write no REFUTED line at all.
Fail only for something that is really wrong or missing, and say how to fix it."""
CRITIC_TOOLS = "Read,Grep,Glob,Bash,WebFetch,WebSearch"


def parse_checklist(text):
    out = []
    for line in (text or "").splitlines():
        m = STEP_RE.match(line)
        if m:
            claim, cmd, exp = m.group(1).strip(), m.group(2).strip(), (m.group(3) or "").strip() or None
            out.append({"claim": claim, "cmd": cmd, "expect": exp, "human": cmd.upper() == "HUMAN"})
    return out


def merged_checklist(d):
    """Frozen lines win (same claim → frozen command); lines the agent added later are appended; dropped ones return."""
    cur = parse_checklist((d / "checklist.md").read_text()) if (d / "checklist.md").exists() else []
    fro = parse_checklist((d / "checklist.frozen").read_text()) if (d / "checklist.frozen").exists() else []
    seen = {c["claim"] for c in fro}
    out = [dict(c) for c in fro]
    for c in cur:
        if c["claim"] not in seen:
            out.append(dict(c, added=True))
            seen.add(c["claim"])
    for c in fro:
        hit = next((x for x in cur if x["claim"] == c["claim"]), None)
        if hit is None:
            c_out = next(x for x in out if x["claim"] == c["claim"])
            c_out["restored"] = "removed by the agent, put back"
        elif (hit["cmd"], hit["expect"]) != (c["cmd"], c["expect"]):
            c_out = next(x for x in out if x["claim"] == c["claim"])
            c_out["restored"] = "changed by the agent, first version used"
    return out


ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
CHECK_ENV = {k: v for k, v in os.environ.items() if k not in ("FORCE_COLOR", "CLICOLOR_FORCE")}
CHECK_ENV.update(NO_COLOR="1", TERM="dumb", CI="1")


def run_checks(d, cwd, items, human_approved=False, human_note="", st=None):
    prof = d / "check.sb"
    prof.write_text(SANDBOX)
    sb = shutil.which("sandbox-exec") or "/usr/bin/sandbox-exec"
    for c in items:
        if (d / "STOP").exists() or (load(d) or {}).get("status") == "stopped":
            break
        if st is not None and st.get("_chain_broken"):
            break
        code = None
        raw_out = ""
        raw_stdout = None   # exact bytes the check wrote to stdout; this is what output_sha256 hashes
        if c["human"]:
            if human_approved:
                raw_out = f"approved by {owner_name()}: {one(human_note, 160)}" if human_note else f"approved by {owner_name()}"
                c.update(ok=True, out=raw_out)
            else:
                raw_out = f"for {owner_name()} to judge"
                c.update(ok=None, out=raw_out)
        else:
            try:
                r = subprocess.run([sb, "-f", str(prof), "/bin/zsh", "-c", c["cmd"]], cwd=cwd, capture_output=True,
                                   timeout=CHECK_TIMEOUT, stdin=subprocess.DEVNULL, env=CHECK_ENV)
                raw_stdout = r.stdout or b""
                text_out = raw_stdout.decode("utf-8", "replace").replace("\r\n", "\n").replace("\r", "\n")
                text_err = (r.stderr or b"").decode("utf-8", "replace").replace("\r\n", "\n").replace("\r", "\n")
                out = ANSI_RE.sub("", text_out + text_err).strip()
                raw_out = out
                ok = r.returncode == 0
                code = r.returncode
                if ok and c["expect"]:
                    try:
                        ok = re.search(c["expect"], out) is not None
                    except re.error:
                        ok, out = False, f"bad expect regex: {c['expect']}"
                    if not ok and not out.startswith("bad expect"):
                        out = f"output did not match {c['expect']!r}: {out}"
                    if out != raw_out:
                        raw_out = out
                c.update(ok=ok, out=one(out, 400) or f"exit {r.returncode}", code=code)
            except subprocess.TimeoutExpired as e:
                raw_stdout = e.stdout or b""
                raw_out = f"took longer than {CHECK_TIMEOUT} s"
                c.update(ok=False, out=raw_out, code=None)
        if st is not None:
            write_receipt(d, st, "check_result", {
                "claim": redact_text(c.get("claim") or ""),
                "command_sha256": sha256_text(c.get("cmd") or ""),
                "passed": c.get("ok") is True,
                "exit_code": c.get("code"),
                "output_sha256": (hashlib.sha256(raw_stdout).hexdigest() if raw_stdout is not None
                                  else sha256_text(raw_out)),
            })
            if st.get("_chain_broken"):
                break
    return items


def check_report(items, only_failed=False):
    lines = []
    for c in items:
        if only_failed and c["ok"] is not False:
            continue
        mark = "PASS" if c["ok"] else "HUMAN" if c["ok"] is None else "FAIL"
        lines.append(f"{mark}: {c['claim']}  [verify: {c['cmd']}]" + (f"\n      {c['out']}" if c["ok"] is not True else ""))
    return "\n".join(lines)


def critic_verdict(text):
    v = re.findall(r"^\s*VERDICT:\s*(pass|fail)\b", text or "", re.I | re.M)
    refuted = [one(x, 300) for x in re.findall(r"^\s*REFUTED:\s*(.+)$", text or "", re.M)
               if not re.match(r"(no|none|nothing)\b", x.strip(), re.I)]       # "REFUTED: No problems found" is not one
    return (v[-1].lower() if v else None), refuted

# ------------------------------------------------------------------ commands
HANDOFF_ORDER = ("claude", "codex", "grok")
HUMAN_LEFT_RE = re.compile(
    r"\b(human|person|you\b|your\b|touch\s*id|"
    r"sudo|password|login|sign\s*in|account|money|payment|bank|approve|permission|"
    r"question|clarif\w*|context|confirm|decide|input|intervene|helper)\b|\?",
    re.I,
)


def human_left_re():
    extra = []
    cfg = load_config() or {}
    for w in cfg.get("pause_words") or []:
        w = str(w).strip()
        if w:
            extra.append(re.escape(w))
    if not extra:
        return HUMAN_LEFT_RE
    return re.compile(HUMAN_LEFT_RE.pattern + r"|(" + "|".join(extra) + r")", re.I)
NOTHING_LEFT_RE = re.compile(r"^\s*(nothing|none|n/a|nil|no|-|nothing left|all done|done)\b", re.I)


def extract_human_request(st, verdict=None, note=None):
    """If the agent paused for a human helper (LEFT: <human step/question> or verify: HUMAN), return what it needs."""
    parts = []
    if verdict == "needs you":
        humans = [c["claim"] for c in (st.get("checks") or []) if c.get("human") and c.get("ok") is not True]
        if humans:
            parts.append("; ".join(humans))
    final_text = st.get("final") or st.get("remark") or ""
    m = re.search(r"^\s*LEFT:\s*(.+?)\s*$", final_text, re.I | re.M)
    left_val = m.group(1).strip() if m else ""
    if left_val and not NOTHING_LEFT_RE.match(left_val):
        if human_left_re().search(left_val) or verdict == "needs you":
            if left_val not in parts:
                parts.append(left_val)
    return " · ".join(parts) if parts else None


def _workspace_and_history_context(st, include_human_replies=True):
    lines = []
    handoffs = st.get("handoffs") or []
    if handoffs:
        lines += ["", "PRIOR HANDOFF CHAIN HISTORY:"]
        for idx, h in enumerate(handoffs[-8:], 1):
            frm = h.get("from") or "?"
            to = h.get("to") or "?"
            rsn = h.get("reason") or ""
            summ = h.get("summary") or ""
            lines.append(f"- Leg {idx} ({frm} -> {to}): {rsn}" + (f" | Summary: {summ}" if summ else ""))
    if include_human_replies:
        for hr in (st.get("human_replies") or [])[-5:]:
            if isinstance(hr, dict) and hr.get("reply"):
                req_str = f" (asked: {one(hr.get('request') or '', 120)})" if hr.get("request") else ""
                lines += ["", f"HUMAN HELPER REPLY ({hr.get('at', '')}){req_str}:", str(hr["reply"])]
    tool_actions = [a for a in (st.get("actions") or []) if isinstance(a, dict) and a.get("kind") == "tool"]
    if tool_actions:
        lines += ["", "RECENT TOOL ACTIONS IN THIS RUN:"]
        for a in tool_actions[-25:]:
            res = f" -> {one(a.get('result') or '', 140)}" if a.get("result") else ""
            lines.append(f"- [{a.get('tool') or 'tool'}] {one(a.get('what') or '', 180)}{res}")
    cwd = st.get("cwd")
    if cwd and os.path.isdir(cwd):
        try:
            gs = subprocess.run(["git", "-C", cwd, "status", "--short"],
                                capture_output=True, text=True, timeout=3).stdout.strip()
            if gs:
                lines += ["", "CURRENT WORKSPACE GIT STATUS:", gs[:1500]]
        except Exception:
            pass
    return lines


def build_human_resume_prompt(st, prev_req, reply_text, same_session=False):
    if same_session:
        lines = [
            "HUMAN HELPER INTERVENTION / ANSWER:",
            reply_text,
        ]
        if prev_req:
            lines += ["", f"Previously waiting on: {prev_req}"]
        lines += [
            "",
            "Use this answer/context to finish the remaining steps of the task. "
            "End your final reply with DONE: <what you finished> and LEFT: <what's left, or nothing>.",
        ]
        return "\n".join(lines)
    lines = [
        "RESUMED AFTER HUMAN HELPER INTERVENTION:",
        "The human helper answered the previous question / unblocked the step. Inspect the workspace state, keep valid completed work, and finish what remains.",
        "",
        "ORIGINAL TASK:",
        st.get("task") or "",
    ]
    if prev_req:
        lines += ["", "WHAT THE AGENT WAS WAITING ON:", prev_req]
    lines += ["", "HUMAN HELPER ANSWER / CONTEXT:", reply_text]
    for hr in (st.get("human_replies") or [])[:-1]:
        if isinstance(hr, dict) and hr.get("reply"):
            lines += ["", f"EARLIER HUMAN REPLY ({hr.get('at', '')}):", str(hr["reply"])]
    plan = st.get("plan") or []
    if plan:
        done_steps = [s.get("step") for s in plan if s.get("status") == "completed" and s.get("step")]
        todo_steps = [s.get("step") for s in plan if s.get("status") != "completed" and s.get("step")]
        if done_steps:
            lines += ["", "COMPLETED PLAN STEPS:"] + [f"- [x] {s}" for s in done_steps]
        if todo_steps:
            lines += ["", "REMAINING PLAN STEPS TO FINISH:"] + [f"- [ ] {s}" for s in todo_steps]
    lines += _workspace_and_history_context(st, include_human_replies=False)
    prev_final = (st.get("final") or st.get("remark") or st.get("last_good_final") or "").strip()
    if prev_final:
        lines += ["", f"PREVIOUS AGENT ({st.get('who') or 'claude'}) OUTPUT:", prev_final[:3500]]
    return "\n".join(lines)


def parse_handoff_chain(raw, current_who):
    if raw is None:
        return [w for w in HANDOFF_ORDER if w != current_who]
    raw = str(raw).strip()
    if not raw or raw.lower() in ("none", "off", "false", "0", "no"):
        return []
    out = []
    for part in raw.split(","):
        part = part.strip()
        if not part:
            continue
        w = normalize_who(part)
        if w != current_who and w not in out:
            out.append(w)
    return out


def unfinished_reason(st, verdict=None, note=None):
    if verdict == "chain_broken" or st.get("verdict") == "chain_broken" or st.get("_chain_broken"):
        return None
    if st.get("status") == "failed" or verdict == "dead end":
        return "failed: " + one(note or st.get("final") or st.get("remark") or "provider failed", 180)
    if verdict in ("proved", "needs you"):
        return None
    final_text = st.get("final") or st.get("remark") or ""
    m = re.search(r"^\s*LEFT:\s*(.+?)\s*$", final_text, re.I | re.M)
    left_val = m.group(1).strip() if m else ""
    if left_val and not NOTHING_LEFT_RE.match(left_val):
        if human_left_re().search(left_val):
            return None
        return "unfinished work left: " + one(left_val, 180)
    if not left_val:
        plan = st.get("plan") or []
        unfinished = [s for s in plan if s.get("status") != "completed"]
        if unfinished:
            return f"{len(unfinished)} of {len(plan)} plan steps unfinished"
    return None


def build_handoff_prompt(st, prev_who, reason):
    lines = [
        f"HANDOFF FROM {prev_who.upper()} ({reason}):",
        "Another AI provider worked on this task before handing off to you. Inspect the workspace state first, keep valid completed work, and finish what remains.",
        "",
        "ORIGINAL TASK:",
        st["task"],
    ]
    plan = st.get("plan") or []
    if plan:
        done_steps = [s.get("step") for s in plan if s.get("status") == "completed" and s.get("step")]
        todo_steps = [s.get("step") for s in plan if s.get("status") != "completed" and s.get("step")]
        if done_steps:
            lines += ["", "COMPLETED PLAN STEPS:"] + [f"- [x] {s}" for s in done_steps]
        if todo_steps:
            lines += ["", "REMAINING PLAN STEPS TO FINISH:"] + [f"- [ ] {s}" for s in todo_steps]
    lines += _workspace_and_history_context(st, include_human_replies=True)
    prev_final = (st.get("final") or st.get("remark") or "").strip()
    last_good = (st.get("last_good_final") or "").strip()
    if prev_final:
        lines += ["", f"PREVIOUS PROVIDER ({prev_who}) OUTPUT:", prev_final[:3500]]
    if last_good and last_good != prev_final:
        lines += ["", "EARLIER SUBSTANTIVE PROVIDER OUTPUT:", last_good[:3000]]
    fails = [c for c in (st.get("checks") or []) if c.get("ok") is False]
    if fails:
        lines += ["", "FAILED VERIFICATION CHECKS TO FIX:", check_report(fails, only_failed=True)]
    return "\n".join(lines)


def start(argv):
    if wants_help(argv):
        print(__doc__)
        return None
    cwd, model, name, who, provider, task, plain, given = os.getcwd(), None, None, None, None, [], False, None
    handoff_arg, domain, domain_file, no_plan = None, None, None, False
    ended = False
    after_ddash = False
    it = iter(argv)
    for a in it:
        if not ended and a == "--":
            ended = True
            after_ddash = True
            continue
        if not ended and a == "--cwd":
            cwd = next(it)
        elif not ended and a == "--provider":
            provider = next(it)
        elif not ended and a == "--model":
            model = next(it)
        elif not ended and a == "--name":
            name = next(it)
        elif not ended and a == "--who":
            who = normalize_who(next(it))
        elif not ended and a == "--plain":
            plain = True
        elif not ended and a == "--no-plan":
            no_plan = True
        elif not ended and a == "--checklist":
            given = Path(os.path.expanduser(next(it))).read_text()
        elif not ended and a == "--domain":
            domain_file = next(it)
        elif not ended and a == "--handoff":
            handoff_arg = next(it)
        elif not ended and a == "--no-handoff":
            handoff_arg = "none"
        elif not ended and a == "-":
            task.append(sys.stdin.read())
        elif not ended and a.startswith("-"):
            sys.exit(f"alexus start: refusing a task that begins with a dash ({a}). "
                     f"Put it after -- , for example: alexus start -- {a}")
        else:
            task.append(a)
    task = " ".join(task).strip()
    cwd = os.path.abspath(os.path.expanduser(cwd))
    if not task:
        sys.exit("alexus start: give a task")
    # Judged after trimming, so stdin ("-") and a leading space cannot sneak a dash-led task through.
    if not after_ddash and task[:1] == "-":
        head = one(task.split()[0], 80)
        sys.exit(f"alexus start: refusing a task that begins with a dash ({head}). "
                 f"Put it after -- , for example: alexus start -- {head}")
    if not os.path.isdir(cwd):
        sys.exit(f"alexus start: no such folder: {cwd}")
    cfg = require_config()
    # An approved checklist, or an explicit skip. A domain file is not a plan and does not start a run.
    if not no_plan and given is None:
        shown = " ".join(task.split())
        sys.exit("alexus: nothing started. Plan it first: alexus plan new --cwd "
                 + shlex.quote(cwd) + " -- " + shlex.quote(shown))
    if domain_file:
        try:
            domain = load_domain(Path(os.path.expanduser(domain_file)).read_text(), require_proof=given is None)
        except (OSError, ValueError) as e:
            sys.exit(f"alexus start: --domain: {e}")
    if who is None:
        who = normalize_who(cfg.get("default_who") or (cfg.get("clis") or ["claude"])[0])
    if not provider:
        provider = cfg.get("provider") or None
        if provider == "":
            provider = None
    if handoff_arg is None and "handoff" in cfg:
        handoff_arg = ",".join(cfg.get("handoff") or []) or "none"
    walled = domain and any(w.get("enforced") for w in domain["walls"])
    if domain and plain:
        sys.exit("alexus start: a run with a --domain is always proved (drop --plain)")
    if walled and who != "claude":
        sys.exit(f"alexus start: walls are enforced only on claude runs, not {who}")
    rid = time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:6]
    d = run_dir(rid)
    d.mkdir(parents=True)
    os.chmod(agents_dir(), 0o700)
    (d / "task.txt").write_text(task)
    if given is not None:                 # frozen before the agent starts when the caller passed a checklist
        if not parse_checklist(given):
            sys.exit("alexus start: --checklist has no '- [ ] claim :: verify: cmd' lines")
        (d / "checklist.md").write_text(given)
        (d / "checklist.frozen").write_text(given)
    # Every runner is proved unless --plain is set: "done" has to be shown, not said.
    mode = "plain" if plain else "proved"
    chain = [] if walled else parse_handoff_chain(handoff_arg, who)   # only claude can be held to the walls
    seed = domain_seed(domain) if domain and given is None else ""
    if seed:
        (d / "checklist.md").write_text(seed)
        (d / "checklist.frozen").write_text(seed)
    save(d, {"id": rid, "name": name or one(task, 60), "task": task, "cwd": cwd, "who": who,
             "started_who": who, "handoff_chain": chain, "handoffs": [],
             "provider": provider, "model": model,
             "mode": mode, "given_checklist": given is not None,
             "domain": domain, "seeded_only": bool(seed), "gen": 0,
             "status": "starting", "started": now(), "ended": None, "now": "starting the agent", "plan": [],
             "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0, "remark": "", "final": "", "cost_usd": None,
             "turns": None, "session": None, "pid": None})
    log = open(d / "worker.log", "a")
    subprocess.Popen([sys.executable, "-B", "-I", os.path.abspath(__file__), "run", rid], stdin=subprocess.DEVNULL,
                     stdout=log, stderr=log, start_new_session=True, cwd=cwd)
    print(rid)


def handoff(argv, spawn=True):
    if wants_help(argv):
        print(__doc__)
        return None
    if not argv:
        sys.exit("usage: alexus handoff <id> [--who claude|grok|codex] [--provider P] [--model M] [--handoff p1,p2|--no-handoff] [note]")
    old_id = argv[0]
    d_old = run_dir(old_id)
    old_st = load(d_old)
    if not old_st:
        sys.exit(f"alexus handoff: no run {old_id}")
    if (old_st.get("verdict") == "chain_broken" or old_st.get("receipts_broken")
            or old_st.get("_chain_broken") or not chain_ok(d_old, old_st)):
        old_st = load(d_old) or old_st
        sys.exit(f"alexus handoff: chain_broken: {old_st.get('verdict_note') or 'receipts chain is broken'}")
    target_who, provider, model, handoff_arg, note_parts = None, None, None, None, []
    it = iter(argv[1:])
    for a in it:
        if a == "--who":
            target_who = normalize_who(next(it))
        elif a == "--provider":
            provider = next(it)
        elif a == "--model":
            model = next(it)
        elif a == "--handoff":
            handoff_arg = next(it)
        elif a == "--no-handoff":
            handoff_arg = "none"
        elif a == "-":
            note_parts.append(sys.stdin.read())
        else:
            note_parts.append(a)
    prev_who = old_st.get("who") or "claude"
    if enforced_walls(old_st):
        sys.exit("alexus handoff: this run has walls, and only claude runs can be held to them")
    if not target_who:
        old_chain = [normalize_who(w) for w in (old_st.get("handoff_chain") or []) if w]
        target_who = next((w for w in old_chain if w != prev_who), None)
        if not target_who:
            target_who = next((w for w in HANDOFF_ORDER if w != prev_who), "codex")
    if old_st.get("status") in ("starting", "running") or old_st.get("pid"):
        stop(old_id)
        old_st = load(d_old) or old_st
    extra_note = " ".join(note_parts).strip()
    reason = extra_note or unfinished_reason(old_st, old_st.get("verdict"), old_st.get("verdict_note")) or f"manual handoff from {prev_who}"
    rid = time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:6]
    d = run_dir(rid)
    d.mkdir(parents=True)
    os.chmod(agents_dir(), 0o700)
    task = old_st.get("task") or ""
    (d / "task.txt").write_text(task)
    for fn in ("checklist.md", "checklist.frozen"):
        if (d_old / fn).exists():
            shutil.copy(d_old / fn, d / fn)
    plan = [dict(s, status="pending" if s.get("status") in ("left", "in_progress") else (s.get("status") or "pending"))
            for s in (old_st.get("plan") or []) if isinstance(s, dict)]
    prior_handoffs = list(old_st.get("handoffs") or [])
    prior_handoffs.append({
        "from": prev_who,
        "to": target_who,
        "at": now(),
        "reason": one(reason, 200),
        "tools": old_st.get("tools") or 0,
        "session": old_st.get("session"),
        "summary": one(old_st.get("verdict_note") or old_st.get("final") or old_st.get("remark") or old_st.get("last_good_final") or "", 1200),
    })
    tried = {h.get("from") for h in prior_handoffs if h.get("from")} | {target_who}
    if handoff_arg is None:
        base_chain = [normalize_who(w) for w in (old_st.get("handoff_chain") or list(HANDOFF_ORDER)) if w]
        chain = [w for w in base_chain if w not in tried]
        for w in HANDOFF_ORDER:
            if w not in tried and w not in chain:
                chain.append(w)
    else:
        chain = parse_handoff_chain(handoff_arg, target_who)
    mode = "proved" if old_st.get("mode") == "proved" or (d / "checklist.frozen").exists() else "plain"
    old_st_for_prompt = dict(old_st, handoffs=prior_handoffs)
    prompt = build_handoff_prompt(old_st_for_prompt, prev_who, reason)
    carried_actions = [a for a in (old_st.get("actions") or [])[-40:] if isinstance(a, dict)]
    carried_actions.append({"at": now(), "kind": "handoff", "what": f"handed off from {prev_who} ({old_id}) to {target_who}: {one(reason, 140)}"})
    last_good = old_st.get("final") if (old_st.get("status") == "done" or len(old_st.get("final") or "") > 120) else old_st.get("last_good_final")
    save(d, {"id": rid, "name": old_st.get("name") or one(task, 60), "task": task, "cwd": old_st["cwd"],
             "who": target_who, "started_who": old_st.get("started_who") or prev_who,
             "handoff_from": old_id, "handoff_chain": chain, "handoffs": prior_handoffs,
             "human_replies": list(old_st.get("human_replies") or []),
             "human_approved": bool(old_st.get("human_approved")),
             "last_good_final": (last_good or "")[:4000] or None,
             "provider": provider, "model": model,
             "mode": mode, "given_checklist": bool(old_st.get("given_checklist")),
             "domain": old_st.get("domain"),
             "status": "starting", "started": now(), "ended": None,
             "now": f"handed off from {prev_who} to {target_who}", "plan": plan,
             "actions": carried_actions,
             "tools": 0, "errors": 0, "hook_blocks": 0, "remark": "", "final": "", "cost_usd": None,
             "turns": None, "session": None, "pid": None})
    (d / "handoff_prompt.txt").write_text(prompt)
    st_new = load(d) or {}
    if init_receipt_cursor(d, st_new):
        write_receipt(d, st_new, "handoff", {
            "from": prev_who,
            "to": target_who,
            "reason": redact_text(one(reason, 200)),
        })

    def mark(old):
        old["handed_off_to"] = rid
    if not _authority_update(d_old, mark, clear_stop=False):
        sys.exit(f"alexus handoff: no run {old_id}")
    if spawn:
        log = open(d / "worker.log", "a")
        subprocess.Popen([sys.executable, "-B", "-I", os.path.abspath(__file__), "run", rid], stdin=subprocess.DEVNULL,
                         stdout=log, stderr=log, start_new_session=True, cwd=old_st["cwd"])
    print(rid)
    return rid


def resume_run(argv, spawn=True):
    """Resume a run after a human helper answers a question, provides context, or approves a human step."""
    if wants_help(argv):
        print(__doc__)
        return None
    if not argv:
        sys.exit("usage: alexus resume <id> [--who claude|grok|codex] [--provider P] [--model M] [--approve-human|--no-approve-human] [answer / context]")
    rid = argv[0]
    d = run_dir(rid)
    st = load(d)
    if not st:
        sys.exit(f"alexus resume: no run {rid}")
    if (st.get("verdict") == "chain_broken" or st.get("receipts_broken")
            or st.get("_chain_broken") or not chain_ok(d, st)):
        st = load(d) or st
        sys.exit(f"alexus resume: chain_broken: {st.get('verdict_note') or 'receipts chain is broken'}")
    target_who, provider, model, approve_human, reply_parts = None, None, None, None, []
    it = iter(argv[1:])
    for a in it:
        if a == "--who":
            target_who = normalize_who(next(it))
        elif a == "--provider":
            provider = next(it)
        elif a == "--model":
            model = next(it)
        elif a in ("--approve-human", "--approve"):
            approve_human = True
        elif a == "--no-approve-human":
            approve_human = False
        elif a == "-":
            reply_parts.append(sys.stdin.read())
        else:
            reply_parts.append(a)
    if st.get("status") in ("starting", "running") or st.get("pid"):
        stop(rid)
    reply_text = " ".join(reply_parts).strip() or "Human helper intervened and approved; continue and complete any remaining work."
    prev_who = st.get("who") or "claude"

    def mutate(st):
        cur_who = st.get("who") or "claude"
        next_who = target_who or cur_who
        approved = approve_human
        if approved is None:
            approved = st.get("verdict") == "needs you" or bool(st.get("human_request"))
        prev_req = st.get("human_request") or st.get("verdict_note") or ""
        same_session = (next_who == cur_who) and bool(st.get("session")) and next_who in ("claude", "grok", "codex")
        st.setdefault("human_replies", []).append({
            "at": now(),
            "request": prev_req or None,
            "reply": reply_text,
            "approved": bool(approved),
        })
        if approved:
            st["human_approved"] = True
        prompt = build_human_resume_prompt(st, prev_req, reply_text, same_session=same_session)
        (d / "handoff_prompt.txt").write_text(prompt)
        for step in st.get("plan") or []:
            if step.get("status") in ("left", "in_progress"):
                step["status"] = "pending"
        st.setdefault("actions", []).append({
            "at": now(),
            "kind": "human",
            "what": f"{owner_name()} answered: {one(reply_text, 200)}",
        })
        if next_who != cur_who:
            st.setdefault("handoffs", []).append({
                "from": cur_who,
                "to": next_who,
                "at": now(),
                "reason": f"human resumed on {next_who}: {one(reply_text, 140)}",
                "tools": st.get("tools") or 0,
                "session": st.get("session"),
                "summary": one(prev_req or st.get("final") or "", 400),
            })
            st["session"] = None
        st.update(
            who=next_who,
            provider=provider if provider is not None else st.get("provider"),
            model=model if model is not None else st.get("model"),
            resume_session=st.get("session") if same_session else None,
            status="starting",
            ended=None,
            verdict=None,
            verdict_note=None,
            human_request=None,
            phase="resuming",
            now=f"resuming with your input: {one(reply_text, 90)}",
        )
    st = _authority_update(d, mutate, clear_stop=True)
    if not st:
        sys.exit(f"alexus resume: no run {rid}")
    who_now = st.get("who") or "claude"
    if who_now != prev_who:
        if not init_receipt_cursor(d, st):
            sys.exit(f"alexus resume: chain_broken: {st.get('verdict_note') or 'receipts chain is broken'}")
        write_receipt(d, st, "handoff", {
            "from": prev_who,
            "to": who_now,
            "reason": redact_text(one(reply_text, 200)),
        })
    receipt("Updated", f"human resumed {who_now} run {rid}: {one(reply_text, 240)}",
            f"{st['cwd']} (run {rid})", st.get("session"), who=who_now)
    if spawn:
        log = open(d / "worker.log", "a")
        subprocess.Popen([sys.executable, "-B", "-I", os.path.abspath(__file__), "run", rid], stdin=subprocess.DEVNULL,
                         stdout=log, stderr=log, start_new_session=True, cwd=st["cwd"])
    print(rid)
    return rid


def leg(d, st, cmd, events="events.jsonl", into=None, label="", who=None, cwd=None):
    """Run one CLI process and fold its stream into `into` (the run's own state unless given). Returns (code, stderr)."""
    into = st if into is None else into
    who = who or st.get("who") or "claude"
    env = dict(os.environ, ALEXUS_RUN=st["id"], ALEXUS_RUN_ID=st["id"],
               ALEXUS_ACTOR=who, ALEXUS_ORIGIN="alexus", NO_COLOR="1", TERM="dumb",
               PYTHONDONTWRITEBYTECODE="1")
    env.pop("CLAUDECODE", None)          # a fresh agent, not a child of whatever started this
    env.pop("CLAUDE_CODE_SHELL_PREFIX", None)
    if into is st and who == "claude":   # the agent's own legs carry the walls; the critic is read-only already
        env.update(st.get("_wall_env") or {})
    if who == "grok":
        env["GROK_WORKFLOWS"] = "0"      # a run must not leave a workflow behind
    if who == "claude" and st.get("provider"):
        p = st["provider"].lower()
        if "bedrock" in p:
            env["CLAUDE_CODE_USE_BEDROCK"] = "1"
        elif "vertex" in p:
            env["CLAUDE_CODE_USE_VERTEX"] = "1"
        elif "foundry" in p:
            env["CLAUDE_CODE_USE_FOUNDRY"] = "1"
    if who == "codex" and st.get("provider"):
        p = st["provider"].lower()
        if "ollama" in p or "lmstudio" in p or "lm-studio" in p:
            base = local_ollama_url()
            if base:
                if not base.endswith("/v1"):
                    base = base + "/v1"
                env["CODEX_OSS_BASE_URL"] = base
    if not cmd or not str(cmd[0] or "").strip():
        return None, f"could not start {who}: no CLI is configured"
    if not worker_live(d, st):
        return "stopped", ""
    try:
        proc = subprocess.Popen(cmd, cwd=cwd or st["cwd"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True, env=env, start_new_session=True)
    except Exception as e:
        return None, f"could not start {who}: {e} (PATH: {os.environ.get('PATH', '')})"
    if not _publish_running(d, st, proc.pid):
        _killpg(proc.pid, signal.SIGTERM)
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            _killpg(proc.pid, signal.SIGKILL)
            proc.wait(timeout=5)
        return "stopped", ""
    tools, ctx, last = {}, into.setdefault("_ctx", {"summary": ""}), 0
    ck, fro = d / "checklist.md", d / "checklist.frozen"
    seen = {}
    halted = False
    with open(d / events, "a") as ev:
        for line in proc.stdout:
            if halted or (d / "STOP").exists():
                halted = True   # keep draining so the provider cannot block on a full pipe
                continue
            ev.write(line)
            ev.flush()
            try:
                e = json.loads(line)
            except ValueError:
                continue
            apply_event(into, e, tools, ctx)
            if into is not st:
                st["now"] = f"{label}: {into.get('now') or ''}".strip()
            if not fro.exists() and ck.exists() and parse_checklist(ck.read_text()):
                shutil.copy(ck, fro)
                st["actions"].append({"at": now(), "kind": "system", "what": "checklist written and frozen"})
                if into is st:
                    write_frozen_receipt(d, st)
            elif st.get("seeded_only") and ck.exists():
                # the domain's own proof lines were frozen at start; the agent's first lines are frozen on top of them
                have = {c["claim"] for c in parse_checklist(fro.read_text())}
                new = [ln for ln in ck.read_text().splitlines() if STEP_RE.match(ln) and STEP_RE.match(ln).group(1).strip() not in have]
                if new:
                    with open(fro, "a") as f:
                        f.write("\n".join(new) + "\n")
                    st["seeded_only"] = False
                    st["actions"].append({"at": now(), "kind": "system", "what": "checklist written and frozen"})
                    if into is st:
                        write_frozen_receipt(d, st)
            if into is st and st.get("_chain_broken"):
                halted = True
                _killpg_force(proc.pid)
                continue
            if into is st:
                crossed = wall_backstop(st, e, seen)
                if crossed:
                    st["wall_crossed"] = crossed
                    st["actions"].append({"at": now(), "kind": "hook", "what": "🧱 " + crossed + "; run stopped"})
                    try:
                        os.killpg(proc.pid, signal.SIGTERM)
                    except ProcessLookupError:
                        pass
                    save(d, st)
                    break
            if (d / "STOP").exists() or not worker_live(d, st):
                halted = True
                continue
            if time.time() - last > 0.5:
                if not save(d, st):
                    halted = True
                else:
                    last = time.time()
    err = proc.stderr.read()
    if st.get("_chain_broken"):
        _killpg_force(proc.pid)
        try:
            rc = proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            _killpg_force(proc.pid)
            try:
                rc = proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                rc = -9
        return rc, err
    rc = proc.wait()
    if halted or not worker_live(d, st):
        return "stopped", err
    return rc, err


def stopped(d):
    return (load(d) or {}).get("status") == "stopped"


CRITIC_RING = ("claude", "codex", "grok")


def critic_order(who):
    """Any AI can judge and none is the main one: start with the next AI after the worker, go round the ring, and use
    the worker itself (a fresh session) only as the last resort."""
    i = CRITIC_RING.index(who) if who in CRITIC_RING else -1
    order = [CRITIC_RING[(i + n) % len(CRITIC_RING)] for n in range(1, len(CRITIC_RING) + 1)]
    only = [normalize_who(w) for w in os.environ.get("ALEXUS_CRITICS", "").split(",") if w.strip()]
    if not only:
        cfg = load_config() or {}
        if cfg.get("clis"):
            only = [normalize_who(w) for w in cfg["clis"] if w]
            order = [w for w in order if w in only] or order
            return order
    return [w for w in order if w in only] if only else order


def critic_copy(cwd, base):
    """A throwaway copy of the work (an instant APFS clone) for the critic, so it can't change the real folder
    whichever AI it is. Returns the copy's path, or None if the folder can't be cloned in time."""
    dest = Path(tempfile.mkdtemp(prefix="critic-", dir=base)) / "work"
    try:
        subprocess.run(["cp", "-cR", cwd, str(dest)], check=True, timeout=CHECK_TIMEOUT, capture_output=True)
        return str(dest)
    except Exception:
        shutil.rmtree(dest.parent, ignore_errors=True)
        return None


def critic(d, st):
    """A fresh, read-only session that tries to show the work is wrong. Returns (verdict, refuted, text, cost)."""
    items = st.get("checks") or []
    prompt = (f"Task the other AI was given:\n{st['task']}\n{domain_text(st.get('domain'), for_critic=True)}\nFolder: {st['cwd']}\n\n"
              f"Its checklist, as run by this program:\n{check_report(items)}\n\n"
              f"Its final reply:\n{(st.get('final') or '')[:6000]}")
    v, refuted, text, cost, last_who = None, [], "", 0, None
    if not chain_ok(d, st):
        return v, refuted, text, cost
    base = d / "critic-copy"
    base.mkdir(exist_ok=True)
    work = critic_copy(st["cwd"], base)
    # Without a copy, only runners the CLI itself holds read-only may judge.
    order = critic_order(st.get("who") or "claude") if work else [w for w in critic_order(st.get("who") or "claude")
                                                                  if w in ("claude", "codex")]
    try:
        for cw in order:
            last_who = cw
            if not worker_live(d, st):
                break
            own = cw == (st.get("who") or "claude")
            cst = {"who": cw, "actions": [], "plan": [], "tools": 0, "errors": 0, "hook_blocks": 0, "final": "", "remark": ""}
            cwd = work or st["cwd"]
            cmd = launch_cmd(dict(st, who=cw, cwd=cwd, provider=st.get("provider") if own else None,
                                  model=st.get("critic_model") or (st.get("model") if own else None)),
                             prompt=prompt.replace(f"Folder: {st['cwd']}", f"Folder: {cwd}"),
                             guide=CRITIC_GUIDE, tools=CRITIC_TOOLS)
            st["actions"].append({"at": now(), "kind": "system",
                                  "what": f"critic started on {cw} (fresh session, {'throwaway copy' if work else 'read-only'})"})
            code, err = leg(d, st, cmd, events="critic.jsonl", into=cst, label="critic", who=cw, cwd=cwd)
            if code == "stopped" or not worker_live(d, st):
                break
            text = cst.get("final") or cst.get("_ctx", {}).get("summary") or ""
            for a in cst["actions"][-40:]:
                if a.get("kind") in ("tool", "said"):
                    st["actions"].append(dict(a, kind="critic" if a.get("kind") == "tool" else "said",
                                              what="critic " + (a.get("what") or "")))
            cost += cst.get("cost_usd") or 0
            v, refuted = critic_verdict(text)
            if code is None:
                text = err
            if v or stopped(d):   # no verdict (quota, a crash): the next AI gets the same job
                break
    finally:
        shutil.rmtree(base, ignore_errors=True)
    if v is not None and not st.get("_chain_broken"):
        write_receipt(d, st, "critic", {
            "who": last_who,
            "verdict": v,
            "output_sha256": sha256_text(text),
        })
    return v, refuted, text, cost


def prove(d, st, resume_leg):
    """Proved mode: run the checks, send failures back, then the critic. Returns (verdict, note)."""
    rounds, prev_pass, prev_refuted = 0, -1, None
    while worker_live(d, st):
        hook = hook_cmd("before_prove")
        if hook:
            os.environ.pop("ALEXUS_BEFORE_PROVE", None)
            run_optional_hook(hook, st.get("id") or "")
        if not worker_live(d, st):
            return None, None
        items = merged_checklist(d)
        if not items:
            if st.get("late_checklist"):
                return "dead end", "the agent never wrote a checklist, so nothing could be proved"
            st["late_checklist"] = True
            ok = resume_leg(f"You finished without writing {d / 'checklist.md'}. Write it now, in the format you were "
                            "given, with a proof command for each thing the task needed. Then end again with DONE/LEFT.",
                            "writing the proofs it skipped")
            if not ok:
                return None, None
            continue
        missing = missing_proofs(st, items)
        if missing:
            st["_missing_rounds"] = st.get("_missing_rounds", 0) + 1
            if st["_missing_rounds"] > 2:
                return "dead end", "no checked line for " + "; ".join(f"{p['label']} ({p['text']})" for p in missing)
            ok = resume_leg("Your checklist has no line for these proofs from the task's domain:\n"
                            + "\n".join(f"- {p['label']}: {p['text']}" for p in missing)
                            + f"\n\nAdd one line for each to {d / 'checklist.md'}, the claim starting with its label, e.g. "
                            f"'- [ ] {missing[0]['label']}: <what is true> :: verify: <command>'. Use verify: HUMAN only if "
                            "only the operator can judge it. Then end again with DONE/LEFT.", "adding checks for uncovered proofs")
            if not ok:
                return None, None
            continue
        if not worker_live(d, st):
            return None, None
        if not chain_ok(d, st):
            return "chain_broken", st.get("verdict_note")
        st.update(phase="checking", now="this program is running the checklist itself")
        if not save(d, st):
            return None, None
        last_reply = ((st.get("human_replies") or [{}])[-1].get("reply") or "") if st.get("human_replies") else ""
        items = run_checks(d, st["cwd"], items, human_approved=bool(st.get("human_approved")), human_note=last_reply, st=st)
        if st.get("_chain_broken"):
            return "chain_broken", st.get("verdict_note")
        if not worker_live(d, st):
            return None, None
        st["checks"] = items
        save(d, st)
        fails = [c for c in items if c["ok"] is False]
        passed = sum(1 for c in items if c["ok"] is True)
        if fails:
            rounds += 1
            if passed <= prev_pass:
                return "dead end", f"round {rounds} proved nothing new ({passed} of {len(items)} checks pass)"
            if rounds > MAX_ROUNDS:
                return "dead end", f"{MAX_ROUNDS} fix rounds and {len(fails)} checks still fail"
            prev_pass = passed
            ok = resume_leg("This program ran your checklist itself. These did not pass:\n" + check_report(items, True)
                            + "\n\nFix the work, not the checks (the checklist is frozen). Then end again with DONE/LEFT.",
                            f"fixing failed checks (round {rounds})")
            if not ok:
                return None, None
            continue
        if not worker_live(d, st):
            return None, None
        if not chain_ok(d, st):
            return "chain_broken", st.get("verdict_note")
        st.update(phase="critic")
        if not save(d, st):
            return None, None
        v, refuted, text, ccost = critic(d, st)
        if st.get("_chain_broken"):
            return "chain_broken", st.get("verdict_note")
        if not worker_live(d, st):
            return None, None
        st.setdefault("_costs", []).append(ccost)
        st["cost_usd"] = sum(st["_costs"])
        st["critic"] = {"verdict": v, "refuted": refuted, "text": one(text, 3000)}
        save(d, st)
        if v == "pass":
            humans = [c["claim"] for c in items if c["human"] and c.get("ok") is not True]
            if humans:
                return "needs you", "every command check passed and the critic agreed; left for you: " + "; ".join(humans)
            return "proved", f"all {passed} checks passed, run by this program, and the critic found nothing wrong"
        if v is None:
            return "dead end", "the critic ended without a verdict: " + one(text, 300)
        rounds += 1
        if refuted and refuted == prev_refuted:
            return "dead end", "the critic refuted the same thing twice: " + "; ".join(refuted)
        if rounds > MAX_ROUNDS:
            return "dead end", f"{MAX_ROUNDS} rounds; the critic still says: " + "; ".join(refuted)
        prev_refuted, prev_pass = refuted, -1
        ok = resume_leg("A separate critic checked your work and says it is wrong:\n" + "\n".join(refuted or [one(text, 1500)])
                        + "\n\nFix it. Add a checklist line that would have caught it. Then end again with DONE/LEFT.",
                        f"fixing what the critic found (round {rounds})")
        if not ok:
            return None, None
    return None, None


def evidence_audit(d, st):
    """Optional local evidence audit. Off unless settings hooks.auditor (or ALEXUS_AUDITOR) names a program."""
    override = hook_cmd("auditor")
    if not override:
        return []
    if not os.path.isfile(override):
        return []
    answer = (st.get("final") or st.get("remark") or "").strip()
    if len(answer) < 40:
        return []
    ev_lines = [f"Task: {(st.get('task') or '')[:1200]}"]
    for h in (st.get("handoffs") or [])[-8:]:
        ev_lines.append(f"- prior handoff {h.get('from')}->{h.get('to')}: {h.get('reason')} ({h.get('summary') or ''})")
    for hr in (st.get("human_replies") or [])[-5:]:
        if isinstance(hr, dict) and hr.get("reply"):
            ev_lines.append(f"- human helper reply: {hr.get('reply')}")
    tool_actions = [a for a in (st.get("actions") or []) if isinstance(a, dict) and a.get("kind") == "tool"]
    for a in tool_actions[-100:]:
        ev_lines.append(f"- tool {a.get('tool')}: {a.get('what')} -> {a.get('result') or 'done'}")
    for c in (st.get("checks") or []):
        ev_lines.append(f"- check '{c.get('claim')}' ({c.get('cmd')}): ok={c.get('ok')} out={one(c.get('out') or '', 250)}")
    evidence = "\n".join(ev_lines)[:24000]
    false_flag_re = re.compile(
        r"\bno evidence (is )?needed\b|\bnot a (checkable |factual )+claim\b|"
        r"\bnot a factual claim\b|\bnot flagged\b|\bacceptable\.?\s*$|"
        r"^\s*supported\b|(?<!not )\bsupported( by (the )?evidence)?\.?\s*$",
        re.I,
    )
    try:
        proc = subprocess.run([override], input=json.dumps({"evidence": evidence, "answer": answer}),
                              capture_output=True, text=True, timeout=15)
        raw = json.loads(proc.stdout or "{}")
        neg_cue = re.compile(
            r"\b(not|no\b|never|absent|missing|contradict|false|unsupported|unverified|doesn['’]t|does not|did not|didn['’]t|without|lack|fail|wrong|different|instead)\b",
            re.I,
        )
        raw_items = [] if raw.get("all_supported") is True else (raw.get("unsupported") or [])
        flags = [
            u for u in raw_items
            if isinstance(u, dict) and u.get("claim")
            and u.get("supported") is not True
            and not false_flag_re.search(str(u.get("why") or ""))
            and neg_cue.search(str(u.get("why") or ""))
        ]
        return flags
    except Exception:
        return []


def run(rid):
    d = run_dir(rid)
    st = load(d)
    if not st or not adopt_worker(d, st):
        return
    who = st.get("who") or "claude"
    if not worker_live(d, st):
        return
    if enforced_walls(st) and who != "claude":
        st.update(status="failed", ended=now(), pid=None, verdict="dead end",
                  verdict_note=f"walls are enforced only on claude runs, not {who}", now="refused: walls need claude")
        save(d, st)
        return
    st["_wall_env"] = prepare_walls(d, st)
    st.setdefault("started_who", who)
    st.setdefault("handoffs", [])
    if not init_receipt_cursor(d, st):
        return
    snapshot_worktree(d, st)
    write_receipt(d, st, "run_started", {
        "task_sha256": sha256_text(st.get("task") or ""),
        "who": who,
        "folder": redact_text(st.get("cwd") or ""),
    })
    if (d / "checklist.frozen").exists() and parse_checklist((d / "checklist.frozen").read_text()):
        write_frozen_receipt(d, st)
    receipt("Created", f"{who} agent run started: {one(st['task'], 300)}", f"{st['cwd']} (run {rid})", who=who)
    costs = st.setdefault("_costs", [])   # every process's own cost (agent legs and critics), summed

    def go(prompt=None, resume=None, phase="working"):
        if not worker_live(d, st):
            return False
        cur_who = st.get("who") or "claude"
        st["phase"] = phase
        if resume:
            st["actions"].append({"at": now(), "kind": "system", "what": "sent back to the agent: " + phase})
            st["now"] = phase
        st["cost_usd"] = None
        tools_before = st.get("tools") or 0
        ck = d / "checklist.md"
        ck_before = ck.stat().st_mtime if ck.exists() else None
        code, err = leg(d, st, launch_cmd(st, prompt=prompt, resume=resume))
        if st.get("_chain_broken"):
            return False
        if code == "stopped" or not worker_live(d, st):
            return False
        costs.append(st.get("cost_usd") or 0)
        st["cost_usd"] = sum(costs)
        if code is None:
            st.update(status="failed", final=err)
        elif st["status"] not in ("done", "failed"):
            st["status"] = "failed"
        if st["status"] == "failed" and not st.get("final"):
            st["final"] = one(err, 2000) or f"{cur_who} exited {code} without a result"
        st["exit_code"] = code
        # A first leg that touched nothing did no work, whatever it said. Failing it here also sends it to the next provider.
        ck_after = ck.stat().st_mtime if ck.exists() else None
        left = re.search(r"^\s*LEFT:\s*(.+?)\s*$", st.get("final") or "", re.I | re.M)
        asks_person = bool(left and human_left_re().search(left.group(1)) and not NOTHING_LEFT_RE.match(left.group(1)))
        if (phase == "working" and st["status"] == "done" and (st.get("tools") or 0) == tools_before
                and ck_after == ck_before and not asks_person):
            said = one(st.get("final") or st.get("remark") or "", 300)
            st.update(status="failed", final=f"{cur_who} did no work: 0 tool calls. It said: {said}")
        return st["status"] == "done" and not stopped(d)

    leg_prompt = (d / "handoff_prompt.txt").read_text() if (d / "handoff_prompt.txt").exists() else None
    if (d / "handoff_prompt.txt").exists():
        try:
            (d / "handoff_prompt.txt").unlink()
        except OSError:
            pass
    resume_sess = st.pop("resume_session", None)
    if st.get("cost_usd") and not costs:
        costs.append(st["cost_usd"])
    chain = [normalize_who(w) for w in (st.get("handoff_chain") or []) if w and w != "antigravity"]
    if enforced_walls(st):
        chain = []   # only claude can be held to the walls
    if st.get("who") == "antigravity":       # an old run being resumed: it can't go back to a removed runner
        st["who"] = chain.pop(0) if chain else HANDOFF_ORDER[0]
    want_proved = st.get("mode") == "proved" or bool(st.get("given_checklist"))
    verdict, note = None, None

    while True:
        if not worker_live(d, st):
            return
        who = st.get("who") or "claude"
        if want_proved or st.get("mode") is not None:
            st["mode"] = "proved" if want_proved else "plain"
        ok = go(prompt=leg_prompt, resume=resume_sess, phase="resumed with your input" if resume_sess else "working")
        resume_sess = None
        if not worker_live(d, st):
            return
        if ok:
            flags = evidence_audit(d, st)
            if flags:
                lines = "\n".join(f"- \"{u.get('claim', '')}\": {u.get('why', '')}" for u in flags)
                st["hook_blocks"] = (st.get("hook_blocks") or 0) + 1
                st["actions"].append({
                    "at": now(),
                    "kind": "hook",
                    "what": "📯 [auditor] Evidence audit flagged: " + one("; ".join(f"{u.get('claim')}: {u.get('why')}" for u in flags), 240),
                })
                save(d, st)
                horn_prompt = (
                    "📯 [Local auditor] Evidence audit flagged claims unsupported by tool output:\n"
                    f"{lines}\n\n"
                    "Verify each claim with a tool, or clearly label it as unverified inference, then end with DONE: / LEFT:."
                )
                ok = go(prompt=horn_prompt, resume=st.get("session"), phase="evidence audit")
        verdict, note = None, None
        if st.get("wall_crossed"):
            st["status"] = "failed"
            verdict, note = "dead end", st["wall_crossed"]
            break
        if st.get("_chain_broken") or st.get("verdict") == "chain_broken":
            break
        if ok and st.get("mode") == "proved":
            if not worker_live(d, st):
                return
            verdict, note = prove(d, st, lambda p, ph: go(prompt=p, resume=st.get("session"), phase=ph))
            if st.get("_chain_broken") or verdict == "chain_broken":
                break
            if not worker_live(d, st):
                return
        elif ok and worker_live(d, st) and ((d / "checklist.frozen").exists() or (d / "checklist.md").exists()):
            items = merged_checklist(d)
            if items:
                last_reply = ((st.get("human_replies") or [{}])[-1].get("reply") or "") if st.get("human_replies") else ""
                if not worker_live(d, st):
                    return
                if not chain_ok(d, st):
                    break
                checks = run_checks(d, st["cwd"], items, human_approved=bool(st.get("human_approved")), human_note=last_reply, st=st)
                if st.get("_chain_broken"):
                    break
                if not worker_live(d, st):
                    return
                st["checks"] = checks
                if not save(d, st):
                    return
                bad = [c for c in checks if c["ok"] is False]
                human = [c for c in checks if c["ok"] is None]
                if bad:
                    verdict = "dead end"
                    note = f"{len(bad)}/{len(checks)} checks failed: " + "; ".join(c["claim"] for c in bad[:3])
                elif human:
                    verdict = "needs you"
                    note = f"{len(checks) - len(human)}/{len(checks)} checks passed; left for {owner_name()}: " + "; ".join(c["claim"] for c in human)
                else:
                    verdict = "proved"
                    note = f"all {len(checks)} checks passed"
        if not worker_live(d, st) or stopped(d):
            return
        if st.get("_chain_broken") or verdict == "chain_broken":
            st["status"] = "failed"
            break
        if verdict == "dead end":
            st["status"] = "failed"
        elif verdict in ("proved", "needs you"):
            st["status"] = "done"

        reason = unfinished_reason(st, verdict, note)
        next_who = None
        while chain:
            cand = chain.pop(0)
            if cand != who:
                next_who = cand
                break
        if not reason or not next_who:
            break
        if not chain_ok(d, st):
            break
        hook = hook_cmd("after_leg")
        if hook:
            os.environ.pop("ALEXUS_AFTER_LEG", None)
            run_optional_hook(hook, rid)
        if not worker_live(d, st) or stopped(d) or st.get("_chain_broken"):
            return

        if st.get("status") == "done" and (st.get("final") or "").strip():
            st["last_good_final"] = (st.get("final") or "").strip()[:4000]
        write_receipt(d, st, "handoff", {
            "from": who,
            "to": next_who,
            "reason": redact_text(one(reason, 200)),
        })
        if st.get("_chain_broken"):
            break
        handoff_rec = {
            "from": who,
            "to": next_who,
            "at": now(),
            "reason": one(reason, 200),
            "tools": st.get("tools") or 0,
            "session": st.get("session"),
            "summary": one(note or st.get("final") or st.get("remark") or st.get("last_good_final") or "", 1200),
        }
        st.setdefault("handoffs", []).append(handoff_rec)
        st["handoff_chain"] = chain
        leg_prompt = build_handoff_prompt(st, who, reason)
        (d / "handoff_prompt.txt").write_text(leg_prompt)
        for step in st.get("plan") or []:
            if step.get("status") in ("left", "in_progress"):
                step["status"] = "pending"
        st["actions"].append({
            "at": now(),
            "kind": "handoff",
            "what": f"handed off from {who} to {next_who}: {one(reason, 140)}",
        })
        receipt("Updated", f"agent handoff {who} -> {next_who}: {one(reason, 240)}",
                f"{st['cwd']} (run {rid})", st.get("session"), who=who)
        st.update(who=next_who, provider=None, model=None, session=None,
                  verdict=None, verdict_note=None, human_request=None, phase="handoff",
                  status="running", final="", remark="",
                  now=f"handing off from {who} to {next_who} ({one(reason, 80)})")
        st.pop("_ctx", None)
        if not save(d, st) or not worker_live(d, st):
            return

    if not worker_live(d, st):
        return
    if st.get("_chain_broken") or st.get("verdict") == "chain_broken":
        return
    if not chain_ok(d, st):
        return
    who = st.get("who") or "claude"
    hreq = extract_human_request(st, verdict, note) if st["status"] == "done" else None
    if hreq and verdict is None:
        verdict = "needs you"
        note = f"waiting on you: {one(hreq, 200)}"
    if verdict == "proved" and not chain_ok(d, st):
        return
    write_files_receipt(d, st)
    if st.get("_chain_broken"):
        return
    write_receipt(d, st, "verdict", {
        "verdict": verdict,
        "status": st.get("status"),
        "note": redact_text(one(note or "", 300)),
    })
    if st.get("_chain_broken"):
        return
    st.update(verdict=verdict, verdict_note=note, human_request=hreq, phase=None)
    for step in st.get("plan") or []:     # the run is over: a step it never closed was left, not still going
        if step.get("status") in ("in_progress", "pending"):
            step["status"] = "left"
    st.update(ended=now(), pid=None,
              now=(f"{verdict}: {note}" if verdict else
                   {"done": "finished", "failed": "failed", "stopped": f"stopped by {owner_name()}"}[st["status"]]))
    save(d, st)
    receipt("Updated", f"{who} agent run {verdict or st['status']} after {st['tools']} tool calls: "
            f"{one(note or st['final'], 300)}", f"{st['cwd']} (run {rid})", st.get("session"), who=who)


def stop(rid, force=False):
    d = run_dir(rid)
    if not (d / "state.json").exists():
        sys.exit(f"no run {rid}")
    pid = None
    with state_lock(d):
        st = load(d)
        if not st:
            st = None
        else:
            pid, lstart = _stop_target(st)
            for step in st.get("plan") or []:
                if step.get("status") in ("in_progress", "pending"):
                    step["status"] = "left"
            st["gen"] = int(st.get("gen") or 0) + 1
            if pid:
                st["stop_pid"] = pid
                if lstart:
                    st["stop_lstart"] = lstart
            st.update(status="stopped", now=f"force stopped by {owner_name()}" if force else f"stopped by {owner_name()}",
                      ended=now(), pid=None)
            _write_unlocked(d, st)
            (d / "STOP").write_text("force\n" if force else "stop\n")
    if not st:
        sys.exit(f"no run {rid}")
    _killpg(pid, signal.SIGKILL if force else signal.SIGTERM)
    if force:
        _killpg(pid, signal.SIGKILL)
    receipt("Updated", f"{st.get('who') or 'agent'} run {'force-stopped' if force else 'stopped'}",
            f"{st.get('cwd')} (run {rid})", st.get("session"), who=st.get("who") or "agent")
    print(f"{'force-stopped' if force else 'stopped'} {rid}")


def runs():
    out = []
    root = agents_dir()
    for d in (p for p in root.glob("*/") if not p.is_symlink() and _inside_state(p, root)) if root.exists() else []:
        st = load(d)
        if not isinstance(st, dict) or not isinstance(st.get("id"), str) or not st["id"]:
            continue
        # Use the immutable start time where available; a record with no timestamp
        # can only be ordered by its state file's modification time.
        try:
            started = datetime.fromisoformat(st.get("started") or "").timestamp()
        except (ValueError, TypeError):
            try:
                started = (d / "state.json").stat().st_mtime
            except OSError:
                continue
        out.append((started, st))
    return [st for _, st in sorted(out, key=lambda item: (item[0], item[1]["id"]), reverse=True)]


def run_summary(st):
    who = st.get("who") or "claude"
    handoffs = st.get("handoffs") or []
    if handoffs:
        route = [st.get("started_who") or handoffs[0].get("from") or who]
        for h in handoffs:
            to = h.get("to")
            if to and to != route[-1]:
                route.append(to)
        who = "->".join(route)
    name = st.get("name") or st.get("task") or st["id"]
    status = st.get("verdict") or st.get("status") or "Unverified"
    tools = st.get("tools")
    tools = tools if isinstance(tools, int) and not isinstance(tools, bool) else 0
    return f"{st['id']}  {one(who, 30):7}  {one(status, 30):8}  {tools:3} tools  {one(name, 120)}"


def _fake_run(who, script, extra):
    """Run the worker against a fake CLI. Returns the finished state."""
    import tempfile
    tmp = Path(tempfile.mkdtemp(prefix="alexus-"))
    os.environ["ALEXUS_HOME"] = str(tmp)
    os.environ["ALEXUS_" + who.upper()] = script
    rid = "check-" + who
    d = tmp / "agents" / rid
    d.mkdir(parents=True)
    task = "check " + who
    (d / "task.txt").write_text(task)
    save(d, {"id": rid, "name": task, "task": task, "cwd": str(tmp), "who": who, "model": extra.get("model"),
             "status": "starting", "started": now(), "ended": None, "now": "", "plan": [], "actions": [],
             "tools": 0, "errors": 0, "hook_blocks": 0, "remark": "", "final": "", "cost_usd": None,
             "turns": None, "session": None, "pid": None})
    run(rid)
    return load(d)


def selfcheck():
    """Fake claude and grok only. No model call."""
    os.environ.pop("ALEXUS_HOME", None)
    os.environ["ALEXUS_CRITICS"] = "claude"   # fake CLIs only: no check may reach a real AI
    import tempfile
    ok = True

    def check(name, cond):
        nonlocal ok
        print(("ok  " if cond else "FAIL ") + name)
        if not cond:
            ok = False

    def rp(tmp, rid):
        return Path(tmp) / "agents" / rid

    try:
        check("state-home-default", agents_dir() == Path.home() / ".alexus" / "runner" / "agents")
        home_tmp = Path(tempfile.mkdtemp(prefix="alexus-home-"))
        os.environ["ALEXUS_HOME"] = str(home_tmp)
        check("state-home-override", agents_dir() == home_tmp / "agents")
    finally:
        os.environ.pop("ALEXUS_HOME", None)

    def escaped_ids_rejected():
        """show, stop, resume, handoff, run and wall-hook must not open a run by absolute path or .."""
        home = Path(tempfile.mkdtemp(prefix="alexus-id-"))
        marker = "outside-store"
        planted = home / marker / "agents" / "planted-run"
        planted.mkdir(parents=True)
        state = planted / "state.json"
        state.write_text('{"id":"planted-run","status":"running","task":"do not touch","who":"claude"}\n')
        before = state.read_bytes()
        arh = Path(tempfile.mkdtemp(prefix="alexus-idhome-"))
        env = os.environ.copy()
        env["HOME"] = str(home)
        env["ALEXUS_HOME"] = str(arh)
        env["ALEXUS_CLAUDE"] = "/usr/bin/false"
        script = os.path.abspath(__file__)
        bad_ids = [str(planted), ".." + "/" + marker + "/agents/planted-run", ".."]
        fine = True
        for bad in bad_ids:
            for args in (["show", bad], ["stop", bad], ["resume", bad, "no"],
                         ["handoff", bad, "--no-handoff"], ["run", bad]):
                try:
                    r = subprocess.run([sys.executable, "-I", script, *args], env=env,
                                       capture_output=True, text=True, timeout=10)
                except subprocess.TimeoutExpired:
                    fine = False
                    continue
                if r.returncode == 0 or "do not touch" in (r.stdout or ""):
                    fine = False
        try:
            hook = subprocess.run([sys.executable, "-I", script, "wall-hook", str(planted)], env=env,
                                  input="{}", capture_output=True, text=True, timeout=10)
        except subprocess.TimeoutExpired:
            fine = False
        else:
            if hook.returncode == 0:
                fine = False
        if state.read_bytes() != before or any((arh / "agents").glob("*/state.json")):
            fine = False
        shown = subprocess.run([sys.executable, "-I", script, "show", "planted-run"], env=env,
                               capture_output=True, text=True, timeout=10)
        if "do not touch" in (shown.stdout or "") or state.read_bytes() != before:
            fine = False
        return fine

    check("run-id-stays-inside", escaped_ids_rejected())

    check("local-provider-config", all(resolve_ollama_url(value) == expected for value, expected in [
        ('https://models.test:11434/api/tags/', 'https://models.test:11434'),
        ('file:///tmp/models', None),
        ('http://models.test:bad', None),
        ('https://models.test/v1', 'https://models.test'),
        ('', None),
        ('https://models.test/api', 'https://models.test'),
    ]))
    check("local-app-log-guidance", all("If no log helper is installed" in g
                                         for g in (claude_guide(), grok_guide(), muse_guide(), APP_LOG_GUIDE)))
    try:
        normalize_who("nope")
        check("bad-who", False)
    except SystemExit:
        check("bad-who", True)
    check("default-who", normalize_who("") == "claude" and normalize_who("Grok") == "grok"
          and normalize_who("MUSE") == "muse")
    check("listed-clis", LISTED_CLIS == ("claude", "grok", "codex") and "muse" not in LISTED_CLIS)

    gcmd = launch_cmd({"who": "grok", "task": "t", "cwd": "/tmp/proj", "model": "grok-4.7"})
    gjoin = " ".join(gcmd)
    check("grok-flags", "--always-approve" in gcmd and "--no-plan" in gcmd
          and "streaming-messages-json" in gcmd and "--permission-mode" not in gcmd
          and "scheduler_create" in gjoin and "enter_plan_mode" in gjoin
          and gcmd[gcmd.index("--model") + 1] == "grok-4.7" and gcmd[gcmd.index("--cwd") + 1] == "/tmp/proj")
    ccmd = launch_cmd({"who": "claude", "task": "t", "cwd": "/tmp/proj", "model": None})
    check("claude-flags", ccmd[ccmd.index("--permission-mode") + 1] == "auto"
          and ccmd[ccmd.index("--output-format") + 1] == "stream-json"
          and ccmd[ccmd.index("--tools") + 1] == TOOLS and "--model" not in ccmd)
    codex_cmd = launch_cmd({"who": "codex", "task": "t", "cwd": "/tmp/proj", "model": None})
    check("codex-local-app-log-guidance", "If no log helper is installed" in codex_cmd[-1])
    codex_oss = launch_cmd({"who": "codex", "provider": "ollama", "task": "t", "cwd": "/tmp/proj", "model": "llama3.3"})
    check("codex-provider-oss", "--oss" in codex_oss and "--local-provider" in codex_oss and "ollama" in codex_oss)
    codex_lm = launch_cmd({"who": "codex", "provider": "lmstudio", "task": "t", "cwd": "/tmp/proj", "model": "local-7b"})
    check("codex-provider-lmstudio", "--oss" in codex_lm and "--local-provider" in codex_lm and "lmstudio" in codex_lm and "model_provider=lmstudio" in codex_lm)
    mcmd = launch_cmd({"who": "muse", "task": "t", "cwd": "/tmp/proj", "model": "m1"})
    check("muse-flags", mcmd[1] == "exec" and "--json" in mcmd and "--yolo" in mcmd
          and "--disable-request-user-input" in mcmd and mcmd[mcmd.index("--workspace") + 1] == "/tmp/proj"
          and mcmd[mcmd.index("--model") + 1] == "m1" and mcmd[-1].endswith("Task: t")
          and "--model" not in mcmd[mcmd.index("--model") + 2:])

    bin_dir = Path(tempfile.mkdtemp(prefix="alexus-bin-"))
    grok = bin_dir / "grok"
    grok.write_text("""#!/bin/bash
printf '%s\\n' '{"type":"system","subtype":"init","session_id":"sess-grok-1","model":"grok-4.7"}'
printf '%s\\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"todo_write","input":{"merge":false,"todos":[{"id":"1","content":"look","status":"in_progress"},{"id":"2","content":"report","status":"pending"}]}},{"type":"tool_use","id":"t2","name":"read_file","input":{"target_file":"/tmp/x"}}]}}'
printf '%s\\n' '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t1","content":"ok","is_error":false},{"type":"tool_result","tool_use_id":"t2","content":"no","is_error":true}]}}'
printf '%s\\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t3","name":"todo_write","input":{"merge":true,"todos":[{"id":"1","status":"completed"},{"id":"2","status":"completed"}]}},{"type":"text","text":"DONE: looked\\nLEFT: nothing"}]}}'
printf '%s\\n' '{"type":"result","subtype":"success","is_error":false,"result":"DONE: looked\\nLEFT: nothing","total_cost_usd":0.01,"num_turns":2,"session_id":"sess-grok-1"}'
""")
    claude = bin_dir / "claude"
    claude.write_text("""#!/bin/bash
printf '%s\\n' '{"type":"system","subtype":"init","session_id":"sess-c","model":"opus"}'
printf '%s\\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"a","name":"TaskCreate","input":{"subject":"step one","activeForm":"doing one"}}]}}'
