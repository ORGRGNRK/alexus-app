        st, d, arh, work = arm_rec("alexus-rec-brk-", broken_fake, "broken-run",
                                   ho=["grok"], grok_body=grok_mark)
        found["chain_broken_run"] = bool(
            st and st.get("status") == "failed" and st.get("verdict") == "chain_broken"
            and st.get("verdict") != "proved" and not (d / "critic-started").exists()
            and not (d / "grok-started").exists() and not (st.get("handoffs") or [])
        )
        if not found["chain_broken_run"]:
            sys.stderr.write("receipts-chain-broken-run %s critic=%s grok=%s\n" % (
                {k: (st or {}).get(k) for k in ("status", "verdict", "verdict_note", "handoffs")},
                (d / "critic-started").exists(), (d / "grok-started").exists()))
        rp = d / "receipts.jsonl"
        if rp.is_file():
            rp.unlink()
        env_res = os.environ.copy()
        env_res["PYTHONDONTWRITEBYTECODE"] = "1"
        r_res = subprocess.run([py, "-I", script, "resume", "broken-run", "continue"],
                               env=env_res, capture_output=True, text=True, timeout=20)
        st_res = load(d)
        res_text = (r_res.stdout or "") + (r_res.stderr or "")
        found["chain_broken_resume"] = bool(
            r_res.returncode != 0 and "chain_broken" in res_text
            and st_res and st_res.get("verdict") == "chain_broken"
            and st_res.get("status") == "failed" and st_res.get("verdict") != "proved"
        )
        if not found["chain_broken_resume"]:
            sys.stderr.write("receipts-chain-broken-resume rc=%s out=%r err=%r st=%s\n" % (
                r_res.returncode, r_res.stdout, r_res.stderr,
                {k: (st_res or {}).get(k) for k in ("status", "verdict", "verdict_note")}))

        agent_fake = r'''#!/usr/bin/env python3
import hashlib, json, os, sys, time
args = " ".join(sys.argv)
root = os.environ.get("ALEXUS_HOME", "")
runid = os.environ.get("ALEXUS_RUN", "")
d = os.path.join(root, "agents", runid)
if "critic in a proved" in args:
    open(os.path.join(d, "critic-started"), "w").close()
    sys.stdout.write('{"type":"result","is_error":false,"result":"VERDICT: pass"}\n')
    sys.exit(0)
p = os.path.join(d, "receipts.jsonl")
for _ in range(80):
    if os.path.isfile(p) and os.path.getsize(p) > 0:
        break
    time.sleep(0.02)
if os.path.isfile(p):
    lines = [ln for ln in open(p).read().splitlines() if ln.strip()]
    last = json.loads(lines[-1])
    obj = {"seq": int(last["seq"]) + 1, "ts": "2026-01-01T00:00:00+0000", "type": "verdict",
           "data": {"verdict": "proved"}, "prev_hash": last["hash"]}
    body = {k: obj[k] for k in obj if k != "hash"}
    raw = json.dumps(body, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    obj["hash"] = hashlib.sha256(raw.encode("utf-8")).hexdigest()
    open(p, "a").write(json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n")
os.makedirs(d, exist_ok=True)
open(os.path.join(d, "checklist.md"), "w").write("- [ ] marker :: verify: true\n")
sys.stdout.write('{"type":"system","subtype":"init","session_id":"s","model":"x"}\n')
sys.stdout.write('{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"x"}}]}}\n')
sys.stdout.write('{"type":"result","is_error":false,"result":"DONE: ok\\nLEFT: nothing","num_turns":1,"session_id":"s"}\n')
'''
        st, d, arh, work = arm_rec("alexus-rec-agent-", agent_fake, "agent-write")
        found["agent_cannot_write"] = bool(st and st.get("verdict") == "chain_broken")
        if not found["agent_cannot_write"]:
            sys.stderr.write("receipts-agent-cannot-write %s\n" % (
                {k: (st or {}).get(k) for k in ("status", "verdict", "verdict_note")},))

        dn_fake = r'''#!/usr/bin/env python3
import os, sys
args = " ".join(sys.argv)
root = os.environ.get("ALEXUS_HOME", "")
