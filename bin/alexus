        started = agents.exists() and any(agents.glob("*/state.json"))
        if r.returncode == 0 or started or len(lines) != 1 or "alexus plan new" not in text or "'paint the fence'" not in text:
            sys.stderr.write("start-needs-plan: rc %s %r\n" % (r.returncode, text))
            return False
        return True

