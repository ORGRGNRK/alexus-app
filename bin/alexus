    os.chmod(grok, 0o755)
    os.chmod(claude, 0o755)
    gs = _fake_run("grok", str(grok), {"model": "grok-4.7"})
    check("grok-run", gs and gs["status"] == "done" and gs["session"] == "sess-grok-1"
          and gs["who"] == "grok" and gs["model"] == "grok-4.7"
