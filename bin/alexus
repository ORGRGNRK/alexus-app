from datetime import datetime
from pathlib import Path
from urllib.parse import urlsplit, urlunsplit

# PATH comes from the caller. If the CLI can't be found, the run fails saying so.
MAX_ACTIONS = 300
# Named one by one: "default,X" does NOT mean default plus X. Headless claude has no
# TodoWrite, so the Task tools carry the plan. Left out on purpose: cron/wakeups, workflows, remote triggers and
# cross-project messages, so a run can't leave jobs behind that outlive it. MCP servers come from the CLI's own settings.
TOOLS = ("Bash,Read,Edit,Write,NotebookEdit,WebFetch,WebSearch,Skill,ToolSearch,Task,TaskStop,Monitor,LSP,"
         "ListMcpResourcesTool,ReadMcpResourceTool,ReadMcpResourceDirTool,TaskCreate,TaskUpdate,TaskList,TaskGet")
# Grok names that would leave a job after this process exits. enter/exit plan mode would wait on a person.
GROK_OFF = "scheduler_create,scheduler_delete,scheduler_list,workflow,enter_plan_mode,exit_plan_mode"
APP_LOG_GUIDE = """When debugging a macOS app, use that app's own error log. If no log helper is installed, skip it and continue. Never dump broad system logs, request passwords or tokens, or bypass an access denial."""

def claude_guide():
    o = owner_name()
    return f"""You are running unattended: nobody is watching to answer questions.
Work the task end to end. First make a short plan: one TaskCreate per step (3-8 steps). As you work, TaskUpdate each
step to in_progress when you start it and completed when it's done. The run's plan list shows that plan as where it is.
When debugging a macOS app, use that app's own error log. If no log helper is installed, skip it and continue. Never dump broad system logs, request passwords or tokens, or bypass an access denial.
If you hit a step that needs a person (money, accounts, deleting things, sending anything outside, sudo, a permission
denial), do not wait: do everything else, then say exactly what is left for {o}.
End your final reply with two lines: DONE: <what you finished>  and  LEFT: <what's left, or nothing>."""


def grok_guide():
    o = owner_name()
    return f"""You are running unattended: nobody is watching to answer questions.
Work the task end to end. First make a short plan with the todo list tool: 3 to 8 steps, each pending. As you work,
mark the step you are on in_progress, then completed when it is done. The run's plan list shows that list as where the run is.
Do not enter plan mode and do not wait for a plan to be approved.
When debugging a macOS app, use that app's own error log. If no log helper is installed, skip it and continue. Never dump broad system logs, request passwords or tokens, or bypass an access denial.
If you hit a step that needs a person (money, accounts, deleting things, sending anything outside, sudo, a permission
denial), do not wait: do everything else, then say exactly what is left for {o}.
End your final reply with two lines: DONE: <what you finished>  and  LEFT: <what's left, or nothing>."""


def muse_guide():
    o = owner_name()
    return f"""You are running unattended: nobody is watching to answer questions.
Work the task end to end. First make a short plan: call write_todos once with 3 to 8 steps, each pending. As you work,
call write_todos again with the step you are on in_progress, then completed when it is done (send the full list each
time). The run's plan list shows that list as where the run is.
When debugging a macOS app, use that app's own error log. If no log helper is installed, skip it and continue. Never dump broad system logs, request passwords or tokens, or bypass an access denial.
AI outputs are proposals until {o} approves; leave a note of what you changed; never print or log secrets.
If you hit a step that needs a person (money, accounts, deleting things, sending anything outside, sudo, a permission
denial), do not wait and do not ask: do everything else, then say exactly what is left for {o}.
End your final reply with two lines: DONE: <what you finished>  and  LEFT: <what's left, or nothing>."""


LISTED_CLIS = ("claude", "grok", "codex")
SECRET_KEY_RE = re.compile(r"(^|_)(key|token|password|secret|credential|auth)s?$", re.I)
SECRET_KEY_PART = re.compile(r"(api[_-]?key|access[_-]?token|auth[_-]?token|password|secret)", re.I)


def runner_home():
    raw = (os.environ.get("ALEXUS_HOME") or "").strip()
    if raw:
        return Path(raw).expanduser()
    return Path.home() / ".alexus" / "runner"


def config_path():
    return runner_home() / "config.json"


def _clean_config(data):
    if not isinstance(data, dict):
        return {}
    out = {}
    for k, v in data.items():
        ks = str(k)
        if SECRET_KEY_RE.search(ks) or SECRET_KEY_PART.search(ks):
            continue
        if ks == "hooks" and isinstance(v, dict):
            hooks = {}
            for hk, hv in v.items():
                hks = str(hk)
                if SECRET_KEY_RE.search(hks) or SECRET_KEY_PART.search(hks):
                    continue
                if hv:
                    hooks[hks] = hv
            if hooks:
                out["hooks"] = hooks
        else:
            out[ks] = v
    return out


def load_config():
    p = config_path()
    if not p.is_file():
        return None
    try:
        data = json.loads(p.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict):
        return None
    return _clean_config(data)


def write_config(data):
    home = runner_home()
    home.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(home, 0o700)
    except OSError:
        pass
    clean = _clean_config(data)
    path = config_path()
    tmp = path.with_name("config.json.tmp")
    tmp.write_text(json.dumps(clean, indent=2) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    os.chmod(path, 0o600)
    return path


def require_config():
    cfg = load_config()
    if cfg is None:
        sys.exit("alexus: run `alexus setup` first")
    return cfg


def owner_name():
    cfg = load_config() or {}
    name = str(cfg.get("owner") or "").strip()
    return name or "you"


def hook_cmd(name):
    env_map = {
        "receipt": "ALEXUS_RECEIPT",
        "after_leg": "ALEXUS_AFTER_LEG",
        "before_prove": "ALEXUS_BEFORE_PROVE",
        "auditor": "ALEXUS_AUDITOR",
    }
    raw = (os.environ.get(env_map[name], "") or "").strip()
    if raw.lower() in ("0", "off", "false"):
        return ""
    if raw:
        return raw
    cfg = load_config() or {}
    hooks = cfg.get("hooks") or {}
    return str(hooks.get(name) or "").strip()


def _account_name():
    try:
        pw = pwd.getpwuid(os.getuid())
        gecos = (pw.pw_gecos or "").split(",")[0].strip()
        if gecos:
            return gecos
        return (pw.pw_name or "").strip() or "you"
    except Exception:
        return "you"


def discover_clis():
    found = {}
    for name in LISTED_CLIS:
        override = (os.environ.get("ALEXUS_" + name.upper()) or "").strip()
        if override:
            p = Path(override).expanduser()
            if p.is_file() and os.access(p, os.X_OK):
                found[name] = str(p)
                continue
        path = shutil.which(name)
        if path:
            found[name] = path
    return found


