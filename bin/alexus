sys.stdout.write('{"type":"system","subtype":"init","session_id":"g","model":"x"}\n')
sys.stdout.write('{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Read","input":{"file_path":"x"}}]}}\n')
sys.stdout.write('{"type":"result","is_error":false,"result":"DONE: grok\\nLEFT: nothing","num_turns":1,"session_id":"g"}\n')
