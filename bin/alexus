            if nan_word not in nan_text or nan_res[:3] != (False, 2, "line is not valid JSON"):
                nan_ok = False
                sys.stderr.write("receipts-nan word=%s res=%r\n" % (nan_word, nan_res[:3]))
        found["nan"] = nan_ok

        env_cl = os.environ.copy()
        env_cl["PYTHONDONTWRITEBYTECODE"] = "1"
        env_cl["ALEXUS_HOME"] = str(arh_dup)
        for cl_name in ("checklist.md", "checklist.frozen"):
