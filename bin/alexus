        subprocess.run(["git", "commit", "-m", "start"], cwd=str(fl_work), capture_output=True, timeout=10)
        (fl_work / "prior.txt").write_text("dirty\n")
        (fl_work / "notes.txt").write_text("notes\n")
        fl_d = fl_root / "run"
        fl_d.mkdir(parents=True)
        st_fl = {"cwd": str(fl_work), "_receipt_head": RECEIPT_GENESIS, "_receipt_seq": 0}
        snapshot_worktree(fl_d, st_fl)
        (fl_work / "my file.txt").write_text("space\n")
        (fl_work / "café.txt").write_text("cafe\n")
        (fl_work / "plain.txt").write_text("plain\n")
        (fl_work / "big.bin").write_bytes(b"x" * (11 * 1024 * 1024))
        (fl_work / "keep.txt").unlink()
        write_files_receipt(fl_d, st_fl)
        fl_recs = []
        flp = fl_d / "receipts.jsonl"
        if flp.is_file():
            _, _, _, fl_recs = validate_receipts_file(flp)
        fl_files = []
        for rec in fl_recs:
            if rec.get("type") == "files":
                fl_files = list((rec.get("data") or {}).get("files") or [])
        by_path = {f.get("path"): f for f in fl_files if isinstance(f, dict)}
        space_ok = any(" " in (p or "") for p in by_path)
        cafe_ok = any("caf" in (p or "").lower() for p in by_path)
        plain_ok = "plain.txt" in by_path
        big = by_path.get("big.bin") or {}
        big_ok = "big.bin" in by_path and not big.get("sha256")
        keep = by_path.get("keep.txt") or {}
        keep_ok = "keep.txt" in by_path and keep.get("deleted") is True
        pre_ok = "notes.txt" not in by_path and "prior.txt" not in by_path
        found["files"] = space_ok and cafe_ok and plain_ok and big_ok and keep_ok and pre_ok
        if not found["files"]:
            sys.stderr.write("receipts-files paths=%s\n" % (list(by_path),))

        ng_root = Path(tempfile.mkdtemp(prefix="alexus-rec-nongit-"))
        ng_work = ng_root / "work"
