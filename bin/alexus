                write_files_receipt(gt_d, st_gt)
                _, _, _, gt_recs = validate_receipts_file(gt_d / "receipts.jsonl")
            except Exception as e:
                gt_err = repr(e)
            finally:
                subprocess.run = real_run
            gt_files = [r for r in gt_recs if r.get("type") == "files"]
            if gt_err or len(gt_files) != 1 or gt_files[0]["data"].get("undetermined") is not True:
                gt_ok = False
                sys.stderr.write("receipts-git-slow case=%s err=%s recs=%r\n" % (gt_i, gt_err, gt_recs))
