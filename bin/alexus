        lines = [ln for ln in text.splitlines() if ln.strip()]
        agents = arh / "agents"
        started = agents.exists() and any(agents.glob("*/state.json"))
        if r.returncode == 0 or started or len(lines) != 1 or "alexus plan new" not in text:
            sys.stderr.write("start-domain-needs-plan: rc %s %r\n" % (r.returncode, text))
            return False
        return True

    def case_start_domain_with_checklist():
        env, arh, work = _arm_config("alexus-domain-ck-")
        ck = work / "given.md"
        ck.write_text("- [ ] marker :: verify: true\n")
        dom = work / "domain.json"
        dom.write_text(json.dumps({"outcome": "the thing is done", "proof": ["it is done"], "walls": ["be kind"]}))
        r = subprocess.run([py, "-I", script, "start", "--checklist", str(ck), "--domain", str(dom),
                            "--no-handoff", "--cwd", str(work), "--", "use the list"],
                           env=env, capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            sys.stderr.write("start-domain-with-checklist: %s %s\n" % (r.returncode, r.stderr))
            return False
        rid = (r.stdout or "").strip().splitlines()[-1]
        d = arh / "agents" / rid
        try:
            st = json.loads((d / "state.json").read_text())
        except Exception:
            st = {}
        reap(rid, d)
        walls = (st.get("domain") or {}).get("walls") or []
        if not st.get("given_checklist") or not walls or walls[0].get("enforced") is not False:
            sys.stderr.write("start-domain-with-checklist state: %s\n" % (st,))
            return False
        return True


    def guard(name, fn):
        try:
            check(name, bool(fn()))
        except Exception:
            import traceback
            traceback.print_exc()
            check(name, False)

    guard("stop-nonzero-stays-stopped", case_stop_nonzero)
    guard("force-stop-nonzero-stays-stopped", case_force)
    guard("stop-during-handoff-decision", case_during)
    guard("stop-skips-prove", case_prove)
    guard("resume-after-stop", case_resume)
    guard("handoff-after-stop", case_handoff)
    guard("start-help-no-run", case_help)
    guard("start-dash-task-refused", case_dash_refused)
    guard("start-dash-task-after-ddash", case_dash_ok)
    guard("stop-force-kills-term-ignorer", case_force_ignorer)
    guard("start-stdin-dash-refused", case_stdin_dash)
    guard("start-spaced-dash-refused", case_spaced_dash)
    guard("setup-writes-config", case_setup)
    guard("setup-no-cli", case_setup_no_cli)
    guard("setup-run-uses-config", case_setup_run)
    guard("start-no-config", case_start_no_config)
    guard("run-stays-in-home", case_run_stays_in_home)
    guard("start-needs-plan", case_start_needs_plan)
    guard("start-no-plan-runs", case_start_no_plan_runs)
    guard("start-checklist-runs", case_start_checklist_runs)
    guard("start-domain-needs-plan", case_start_domain_needs_plan)
    guard("start-domain-with-checklist", case_start_domain_with_checklist)

    def receipts_cases():
        """Hash-chain receipts: validator, verify --head, live stop, table, HTML, redaction."""
        found = {}

        def rec_obj(seq, typ, data, prev):
            o = {"seq": seq, "ts": "2026-01-01T00:00:00+0000", "type": typ, "data": data, "prev_hash": prev}
            o["hash"] = receipt_hash(o)
            return o

        def chain(n=3):
            recs, prev = [], RECEIPT_GENESIS
            for i in range(1, n + 1):
                r = rec_obj(i, "run_started" if i == 1 else "verdict", {"n": i}, prev)
                recs.append(r)
                prev = r["hash"]
            return recs

        def dump(path, recs):
            path = Path(path)
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text("".join(canonical_json(r) + "\n" for r in recs), encoding="utf-8")

        def vfile(path):
            return validate_receipts_file(path)

        tmp = Path(tempfile.mkdtemp(prefix="alexus-rec-mal-"))
        p = tmp / "receipts.jsonl"
        recs = chain(3)
        p.write_text(canonical_json(recs[0]) + "\n{not json\n", encoding="utf-8")
        ok, ln, reason, _ = vfile(p)
        bad_json = (not ok) and ln == 2 and reason == "line is not valid JSON"
        missing_obj = dict(recs[0])
        missing_obj.pop("type")
        dump(p, [missing_obj])
        ok, ln, reason, _ = vfile(p)
        missing = (not ok) and ln == 1 and reason == "missing field type"
        upper_obj = dict(recs[0])
        upper_obj["hash"] = upper_obj["hash"].upper()
        dump(p, [upper_obj])
        ok, ln, reason, _ = vfile(p)
        upper = (not ok) and ln == 1 and reason == "hash is not exactly 64 lowercase hex characters"
        short_obj = dict(recs[0])
        short_obj["hash"] = short_obj["hash"][:16]
        dump(p, [short_obj])
        ok, ln, reason, _ = vfile(p)
        short = (not ok) and ln == 1 and reason == "hash is not exactly 64 lowercase hex characters"
        recs = chain(3)
        recs[1] = rec_obj(3, "verdict", {"n": 2}, recs[0]["hash"])
        dump(p, recs[:2])
        ok, ln, reason, _ = vfile(p)
        gap = (not ok) and ln == 2 and reason == "seq is not the previous seq plus one"
        recs = chain(3)
        recs[1] = rec_obj(2, "verdict", {"n": 2}, RECEIPT_GENESIS)
        dump(p, recs[:2])
        ok, ln, reason, _ = vfile(p)
        wrong_prev = (not ok) and ln == 2 and reason == "prev_hash does not equal the previous line's hash"
        recs = chain(3)
        recs[1]["data"] = {"n": 99}
        dump(p, recs)
        ok, ln, reason, _ = vfile(p)
        changed = (not ok) and ln == 2 and reason == "recomputed hash differs"
        recs = chain(3)
        dump(p, [recs[0], recs[2]])
        ok, ln, reason, _ = vfile(p)
        deleted = (not ok) and ln == 2 and reason == "seq is not the previous seq plus one"
        recs = chain(3)
        p.write_bytes(canonical_json(recs[0]).encode("utf-8") + b"\n\xff\n")
        try:
            ok, ln, reason, _ = vfile(p)
            utf8_bad = (not ok) and ln == 2 and reason == "line is not valid JSON"
        except Exception:
            utf8_bad = False
            sys.stderr.write("receipts-malformed utf8 raised\n")
        deep = "[" * 200000 + "]" * 200000
        p.write_bytes(canonical_json(recs[0]).encode("utf-8") + b"\n" + deep.encode("ascii") + b"\n")
        try:
            ok, ln, reason, _ = vfile(p)
            recursion_bad = (not ok) and ln == 2 and reason == "line is not valid JSON"
        except Exception:
            recursion_bad = False
            sys.stderr.write("receipts-malformed recursion raised\n")
        recs = chain(3)
        spaced = canonical_json(recs[1]).replace(":", ": ", 1)
        p.write_text(canonical_json(recs[0]) + "\n" + spaced + "\n", encoding="utf-8")
        ok, ln, reason, _ = vfile(p)
        canon_bad = (not ok) and ln == 2 and reason == "line is not in canonical form"
        found["malformed"] = all([bad_json, missing, upper, short, gap, wrong_prev, changed, deleted,
                                  utf8_bad, recursion_bad, canon_bad])
        if not found["malformed"]:
            sys.stderr.write("receipts-malformed bits %s\n" % {
                "bad_json": bad_json, "missing": missing, "upper": upper, "short": short,
                "gap": gap, "wrong_prev": wrong_prev, "changed": changed, "deleted": deleted,
                "utf8_bad": utf8_bad, "recursion_bad": recursion_bad, "canon_bad": canon_bad,
            })

        arh = Path(tempfile.mkdtemp(prefix="alexus-rec-head-"))
        home = arh / "home"
        home.mkdir()
        rid = "head-run"
        d = arh / "agents" / rid
        recs = chain(4)
        dump(d / "receipts.jsonl", recs)
        (d / "state.json").write_text(json.dumps({
            "id": rid, "receipts_head": recs[-1]["hash"], "receipts_seq": 4,
        }))
        env = os.environ.copy()
        env["ALEXUS_HOME"] = str(arh)
        env["HOME"] = str(home)
        env["PYTHONDONTWRITEBYTECODE"] = "1"
        r_ok = subprocess.run([py, "-I", script, "verify", rid, "--head", recs[-1]["hash"]],
                              env=env, capture_output=True, text=True, timeout=15)
        r_wrong = subprocess.run([py, "-I", script, "verify", rid, "--head", "0" * 64],
                                 env=env, capture_output=True, text=True, timeout=15)
        dump(d / "receipts.jsonl", recs[:-2])
        r_short = subprocess.run([py, "-I", script, "verify", rid, "--head", recs[-1]["hash"]],
                                 env=env, capture_output=True, text=True, timeout=15)
        r_none = subprocess.run([py, "-I", script, "verify", "missing-run"],
                                env=env, capture_output=True, text=True, timeout=15)
        wrong_out = r_wrong.stdout or ""
        short_out = r_short.stdout or ""
        found["head"] = (r_ok.returncode == 0 and "intact" in (r_ok.stdout or "")
                         and r_wrong.returncode == 1 and "head was not found" in wrong_out
                         and "shortened" not in wrong_out
                         and r_short.returncode == 1 and "shortened" in short_out
                         and r_none.returncode == 1 and "no receipts file" in (r_none.stdout or ""))
        if not found["head"]:
            sys.stderr.write("receipts-head ok=%s wrong=%s short=%s none=%s\n" % (
                (r_ok.returncode, r_ok.stdout, r_ok.stderr),
                (r_wrong.returncode, r_wrong.stdout),
                (r_short.returncode, r_short.stdout),
                (r_none.returncode, r_none.stdout),
            ))

        def arm_rec(prefix, fake_body, rid, mode="proved", ho=None, task="task", grok_body=None):
            root = Path(tempfile.mkdtemp(prefix=prefix))
            home, arh, bindir, work = root / "home", root / "arh", root / "bin", root / "work"
            home.mkdir(); bindir.mkdir(); work.mkdir()
            fake = bindir / "claude"
            fake.write_text(fake_body)
            os.chmod(fake, 0o755)
            grok = bindir / "grok"
            grok.write_text(grok_body or "#!/bin/sh\nexit 1\n")
            os.chmod(grok, 0o755)
            os.environ["ALEXUS_HOME"] = str(arh)
            os.environ["HOME"] = str(home)
            os.environ["ALEXUS_CLAUDE"] = str(fake)
            os.environ["ALEXUS_GROK"] = str(grok)
            os.environ["ALEXUS_CRITICS"] = "claude"
            write_config({"owner": "Ada", "clis": ["claude", "grok", "codex"],
                          "default_who": "claude", "handoff": list(ho or [])})
            subprocess.run(["git", "init"], cwd=str(work), capture_output=True, timeout=10)
            subprocess.run(["git", "config", "user.email", "demo@example.com"], cwd=str(work),
                           capture_output=True, timeout=10)
            subprocess.run(["git", "config", "user.name", "Demo"], cwd=str(work),
                           capture_output=True, timeout=10)
            (work / "keep.txt").write_text("keep\n")
            subprocess.run(["git", "add", "keep.txt"], cwd=str(work), capture_output=True, timeout=10)
            subprocess.run(["git", "commit", "-m", "start"], cwd=str(work), capture_output=True, timeout=10)
            d = arh / "agents" / rid
            d.mkdir(parents=True)
            save(d, {"id": rid, "name": rid, "task": task, "cwd": str(work), "who": "claude",
                     "started_who": "claude", "handoff_chain": list(ho or []), "handoffs": [],
                     "mode": mode, "gen": 0, "status": "starting", "started": now(), "ended": None,
                     "now": "", "plan": [], "actions": [], "tools": 0, "errors": 0, "hook_blocks": 0,
                     "remark": "", "final": "", "cost_usd": None, "turns": None, "session": None, "pid": None})
            run(rid)
            return load(d), d, arh, work

        types_fake = r'''#!/usr/bin/env python3
import os, sys
args = " ".join(sys.argv)
root = os.environ.get("ALEXUS_HOME", "")
runid = os.environ.get("ALEXUS_RUN", "")
d = os.path.join(root, "agents", runid) if root and runid else ""
if "critic in a proved" in args or "VERDICT:" in args:
    sys.stdout.write('{"type":"result","is_error":false,"result":"VERDICT: pass"}\n')
    sys.exit(0)
if d:
    os.makedirs(d, exist_ok=True)
    if not os.path.exists(os.path.join(d, "checklist.frozen")):
        open(os.path.join(d, "checklist.md"), "w").write("- [ ] marker :: verify: true\n")
open(os.path.join(os.getcwd(), "out.txt"), "w").write("ok\n")
sys.stdout.write('{"type":"system","subtype":"init","session_id":"s","model":"x"}\n')
sys.stdout.write('{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Write","input":{"file_path":"out.txt","content":"ok\\\\ud83d"}}]}}\n')
sys.stdout.write('{"type":"result","is_error":false,"result":"DONE: wrote marker\\nLEFT: nothing","num_turns":1,"session_id":"s"}\n')
'''
        st, d, arh, work = arm_rec("alexus-rec-types-", types_fake, "types-run")
        rp = d / "receipts.jsonl"
        types_ok = False
        if rp.is_file():
            ok, ln, reason, recs = validate_receipts_file(rp)
            have = {r.get("type") for r in recs}
            need = {"run_started", "checklist_frozen", "tool_call", "check_result", "critic", "files", "verdict"}
            types_ok = ok and need <= have and (st or {}).get("verdict") == "proved"
            if not types_ok:
                sys.stderr.write("receipts-types ok=%s line=%s reason=%s have=%s verdict=%s\n" % (
                    ok, ln, reason, have, (st or {}).get("verdict")))
        found["types"] = types_ok

        broken_fake = r'''#!/usr/bin/env python3
import os, sys, time
args = " ".join(sys.argv)
root = os.environ.get("ALEXUS_HOME", "")
runid = os.environ.get("ALEXUS_RUN", "")
