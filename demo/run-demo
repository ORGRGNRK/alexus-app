#!/usr/bin/env python3
"""A stranger can watch receipts: a fake AI claims done too soon, is sent back, then the run is proved.
Default mode makes no model calls. --pause waits between steps. --real --who NAME uses a real CLI."""
import os
import sys
import json
import shutil
import subprocess
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
AR = str(ROOT / "bin" / "alexus")
PAUSE = "--pause" in sys.argv
REAL = "--real" in sys.argv


def die(msg):
    sys.stderr.write(msg + "\n")
    sys.exit(1)


def pause(msg):
    print(msg)
    if not PAUSE:
        return
    try:
        input("Press Enter to continue...")
    except EOFError:
        pass


def load_caller_config():
    """Settings from the caller's HOME / ALEXUS_HOME, before the demo makes its own folder."""
    arh = os.environ.get("ALEXUS_HOME")
    if arh:
        p = Path(arh) / "config.json"
    else:
        p = Path(os.environ.get("HOME") or str(Path.home())) / ".alexus" / "config.json"
    try:
        data = json.loads(p.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def installed_clis():
    found = []
    for name in ("claude", "grok", "codex"):
        if shutil.which(name):
            found.append(name)
    return found


def who_arg():
    if "--who" in sys.argv:
        i = sys.argv.index("--who")
        if i + 1 >= len(sys.argv):
            die("demo/run-demo: --who needs a name")
        return sys.argv[i + 1]
    if not REAL:
        return "claude"
    cfg = load_caller_config()
    found = installed_clis()
    default = str(cfg.get("default_who") or "").strip().lower()
    if default in found:
        return default
    if found:
        return found[0]
    die("demo/run-demo: no supported AI CLI found on PATH (looked for claude, grok, and codex)")


def run_ar(args, env, cwd=None, timeout=120):
    return subprocess.run([sys.executable, "-I", AR, *args], env=env, cwd=cwd,
                          capture_output=True, text=True, timeout=timeout)


def wait_ended(arh, rid, timeout=90):
    d = Path(arh) / "agents" / rid
    end = time.time() + timeout
    last = None
    while time.time() < end:
        p = d / "state.json"
        if p.is_file():
            try:
                last = json.loads(p.read_text())
            except ValueError:
                last = None
            if last and last.get("ended"):
                return last
        time.sleep(0.05)
    return None


def git_init(work):
    subprocess.run(["git", "init"], cwd=str(work), check=True, capture_output=True)
    subprocess.run(["git", "config", "user.email", "demo@example.com"], cwd=str(work),
                   capture_output=True)
    subprocess.run(["git", "config", "user.name", "Demo"], cwd=str(work), capture_output=True)
    (work / "add.py").write_text("def add(a, b):\n    return a - b\n")
    subprocess.run(["git", "add", "add.py"], cwd=str(work), check=True, capture_output=True)
    subprocess.run(["git", "commit", "-m", "start"], cwd=str(work), check=True, capture_output=True)


def write_fake(bindir, name, body):
    p = bindir / name
    p.write_text(body)
    os.chmod(p, 0o755)
    return p


