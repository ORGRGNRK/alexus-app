def main():
    who = who_arg()
    base = Path(tempfile.mkdtemp(prefix="alexus-demo-"))
    home = base / "home"
    arh = base / "arh"
    home.mkdir(parents=True, exist_ok=True)
    arh.mkdir(parents=True, exist_ok=True)
    work = base / "project"
    work.mkdir()
    git_init(work)

    env = os.environ.copy()
    env["ALEXUS_HOME"] = str(arh)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    for k in list(env):
        if k.startswith("ALEXUS_") and k != "ALEXUS_HOME":
            env.pop(k, None)
    if not REAL:
        env["HOME"] = str(home)
        env["ALEXUS_CRITICS"] = "claude"
    elif not env.get("HOME"):
        env["HOME"] = os.environ.get("HOME") or str(home)

    bindir = base / "bin"
    bindir.mkdir()
    if not REAL:
        write_fake(bindir, "claude", FIX_FAKE)
        write_fake(bindir, "grok", GROK_MARK)
        write_fake(bindir, "codex", "#!/bin/sh\nexit 1\n")
        env["PATH"] = str(bindir) + os.pathsep + "/usr/bin" + os.pathsep + "/bin"
        env["ALEXUS_CLAUDE"] = str(bindir / "claude")
        env["ALEXUS_GROK"] = str(bindir / "grok")
        env["ALEXUS_CODEX"] = str(bindir / "codex")
        setup_who = "claude"
    else:
        setup_who = who
        env["PATH"] = os.environ.get("PATH", "/usr/bin:/bin")

    pause("This demo starts in a new folder. add.py has a real bug: it subtracts instead of adding.")
    r = run_ar(["setup", "--owner", "Ada", "--who", setup_who, "--handoff", "none", "--yes"], env)
    if r.returncode != 0:
        die("setup failed: " + (r.stderr or r.stdout or ""))

    pause("A worker will claim the job is done before it has fixed the file. The checklist should fail."
          if not REAL else
          "A real %s worker gets the job. The runner checks every checklist line itself before calling it done." % setup_who)
    start_args = ["start", "--no-plan", "--no-handoff", "--who", setup_who, "--cwd", str(work), "--",
                  "Fix add.py so add(2, 3) is 5"]
    r = run_ar(start_args, env, cwd=str(work), timeout=180 if REAL else 60)
    if r.returncode != 0:
        die("start failed: " + (r.stderr or r.stdout or ""))
    rid = (r.stdout or "").strip().splitlines()[-1]
    wait = 180 if REAL else 60
    raw_wait = os.environ.get("ALEXUS_DEMO_WAIT")
    if raw_wait:
        try:
            wait = float(raw_wait)
        except ValueError:
            pass
    st = wait_ended(arh, rid, timeout=wait)
    if not st or not st.get("ended"):
        die("the first run did not finish")
    print("The runner sent the worker back when a check failed, then the worker fixed add.py."
          if not REAL else "The real worker finished.")
    print("Run %s ended as %s (%s)" % (rid, st.get("verdict") or st.get("status"), st.get("status")))
    note = st.get("verdict_note") or ""
    if "could not start" in note:
        die("run failed to start a CLI: " + note)

    pause("Receipts for this run: each checklist line, DONE or NOT DONE, with the receipt behind it.")
    rec = run_ar(["receipts", rid], env)
    sys.stdout.write(rec.stdout or "")
    if rec.returncode != 0:
        sys.stdout.write(rec.stderr or "")

    pause("verify should report the chain intact.")
    v = run_ar(["verify", rid], env)
    sys.stdout.write(v.stdout or "")
    if v.returncode != 0:
        die("verify should have been intact")

    rp = Path(arh) / "agents" / rid / "receipts.jsonl"
    if st.get("status") in ("starting", "running") or not st.get("ended"):
        die("refusing to change receipts of a live run")
    text = rp.read_text(encoding="utf-8")
    i = text.find('"hash":"')
    if i < 0:
        die("no hash in receipts")
    j = i + 8
    ch = text[j]
    flipped = text[:j] + ("0" if ch != "0" else "1") + text[j + 1:]
    rp.write_text(flipped, encoding="utf-8")
    pause("One character in one receipt was changed. verify should name the line.")
    v2 = run_ar(["verify", rid], env)
    sys.stdout.write(v2.stdout or "")
    if v2.returncode == 0:
        die("verify should have failed after the change")

    html_path = base / "receipts.html"
    # restore the chain so the HTML page can be written from a valid file
    rp.write_text(text, encoding="utf-8")
    h = run_ar(["receipts", rid, "--html", str(html_path)], env)
    if h.returncode != 0 or not html_path.is_file():
        die("HTML page was not written")
    print("HTML page: " + str(html_path))

    if REAL:
        print("Real mode stops after the first story.")
        return 0

    pause("Second run: the chain is corrupted while the worker is still going.")
    write_fake(bindir, "claude", BROKEN_FAKE)
    env["ALEXUS_CLAUDE"] = str(bindir / "claude")
    work2 = base / "project2"
    work2.mkdir()
    git_init(work2)
    r = run_ar(["setup", "--owner", "Ada", "--who", "claude", "--handoff", "grok", "--yes"], env)
    if r.returncode != 0:
        die("second setup failed: " + (r.stderr or r.stdout or ""))
    r = run_ar(["start", "--no-plan", "--who", "claude", "--handoff", "grok", "--cwd", str(work2), "--",
                "Fix add.py so add(2, 3) is 5"], env, cwd=str(work2), timeout=60)
    if r.returncode != 0:
        die("second start failed: " + (r.stderr or r.stdout or ""))
    rid2 = (r.stdout or "").strip().splitlines()[-1]
    st2 = wait_ended(arh, rid2, timeout=60)
    if not st2:
        die("the second run did not finish")
    d2 = Path(arh) / "agents" / rid2
    print("Second run %s status=%s verdict=%s" % (rid2, st2.get("status"), st2.get("verdict")))
    if st2.get("verdict") == "chain_broken":
        print("The run stopped as chain_broken and was never proved.")
    else:
        die("expected chain_broken, got %s" % (st2.get("verdict"),))
    if (d2 / "critic-started").exists() or (d2 / "grok-started").exists() or st2.get("verdict") == "proved":
        die("critic or handoff started, or the run was proved")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
